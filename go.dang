"""
Test, build and run go generate on Go modules across a workspace.

For lint checks, use github.com/dagger/go/golangci-lint or
github.com/dagger/go/staticcheck.
"""
type Go {
  """
  Go version for every module. Null uses each module's go.mod.
  """
  version: String

  """
  Custom base image for Go containers, if set.
  """
  base: Container

  # The container module downloads run with, if set: its environment, such
  # as GOPROXY and GOPRIVATE, its credentials and its mounts. No compile
  # reads it.
  let downloads: Container

  new(
    """
    Go version for every module, overriding go.mod. Ignored when base is set.
    """
    version: String = null,
    """
    Base image for Go containers. Must include a Go toolchain.
    """
    base: Container = null,
    """
    Container module downloads run with: its environment, such as GOPROXY
    and GOPRIVATE, its credentials and its mounts, such as git configuration
    or an SSH agent. Compiles never read it, so their results are shared
    with builds that download differently. Null downloads with the Go
    containers' own settings.
    """
    downloads: Container = null,
    """
    Extra workspace files to mount for Go commands, as include patterns.
    """
    includeExtraFiles: [String!]! = [],
    """
    Module roots to test, e.g. ["**", "!docs"]. "!" excludes.
    """
    test: [String!]! = ["**"],
    """
    Directories to run go generate in, as workspace-root globs. "!" excludes.
    """
    generate: [String!]! = ["**"],
    """
    Main packages to build, by module-relative or workspace path. "!" excludes.
    """
    build: [String!]! = ["**"],
    """
    Extra flags for go build only, e.g. ["-trimpath", "-ldflags=-s -w"].
    """
    buildFlags: [String!]! = [],
    """
    Import paths that many builds import, such as what generated code
    imports. The packages they reach outside a module are compiled in
    dependency calls of their own, the standard library's and then the
    rest's, each the same call in every build that keeps those packages'
    module versions, so a cache that has one, such as an engine image's,
    serves it whole.
    """
    sharedImports: [String!]! = [],
    """
    GOFLAGS for every Go container, e.g. "-tags=extended".
    """
    goflags: String = null,
    """
    Where to mount the workspace in Go containers. Defaults to "/src".
    """
    mountPath: String = null,
  ) {
    if ((mountPath ?? "/").hasPrefix("/") == false) {
      raise "mountPath must be an absolute container path: " + (mountPath ?? "")
    } else {
      self.warnings = if (version != null and base != null) {
        [
          "version \"" + version
            + "\" is ignored because base was set: the base image supplies its own Go toolchain",
        ]
      } else {
        []
      }
      self.version = if (base == null) { version } else { null }
      self.base = base
      self.downloads = downloads
      self.includeExtraFiles = includeExtraFiles
      self.test = test
      self.generate = generate
      self.build = build
      self.buildFlags = buildFlags
      self.sharedImports = sharedImports
      self.goflags = goflags
      self.mountPath = mountPath
      self
    }
  }

  """
  Settings that were given but are ignored.
  """
  warnings: [String!]! = []

  """
  The image a Go container at version starts from, as every build here
  names it.
  """
  image(version: String!): String! {
    gomod.goImage(version)
  }

  """
  Extra workspace files mounted for Go commands, as include patterns.
  """
  includeExtraFiles: [String!]! = []

  """
  Module roots to test. "!" excludes.
  """
  test: [String!]! = ["**"]

  """
  Directories to run go generate in. "!" excludes.
  """
  generate: [String!]! = ["**"]

  """
  Main packages to build, by module-relative or workspace path. "!" excludes.
  """
  build: [String!]! = ["**"]

  """
  Extra flags for go build only.
  """
  buildFlags: [String!]! = []

  """
  Import paths whose packages builds compile in dependency calls of their
  own.
  """
  sharedImports: [String!]! = []

  """
  GOFLAGS for every Go container.
  """
  goflags: String

  """
  Configured workspace mount path. Null uses "/src".
  """
  mountPath: String

  """
  Container path where the workspace is mounted for Go commands: the
  configured mountPath, or "/src".

  The path is in every package's compile and in what it records, so a
  default made from the workspace's name or address would make the same
  source build again under another name, such as another checkout's
  directory or CI's repository name.
  """
  let workspaceMountPath: String! { mountPath ?? "/src" }

  """
  The shared library every Go tool in this repository discovers modules and
  mounts source through, so `go`, `golangci-lint` and `staticcheck` agree on
  what a module is and what one needs.
  """
  let lib: Gomod! { gomod(includeExtraFiles: includeExtraFiles) }

  # The scan's package discovery, which gomod's scanner writes in its one pass
  # over every Go file (go-includes, discovery.go): a small index of the
  # modules, pointing at one catalogue file per module. Reading it replaces a
  # search, glob or field read per result.
  let discoveryIndex(ws: Workspace!): JSONValue! {
    discoveryScan(ws).file("_discovery_index_.json").asJSON
  }

  # The scan, discovering the tests go test builds as the test containers are
  # configured. With no settings to pass, it is the one scan every module and
  # tool shares. The default containers have no C compiler, so no cgo.
  #
  # A custom base brings its own GOFLAGS, cgo and toolchain. Its environment
  # gives the first two without building it. Only its go knows its toolchain
  # version, and whether cgo is on when CGO_ENABLED isn't "0" or "1" (go reads
  # an empty value as unset, and then decides by whether there is a C
  # compiler), so the base is built and asked only when a test file's
  # constraints name a Go release or cgo.
  let discoveryScan(ws: Workspace!): Directory! {
    if (base == null) {
      lib.scan(ws, test: true, goflags: goflags ?? "", goVersion: version ?? "")
    } else {
      let cgoEnv = base!.envVariable("CGO_ENABLED")
      let fromEnv = lib.scan(
        ws,
        test: true,
        goflags: goflags ?? base!.envVariable("GOFLAGS") ?? "",
        cgo: cgoEnv == "1",
      )
      let toolchain = fromEnv.file("_discovery_index_.json").asJSON
      let release = JSON.decode(`${toolchain.field(path: ["toolchain", "release"]).contents}`) :: Boolean!
      let cgo = JSON.decode(`${toolchain.field(path: ["toolchain", "cgo"]).contents}`) :: Boolean!
      if (release or (cgo and cgoEnv != "0" and cgoEnv != "1")) {
        let env = baseGoEnv
        lib.scan(
          ws,
          test: true,
          goflags: env.GOFLAGS,
          goVersion: env.GOVERSION,
          cgo: env.CGO_ENABLED == "1",
        )
      } else {
        fromEnv
      }
    }
  }

  # Ask a custom base's go, with goflags over the image's GOFLAGS.
  let baseGoEnv: {{GOVERSION: String!, CGO_ENABLED: String!, GOFLAGS: String!}}! {
    let probed = if (goflags == null) { base! } else {
      base!.withEnvVariable("GOFLAGS", goflags!)
    }
    let env = probed.withoutEntrypoint.withExec(["go", "env", "-json", "GOVERSION", "CGO_ENABLED", "GOFLAGS"]).stdout
    JSON.decode(env) :: {{GOVERSION: String!, CGO_ENABLED: String!, GOFLAGS: String!}}!
  }

  let moduleRoots(ws: Workspace!): [String!]! {
    JSON.decode(`${discoveryIndex(ws).field(path: ["roots"]).contents}`) :: [String!]!
  }

  let moduleDiscovery(ws: Workspace!, root: String!): JSONValue! {
    let ordinal = JSON.decode(`${discoveryIndex(ws).field(path: ["modules", root]).contents}`) :: Int!
    discoveryScan(ws).file("_discovery_modules_/" + `${ordinal}` + ".json").asJSON
  }

  # A module's "module" line, then a "package" line per package directory
  # with something to do.
  let moduleDiscoveryLines(ws: Workspace!, root: String!): [String!]! {
    let empty: [String!]! = []
    if (moduleRoots(ws).contains(root)) {
      JSON.decode(`${moduleDiscovery(ws, root).field(path: ["lines"]).contents}`) :: [String!]!
    } else {
      # Named modules remain reachable even when discovery omits them.
      empty
    }
  }

  # A module's package directories, each with its test names in file and
  # source order.
  let modulePackageRecords(ws: Workspace!, root: String!): [{{directory: String!, tests: [String!]!}}!]! {
    let empty: [{{directory: String!, tests: [String!]!}}!]! = []
    if (moduleRoots(ws).contains(root)) {
      JSON.decode(`${moduleDiscovery(ws, root).field(path: ["packages"]).contents}`) :: [{{directory: String!, tests: [String!]!}}!]!
    } else {
      empty
    }
  }

  # Whether a package line's kinds hold one kind: "t", "m" or "g".
  let hasKind(kinds: String!, kind: String!): Boolean! {
    kinds.split("").contains(kind)
  }

  # The workspace path of a module-relative directory.
  let pathIn(root: String!, dir: String!): String! {
    if (dir == ".") { root } else if (root == ".") { dir } else { root + "/" + dir }
  }

  # Workspace paths of the Go modules at or below the working directory, and of
  # the module the working directory is inside.
  let moduleRootsHere(ws: Workspace!): [String!]! {
    let cwd = ws.cwd.trimPrefix("/").trimSuffix("/")
    let roots = moduleRoots(ws)
    if (cwd == "" or cwd == ".") {
      roots
    } else {
      let below = roots.filter { root => root == cwd or root.hasPrefix(cwd + "/") }
      # The nearest module at or above the working directory, as findUp finds
      # its go.mod: the working directory's own when it is a module root.
      let enclosing = roots
        .filter { root => root == "." or root == cwd or cwd.hasPrefix(root + "/") }
        .reduce("") { inner, root =>
          if (inner == "" or rootDepth(root) > rootDepth(inner)) { root } else { inner }
        }
      if (enclosing == "") { below } else { ([enclosing] + below).uniq }
    }
  }

  # How deep a module root is below the workspace root: "." is 0.
  let rootDepth(root: String!): Int! {
    if (root == ".") { 0 } else { root.split("/").length }
  }

  # The root of the Go module holding a workspace path: the innermost one.
  let moduleRootOf(ws: Workspace!, pkgPath: String!): String! {
    let roots = moduleRoots(ws)
      .filter { root => root == "." or pkgPath == root or pkgPath.hasPrefix(root + "/") }
    if (roots.length == 0) {
      raise "no Go module found containing path: " + pkgPath
    } else {
      roots.reduce(".") { inner, root =>
        if (root != "." and (inner == "." or root.split("/").length > inner.split("/").length)) { root } else { inner }
      }
    }
  }

  # Whether a workspace path is selected by patterns, as gomod's Module.selected
  # decides it: a pattern selects its path and everything under it, "**" and
  # "*" select everything, "!" excludes, and no selecting pattern selects all.
  let selectedBy(at: String!, patterns: [String!]!): Boolean! {
    let selecting = patterns.filter { p => p.hasPrefix("!") == false }
    let excluding = patterns.filter { p => p.hasPrefix("!") }.map { p => p.trimPrefix("!") }
    (selecting.length == 0 or selecting.any { p => pathMatches(at, p) })
      and excluding.any { p => pathMatches(at, p) } == false
  }

  let pathMatches(at: String!, pattern: String!): Boolean! {
    let trimmed = pattern.trimPrefix("/").trimSuffix("/")
    if (trimmed == "**" or trimmed == "*") {
      true
    } else {
      let prefix = trimmed.trimSuffix("/**")
      at == prefix or at.hasPrefix(prefix + "/")
    }
  }

  # Whether the build setting selects a main package, by its module-relative
  # directory or its workspace path, as GoModule.buildSelected decides it.
  let buildSelected(root: String!, dir: String!): Boolean! {
    let paths = [dir, pathIn(root, dir)]
    let selecting = build.filter { p => p.hasPrefix("!") == false }
    let excluding = build.filter { p => p.hasPrefix("!") }
    (
      selecting.length == 0 or selecting.any { p =>
        paths.any { at =>
          selectedBy(
            at,
            [p],
          )
        }
      }
    )
      and excluding.any { p => paths.any { at => selectedBy(at, [p]) == false } } == false
  }

  # Workspace paths of the packages with something to do: tests to run in a
  # module the test setting selects, a main package the build setting selects,
  # or go:generate commands the generate setting selects.
  let packageKeys(ws: Workspace!, modulePath: String!): [String!]! {
    let empty: [String!]! = []
    let generateAll = generate.length == 1 and generate.contains("**")
    let included = generate.filter { p => p.hasPrefix("!") == false }
    let excluded = generate.filter { p => p.hasPrefix("!") }.map { p => p.trimPrefix("!") }
    # One gomod call, which every module's listing shares, rather than a glob
    # of the workspace per module.
    let includeDirs = if (generateAll) { empty } else {
      lib.goFileDirectories(ws, included)
    }
    let excludeDirs = if (generateAll) { empty } else {
      lib.goFileDirectories(ws, excluded)
    }
    # Split once per line: each field taken is work for every package line,
    # which counts on every build.
    moduleDiscoveryLines(ws, modulePath)
      .filter { line => line.hasPrefix("package\t") }
      .map { line => line.split("\t") }
      .filter { fields =>
        let root = fields[1]!
        let dir = fields[2]!
        let kinds = fields[3]!
        let key = pathIn(root, dir)
        (hasKind(kinds, "t") and selectedBy(root, test))
          or (hasKind(kinds, "m") and buildSelected(root, dir))
          or (hasKind(kinds, "g") and (generateAll or ((included.length == 0 or includeDirs.contains(key)) and excludeDirs.contains(key) == false)))
      }
      .map { fields => pathIn(fields[1]!, fields[2]!) }
      .uniq
  }

  """
  Go modules at or below the working directory, keyed by root directory.
  Use list to read the selected modules as an array.
  """
  modules(
    ws: Workspace!,
    include: [String!]! = [],
    exclude: [String!]! = [],
    includeSkipTest: Boolean! = true,
    includeSkipGenerate: Boolean! = true,
  ): GoModules! {
    let roots = if (include.length == 0 and exclude.length == 0) {
      moduleRootsHere(ws)
    } else {
      moduleRootsHere(ws).filter { root => lib.pathIncluded(ws, root, include, exclude) }
    }
    let selected = if (includeSkipTest and includeSkipGenerate) {
      roots
    } else {
      roots.filter { root =>
        let mod = goModule(ws, root)
        (includeSkipTest or mod.skipTest == false)
          and (includeSkipGenerate or mod.skipGenerate(ws) == false)
      }
    }
    GoModules(
      paths: sorted(selected),
      mountPath: workspaceMountPath,
      tool: self,
    )
  }

  # The module holding a package. A package holds no module of its own, so
  # that the collection needs no workspace.
  let packageModule(ws: Workspace!, pkgPath: String!, mount: String!): GoModule! {
    goModuleAt(moduleRootOf(ws, pkgPath), mount)
  }

  # Byte-order sort, as Go's sort.Strings: a merge sort, n log n comparisons.
  let sorted(items: [String!]!): [String!]! {
    if (items.length < 2) {
      items
    } else {
      let half = items.length / 2
      mergeSorted(sorted(items.takeFirst(half)), sorted(items.dropFirst(half)))
    }
  }

  # Merges two byte-ordered lists into one.
  let mergeSorted(a: [String!]!, b: [String!]!): [String!]! {
    let i = 0
    let j = 0
    (a + b).map { unused =>
      if (j == b.length or (i < a.length and a[i]! <= b[j]!)) {
        let item = a[i]!
        i += 1
        item
      } else {
        let item = b[j]!
        j += 1
        item
      }
    }
  }

  """
  The Go module containing a workspace path.
  """
  module(ws: Workspace!, path: String!, findUp: Boolean! = true): GoModule! {
    goModule(ws, lib.module(ws, path, findUp: findUp).path)
  }

  """
  Every module version a go.sum names, downloaded as builds download them,
  in one directory laid out as a Go module proxy, for GOPROXY=file://<dir>:
  a version with a zip checksum as its .zip, .mod and .info, one with only a
  go.mod checksum as its .mod and .info. It has no version lists, so it
  answers only for exact versions. Each version is downloaded once, keyed
  by its path, version and checksums, with the downloads container's
  settings, reading no module cache the image comes with, and checked
  against the go.sum. Any download that
  fails, or doesn't match, fails the call.
  """
  moduleProxy(goSum: File!): Directory! {
    gobuild(toolImage: gomod.goImage(gomod.scannerVersion)).moduleProxy(
      goSum: goSum,
      image: if (base == null) { gomod.goImage(version ?? gomod.scannerVersion) } else { "" },
      from: if (base == null) { null } else { base!.withoutEntrypoint },
      downloads: downloads,
    )
  }

  let goModule(ws: Workspace!, modPath: String!): GoModule! {
    goModuleAt(modPath, workspaceMountPath)
  }

  # files is the module's Go files when the caller already has them, as
  # Gomod.modules returns them, and null otherwise.
  let goModuleAt(modPath: String!, mount: String!): GoModule! {
    GoModule(
      tool: self,
      path: modPath,
      configuredVersion: version,
      warnings: warnings,
      baseImage: base,
      includeExtraFiles: includeExtraFiles,
      testPatterns: test,
      generatePatterns: generate,
      buildPatterns: build,
      buildFlags: buildFlags,
      goflags: goflags,
      mountPath: mount,
    )
  }
}

# Keep all Dang types in one source file until Dagger v0.21.x can
# convert Workspace arguments for installed multi-file Dang toolchains.
# See dagger/dagger#13476.

"""
Go modules in a workspace, keyed by root directory.
"""
type GoModules @collection {
  paths: [String!]! @keys
  let mountPath: String!
  let tool: Go!

  module(path: String!): GoModule! @get { tool.goModuleAt(path, mountPath) }
}

"""
Go packages in one module, keyed by workspace-relative directory.
"""
type GoPackages @collection {
  paths: [String!]! @keys
  delta: CollectionDelta @delta

  """
  Whether the active selection removed tests or packages from this collection.
  """
  narrowed: Boolean! { delta == null or delta!.removedKeys.length > 0 }

  let mountPath: String!
  let tool: Go!

  """
  Stored test collections for the packages. Lists are data, not artifact paths.
  The engine filters these collections when passing a selected package set.
  """
  entries: [GoPackageSelection!]!

  package(path: String!): GoPackage! @get {
    GoPackage(
      path: path,
      # Only a collection narrowed to the packages wanted plans their test
      # binaries together: a member of the module's whole collection would
      # plan, and compile the dependencies of, every package with tests.
      set: if (narrowed) { paths } else { [] },
      mountPath: mountPath,
      tool: tool,
      tests: entries.filter { entry => entry.directory == path }[0]!.tests,
      generation: GoGenerateInputs(
        modulePath: generation.modulePath,
        source: generation.source,
        version: generation.version,
        failure: generation.failure,
        directories: generation.directories.filter { dir => dir.path == path },
      ),
    )
  }

  let module: GoModule!
  let generation: GoGenerateInputs!

  """
  Binaries of the selected main packages for the engine's platform, one file
  each.
  """
  binary(ws: Workspace!): Directory! {
    if (paths.length == 0) {
      directory
    } else {
      let mains = module.mainPackages(ws, paths)
      let names = mains.map { p => hostName(ws, p) }
      let clashes = mains.filter { p =>
        let name = hostName(ws, p)
        names.filter { other => other == name }.length > 1
      }
      if (clashes.length > 0) {
        raise "Go packages build binaries with the same name: " + clashes.map { p =>
          p + " builds " + hostName(ws, p)
        }.join(", ")
      }
      module.binaryFiles(ws, gomod.hostPlatform, paths)
    }
  }

  let hostName(ws: Workspace!, pkgPath: String!): String! {
    module.binaryFileName(ws, pkgPath, gomod.hostPlatform)
  }

  """
  Test binaries of the selected packages that have test files, for the
  engine's platform, each in its package's directory, relative to the
  workspace, named as go test -c names it, e.g. "pkg/foo/foo.test".

  They are built as go test -c builds several packages, from one plan of
  them all, so what they share is planned and compiled once. As on go test's
  command line, a build flag without a package pattern, such as -gcflags=-N,
  applies to every selected package, including where one is another's
  dependency. A package whose test files build constraints leave out has no
  test binary. As with a package's testBinary, go vet is not run. A gccgo
  build has no set: build each package's testBinary.
  """
  testBinary(ws: Workspace!): Directory! {
    module.testBinaryFiles(ws, gomod.hostPlatform, paths)
  }

  """
  Run go generate in the selected packages.
  """
  generate(ws: Workspace!): Changeset! {
    # Selected packages run in lexical order, sharing generated output.
    if (paths.length == 0 or module.skipGenerate(ws)) {
      directory.changes(directory)
    } else {
      let dirs = module.generateDirsIn(ws, paths)
      if (dirs.length == 0) {
        directory.changes(directory)
      } else {
        let before = directory.withDirectory(module.path, module.generateSource(ws))
        let after = before.withDirectory(module.path, module.generatedTree(ws, dirs))
        after.changes(before)
      }
    }
  }
}

"""
A Go package.
"""
type GoPackageSelection {
  directory: String!
  tests: GoTests!
}

type GoPackage {
  """
  Package directory, relative to the workspace.
  """
  path: String!

  # The packages of the narrowed collection this one was taken from, whose
  # test binaries are planned with its own; none when it was taken from a
  # module's whole collection.
  let set: [String!]!

  let mountPath: String!

  let tool: Go!
  let generation: GoGenerateInputs!

  let module(ws: Workspace!): GoModule! {
    tool.packageModule(ws, path, mountPath)
  }

  """
  Tests in this package, keyed by name.
  """
  tests: GoTests!

  """
  This package's binary for the engine's platform. It must be a main package.
  """
  binary(ws: Workspace!): File! {
    module(ws).binaryFile(ws, gomod.hostPlatform, path)
  }

  """
  This package's test binary for the engine's platform, as go test -c builds
  it. The package must have test files.

  Taken from a module's whole collection, it is planned alone, as go test -c
  of this package plans it. Taken from a collection narrowed to the packages
  wanted, such as with subset, it is planned with the test binaries of that
  collection's other packages, as the collection's testBinary builds them,
  and shares that plan, its setup and the compiles of their dependencies
  with each of their own testBinary: it compiles only what it links, and is
  ready when its own link is. With -coverpkg, or -gcflags, -asmflags or
  -gccgoflags without a package pattern, whose packages are those on go
  test's command line, or when that shared plan fails, as when another of
  those packages can't load, it is planned alone, so that it stays go test
  -c's of this package alone.

  Unlike go test -c, it does not run go vet on the package: vet is left to
  the lint checks, such as golangci-lint's.
  """
  testBinary(ws: Workspace!): File! {
    module(ws).testBinaryFile(ws, gomod.hostPlatform, path, set)
  }

  """
  Platforms this package can be built for, keyed by GOOS/GOARCH.
  """
  platforms: GoPlatforms! {
    GoPlatforms(names: gomod.goPlatforms, path: path, mountPath: mountPath, tool: tool)
  }

  """
  Run go generate in this package.
  """
  generate: Changeset! @generate {
    tool.goModuleAt(generation.modulePath, mountPath).generateFrom(generation)
  }
}

"""
Platforms a Go package can be built for, keyed by GOOS/GOARCH.
"""
type GoPlatforms @collection {
  """
  GOOS/GOARCH pairs, e.g. "linux/arm64".
  """
  names: [String!]! @keys

  """
  Platforms selected in or out since the collection was discovered.
  """
  delta: CollectionDelta @delta

  let path: String!
  let mountPath: String!
  let tool: Go!

  """
  The platform with this GOOS/GOARCH.
  """
  platform(name: String!): GoPlatform! @get {
    GoPlatform(name: name, path: path, mountPath: mountPath, tool: tool)
  }

  # The platforms a batch builds for. Every platform Go supports is a key, and
  # naming none selects them all, so an unnarrowed collection means no
  # platform was asked for: the batch then builds for the engine's own.
  # Without a delta, the keys are taken as asked for.
  let targets: [String!]! {
    let whole = if (delta == null) {
      false
    } else {
      delta.addedKeys.length == 0 and delta.removedKeys.length == 0
    }
    if (whole) { names.filter { name => name == gomod.hostPlatform } } else { names }
  }

  """
  This package's binary for the selected platforms, or the engine's when none
  is, one directory per platform, e.g. "linux-arm64/".
  """
  binary(ws: Workspace!): Directory! {
    let mod = tool.packageModule(ws, path, mountPath)
    targets.reduce(directory) { out, target =>
      out.withFile(
        target.split("/").join("-") + "/" + mod.binaryFileName(ws, path, target),
        mod.binaryFile(ws, target, path),
      )
    }
  }
}

"""
What a Go module's archives read from the cache that every build of the
packages with the same toolchain, flags and go.sum shares. The results are
references the cache keeps for as long as it keeps this: a caller takes each
one's ID in its own session, as an engine image's entries do.
"""
type GoArchiveBuilds {
  """
  Each package's build, in the order the walk ran them: a directory of what
  its exec wrote, with its archives.
  """
  builds: [Directory!]!

  """
  Each module download, in the order of its module cache directory name: a
  directory of its plan pack and zip.
  """
  downloads: [Directory!]!

  """
  gobuild's gohdr, the tool the builds' execs run, for every machine an
  engine runs on.
  """
  tool: Directory!

  """
  golangci-lint's write-manifest, which writes the archives' manifest, for
  every machine an engine runs on.
  """
  manifestTool: Directory!

  """
  The source write-manifest is built from, golangci-lint's manifest module at
  gobuild's pin, which a fresh engine would otherwise fetch to find its build.
  """
  manifestSource: Directory!

  """
  Go's own tools the builds run, built by its toolchain for every machine an
  engine runs on: pack.
  """
  tools: Directory!

  """
  gomod's go-includes helper, for the engine's platform.
  """
  helper: Container!

  """
  gomod's go-includes binary for the builds' platform, which the helper of
  an engine of that platform runs.
  """
  helperBinary: File!

  """
  The shared dependency calls the archives made (sharedImports), each
  call's result by its ID in this session: a cache that is to have those
  calls whole, not only each package's build, takes these.
  """
  sharedDependencies: [String!]!
}

"""
A platform a Go package can be built for.
"""
type GoPlatform {
  """
  GOOS/GOARCH, e.g. "linux/arm64".
  """
  name: String!

  let path: String!
  let mountPath: String!
  let tool: Go!

  """
  This package's binary for this platform.
  """
  binary(ws: Workspace!): File! {
    tool.packageModule(ws, path, mountPath).binaryFile(ws, name, path)
  }

  """
  This package's test binary for this platform, as go test -c builds it,
  but without go vet, which is left to the lint checks.
  """
  testBinary(ws: Workspace!): File! {
    let alone: [String!]! = []
    tool.packageModule(ws, path, mountPath).testBinaryFile(ws, name, path, alone)
  }
}

"""
A Go module rooted at a workspace-relative path.
"""
type GoModule {
  let tool: Go!

  """
  Packages owned by this module. Nested Go modules have their own collection.
  """
  packages(ws: Workspace!): GoPackages! {
    # In byte order already: discovery lists a module's packages by workspace path.
    let paths = tool.packageKeys(ws, path)
    let empty: [String!]! = []
    let records = if (skipTest) {
      # Build and generate can still offer packages in a module whose tests
      # are skipped; none of their test names need to be fetched.
      paths.map { pkg => {{directory: pkg, tests: empty}} }
    } else {
      # Both lists are in byte order. Select with a linear merge, avoiding a
      # search through every package record for each selected path.
      let next = 0
      let selected = tool.modulePackageRecords(ws, path).filter { pkg =>
        if (next < paths.length and pkg.directory == paths[next]!) {
          next = next + 1
          true
        } else {
          false
        }
      }
      if (next != paths.length) { raise "package catalogue does not contain every selected path" }
      selected
    }
    let inputs = if (records.any { pkg => pkg.tests.length > 0 }) { testInputs(ws) } else { null }
    GoPackages(
      paths: paths,
      mountPath: mountPath,
      tool: tool,
      module: self,
      generation: generationInputs(ws, paths),
      entries: records.map { pkg =>
        let dir = relativeDir(pkg.directory)
        GoPackageSelection(
          directory: pkg.directory,
          tests: GoTests(
            names: pkg.tests.uniq,
            directory: dir,
            module: self,
            inputs: inputs,
          ),
        )
      },
    )
  }

  """
  Module root, relative to the workspace.
  """
  path: String!

  let configuredVersion: String
  let warnings: [String!]!

  """
  Base image used by this module's Go containers, as supplied by the caller.
  """
  let baseImage: Container

  """
  Extra workspace files mounted for Go commands, as include patterns.
  """
  includeExtraFiles: [String!]!

  """
  Gitignore-style globs selecting which module roots to test.
  """
  let testPatterns: [String!]!

  """
  Workspace-root-relative globs selecting directories to run go generate in.
  """
  let generatePatterns: [String!]!

  """
  Globs selecting which main packages to build, by module-relative or
  workspace path.
  """
  let buildPatterns: [String!]!

  """
  Extra flags for go build, after the build subcommand and before the packages.
  """
  let buildFlags: [String!]!

  """
  Value of the GOFLAGS environment variable in this module's Go containers.
  """
  let goflags: String

  """
  Where the workspace is mounted in Go containers.
  """
  mountPath: String!

  """
  The shared library, which answers discovery, selection and source policy for
  this module, so `go` mounts what `golangci-lint` and `staticcheck` mount.

  Its module object is re-derived at each call site rather than held as a
  field: Dang cannot yet name a dependency's non-root type, which is also why
  the GoModule type here is this module's own rather than the library's.
  """
  let lib: Gomod! { gomod(includeExtraFiles: includeExtraFiles) }

  """
  The per-package builder. Its own tool is built in the image of the Go
  version the library's tools build with, which the library pins, so a build
  pulls one Go image, which an engine image can ship.
  """
  let builder: Gobuild! { gobuild(toolImage: gomod.goImage(gomod.scannerVersion)) }

  """
  Whether tests are skipped for this module.
  """
  skipTest: Boolean! {
    rootSelected(normalized(path), testPatterns) == false
  }

  """
  Why this module could not be scanned, or null.
  """
  scanFailure(ws: Workspace!): String {
    lib.at(path).scanError(ws, generate: true)
  }

  """
  Whether go generate has nothing to run in this module.
  """
  skipGenerate(ws: Workspace!): Boolean! {
    if (scanFailure(ws) != null) {
      true
    } else {
      generateDirectories(ws).length == 0
    }
  }

  """
  Whether this module has go:generate commands, regardless of selection.
  """
  hasGenerateDirectives(ws: Workspace!): Boolean! {
    if (scanFailure(ws) != null) {
      false
    } else {
      discoveredGenerateDirectories(ws).length > 0
    }
  }

  """
  Directories go generate runs in, in lexical order.
  """
  generateDirectories(ws: Workspace!): [String!]! {
    selectGenerate(ws, discoveredGenerateDirectories(ws))
  }

  # The workspace directories among dirs that the generate setting selects.
  let selectGenerate(ws: Workspace!, dirs: [String!]!): [String!]! {
    let included = generatePatterns.filter { p => p.hasPrefix("!") == false }
    let excluded = generatePatterns.filter { p => p.hasPrefix("!") }.map { p => p.trimPrefix("!") }
    let includeDirs = matchingGenerateDirectories(ws, included)
    let excludeDirs = matchingGenerateDirectories(ws, excluded)
    dirs.filter { dir =>
      (included.length == 0 or includeDirs.any { match => match == dir })
        and excludeDirs.any { match => match == dir } == false
    }
  }

  # Match direct Go files to include the workspace root and avoid treating a
  # literal directory as recursive. Glob syntax is entirely Dagger's.
  let matchingGenerateDirectories(ws: Workspace!, patterns: [String!]!): [String!]! {
    let empty: [String!]! = []
    patterns.reduce(empty) { dirs, pattern =>
      dirs + ws
        .glob(pattern.trimSuffix("/") + "/*.go")
        .filter { file => file.hasSuffix("/") == false }
        .map { file =>
          let dir = file.split("/").dropLast(1).join("/")
          if (dir == "") { "." } else { dir }
        }
    }
  }

  let discoveredGenerateDirectories(ws: Workspace!): [String!]! {
    lib.at(path).generateDirectories(ws)
  }

  """
  Include patterns found by scanning Go directives and local replaces.
  """
  includeDiscovered(
    ws: Workspace!,
    test: Boolean! = false,
    generate: Boolean! = false,
  ): [String!]! {
    lib.at(path).includeDiscovered(ws, test: test, generate: generate)
  }

  """
  Built-in include patterns for this module's Go files.
  """
  includeBase: [String!]! {
    lib.at(path).includeBase
  }

  """
  All include patterns for this module's source.
  """
  include(
    ws: Workspace!,
    test: Boolean! = false,
    generate: Boolean! = false,
  ): [String!]! {
    lib.at(path).include(ws, test: test, generate: generate)
  }

  """
  Source mounted for this module's Go commands.
  """
  source(
    ws: Workspace!,
    test: Boolean! = false,
    generate: Boolean! = false,
  ): Directory! {
    lib.at(path).source(ws, test: test, generate: generate)
  }

  """
  Testdata directories mounted for this module's tests.
  """
  testData(ws: Workspace!): Directory! {
    lib.at(path).testData(ws)
  }

  """
  Go version this module runs under. Null with a custom base.
  """
  version(ws: Workspace!): String {
    if (baseImage == null) { toolchainVersion(ws) } else { null }
  }

  let toolchainVersion(ws: Workspace!): String! {
    configuredVersion ?? discoveredVersion(ws) ?? gomod.defaultGoVersion
  }

  # The Go version this module's go.mod declares, as the scan reports it.
  let discoveredVersion(ws: Workspace!): String {
    let declared = moduleField(ws, 3)
    if (declared == "") { null } else { declared }
  }

  # This module's discovery lines: see Go.moduleDiscoveryLines.
  let discoveryLines(ws: Workspace!): [String!]! {
    tool.moduleDiscoveryLines(ws, path)
  }

  # Field n of this module's discovery line: 2 for its module path, 3 for its
  # Go version.
  let moduleField(ws: Workspace!, n: Int!): String! {
    discoveryLines(ws)
      .filter { line => line.hasPrefix("module\t" + path + "\t") }
      .map { line => line.split("\t").takeFirst(n + 1).takeLast(1).join("") }
      .takeFirst(1)
      .join("")
  }

  """
  Go container for this module, before source is added.
  """
  base(ws: Workspace!): Container! {
    baseFor(if (baseImage == null) { toolchainVersion(ws) } else { "" })
  }

  let baseFor(version: String!): Container! {
    prepareBase(
      if (baseImage == null) {
        gomod.goContainer(version)
      } else {
        gomod.withGoCaches(baseImage.withoutEntrypoint)
      },
    )
  }

  """
  A cache-mounted Go container made ready for this module's commands: the
  workspace mount path as workdir, GOFLAGS when configured, and any ignored
  settings announced.

  Taken as an argument rather than built here, because a generate directory
  may name its own container and it has to be prepared the same way.
  """
  let prepareBase(cached: Container!): Container! {
    let ctr = gomod.withWarnings(cached, warnings).withWorkdir(mountPath)
    if (goflags == null) { ctr } else { ctr.withEnvVariable("GOFLAGS", goflags) }
  }

  # A workspace path inside this module, made module-relative.
  let relativeDir(pkgPath: String!): String! {
    if (pkgPath == path) {
      "."
    } else if (path == ".") {
      pkgPath
    } else {
      pkgPath.trimPrefix(path + "/")
    }
  }

  # Byte-order sort, as Go's sort.Strings: a merge sort, n log n comparisons.
  let sorted(items: [String!]!): [String!]! {
    if (items.length < 2) {
      items
    } else {
      let half = items.length / 2
      mergeSorted(sorted(items.takeFirst(half)), sorted(items.dropFirst(half)))
    }
  }

  # Merges two byte-ordered lists into one.
  let mergeSorted(a: [String!]!, b: [String!]!): [String!]! {
    let i = 0
    let j = 0
    (a + b).map { unused =>
      if (j == b.length or (i < a.length and a[i]! <= b[j]!)) {
        let item = a[i]!
        i += 1
        item
      } else {
        let item = b[j]!
        j += 1
        item
      }
    }
  }

  # The workspace path of a package directory in this module.
  let packagePath(dir: String!): String! {
    if (dir == ".") { path } else { subpathOf(normalized(path), dir) }
  }

  # Module.subpath, Module.selected and Gomod.normalize, in process. Through gomod
  # each is a module call, with the fixed per-call cost of one, for a few string
  # operations; discovery makes one for every package directory.
  let subpathOf(root: String!, relativePath: String!): String! {
    if (root == ".") { relativePath } else { root.trimSuffix("/") + "/" + relativePath }
  }

  let normalized(p: String!): String! {
    let segments = p.split("/").filter { segment => segment != "" and segment != "." }
    if (segments.length == 0) { "." } else { segments.join("/") }
  }

  let rootSelected(root: String!, patterns: [String!]!): Boolean! {
    let selecting = patterns.filter { pattern => pattern.hasPrefix("!") == false }
    let excluding = patterns
      .filter { pattern => pattern.hasPrefix("!") }
      .map { pattern => pattern.trimPrefix("!") }
    (selecting.length == 0 or selecting.any { pattern => rootMatches(root, pattern) })
      and excluding.any { pattern => rootMatches(root, pattern) } == false
  }

  let rootMatches(root: String!, pattern: String!): Boolean! {
    let trimmed = pattern.trimPrefix("/").trimSuffix("/")
    if (trimmed == "**" or trimmed == "*") {
      true
    } else {
      let prefix = trimmed.trimSuffix("/**")
      root == prefix or root.hasPrefix(prefix + "/")
    }
  }

  """
  Run tests in this module.
  """
  test(ws: Workspace!): Void {
    let failure = testFailure(ws)
    if (failure != null) {
      raise "Go module " + path + ": " + failure
    }
    null
  }

  """
  Error message from running this module's tests, or null when they pass or
  this module is configured to skip tests.
  """
  let testFailure(ws: Workspace!): String {
    if (skipTest) {
      null
    } else {
      { testExec(ws).sync; null } rescue {
        err: Error => err.message
      }
    }
  }

  """
  Run go generate in this module.
  """
  generate(ws: Workspace!): Changeset! {
    let failure = scanFailure(ws)
    if (failure != null) {
      raise failure
    } else if (skipGenerate(ws)) {
      directory.changes(directory)
    } else {
      let before = directory.withDirectory(path, generateSource(ws))
      let after = before.withDirectory(path, generatedTree(ws, generateDirectories(ws)))
      after.changes(before)
    }
  }

  # The generate directories among the given workspace package paths, in
  # lexical order.
  let generateDirsIn(ws: Workspace!, pkgPaths: [String!]!): [String!]! {
    generateDirectories(ws).filter { dir => pkgPaths.contains(dir) }
  }

  # This module's tree as its generate container receives it.
  let generateSource(ws: Workspace!): Directory! {
    source(ws, generate: true).directory(path)
  }

  # This module's tree after go generate has run in dirs, in order.
  let generatedTree(ws: Workspace!, dirs: [String!]!): Directory! {
    generateExec(ws, dirs).directory(".")
  }

  """
  Container state after running go generate in dirs, in order, each seeing the
  output of the ones before it.
  """
  let generateExec(ws: Workspace!, dirs: [String!]!): Container! {
    generateExecFrom(prepareGeneration(ws, dirs))
  }

  let generationInputs(ws: Workspace!, pkgPaths: [String!]!): GoGenerateInputs! {
    let failure = scanFailure(ws)
    if (failure != null) {
      GoGenerateInputs(modulePath: path, version: "", failure: failure, directories: [])
    } else {
      prepareGeneration(ws, generateDirsIn(ws, pkgPaths))
    }
  }

  let prepareGeneration(ws: Workspace!, dirs: [String!]!): GoGenerateInputs! {
    GoGenerateInputs(
      modulePath: path,
      source: if (dirs.length == 0) { null } else { source(ws, generate: true) },
      version: if (dirs.length == 0 or baseImage != null) { "" } else { toolchainVersion(ws) },
      directories: dirs.map { dir =>
        {
          let value = lib.at(path).generateContainer(ws, dir)
          GoGenerateDirectory(
            path: dir,
            value: value,
            container: if (value == "") { null } else { ws.resolve(value).container.withoutEntrypoint },
          )
        } rescue {
          err: Error => GoGenerateDirectory(path: dir, value: "", failure: err.message)
        }
      },
    )
  }

  let generateFrom(inputs: GoGenerateInputs!): Changeset! {
    if (inputs.failure != null) {
      raise inputs.failure!
    } else if (inputs.directories.length == 0) {
      directory.changes(directory)
    } else {
      let before = directory.withDirectory(path, inputs.source!.directory(path))
      let after = before.withDirectory(path, generateExecFrom(inputs).directory("."))
      after.changes(before)
    }
  }

  let generateExecFrom(inputs: GoGenerateInputs!): Container! {
    let initial = baseFor(inputs.version).withDirectory(".", inputs.source!)
    inputs.directories.reduce(GoGeneration(container: initial, value: "")) { state, dir =>
      if (dir.failure != null) { raise dir.failure! }
      let ctr = if (dir.value == state.value) {
        state.container
      } else {
        let selected = if (dir.value == "") {
          baseFor(inputs.version)
        } else {
          prepareBase(gomod.withGoCaches(dir.container!))
        }
        selected.withDirectory(mountPath, state.container.directory(mountPath))
      }
      GoGeneration(
        value: dir.value,
        container: ctr
          .withWorkdir(mountPath + "/" + dir.path)
          .withExec(["go", "generate", "."], experimentalPrivilegedNesting: true),
      )
    }.container.withWorkdir(mountPath + "/" + path)
  }

  """
  The otelgotest binary the tests are run with, when the container does not
  already carry one: otel-go's own, at the commit testRunnerCommit names,
  built by this module's per-package build from otel-go's source.

  Built with the Go version the library's tools build with rather than the
  module's own, so a module pinned to an older toolchain still gets it, and
  so the build happens once for the whole workspace instead of once per
  module.
  """
  let testRunner: File! {
    let source = git("https://github.com/dagger/otel-go").commit(testRunnerCommit).tree.asWorkspace
    toolBuild(source, ".", "cmd/otelgotest")
  }

  # The otel-go commit otelgotest is built from: one with its prebuilt mode,
  # which runs a test binary as go test -json runs one.
  let testRunnerCommit: String! = "aa07da582c215c85056429e152a261717003244d"

  """
  The helper that turns each package's go test -json report into one result
  per selected test, built by this module's per-package build from the
  library's source.
  """
  let testReportIndexer: File! {
    let source = currentModule.source.directory("gomod/helpers/go-test-report").asWorkspace
    toolBuild(source, ".", ".")
  }

  # One main package of a tool's own source, a workspace holding its Go
  # module at root, for the engine's platform. Its settings are this
  # module's defaults and its Go is the library's, whatever the module under
  # test sets: the tool is the same for every module.
  let toolBuild(source: Workspace!, root: String!, pkg: String!): File! {
    Go(version: gomod.scannerVersion)
      .goModuleAt(root, "/src")
      .binaryFile(source, gomod.hostPlatform, pkg)
  }

  # Form source views during input preparation, without setting up tools.
  let testInputs(ws: Workspace!): GoTestInputs! {
    GoTestInputs(
      source: lib.at(path).sourceFromScan(ws, tool.discoveryScan(ws)),
      testData: testData(ws),
      configs: gomod.daggerConfigs(ws),
      version: if (baseImage == null) { toolchainVersion(ws) } else { "" },
      importPath: importPath(ws),
      headers: lib.scan(ws).sync.file("_headers_.gohdr"),
    )
  }

  # The inputs of a test run made with the workspace at hand: the source go
  # test is given for this module, which a module or package test reads.
  let wsTestInputs(ws: Workspace!): GoTestInputs! {
    GoTestInputs(
      source: source(ws, test: true),
      testData: testData(ws),
      configs: gomod.daggerConfigs(ws),
      version: if (baseImage == null) { toolchainVersion(ws) } else { "" },
      importPath: importPath(ws),
      headers: lib.scan(ws).sync.file("_headers_.gohdr"),
    )
  }

  # The container the tests run in: this module's Go container, with no Go
  # cache volume, since nothing in it compiles the module.
  let testBase(version: String!): Container! {
    baseFor(version).withoutMount("/go/pkg/mod").withoutMount("/root/.cache/go-build")
  }

  """
  Test container with this module's sources, testdata, and otelgotest in
  place, before any test command runs.
  """
  let testEnvFrom(inputs: GoTestInputs!): Container! {
    gomod
      .withTool(testBase(inputs.version), "otelgotest", testRunner)
      .withDirectory(".", inputs.source)
      .withDirectory(".", inputs.testData)
      # A test that serves a Dagger module needs that module's config, which is
      # not a Go file and so is not in the source mount. Without it the serve
      # fails with "does not contain a dagger config file" even though the
      # module's Go code is right there.
      .withDirectory(".", inputs.configs)
      # Nested Dagger clients find the workspace boundary by walking up to .git.
      .withNewFile(".git/HEAD", "ref: refs/heads/main\n")
      # With its own session rather than the one running the tests, a module
      # address resolves against the user's workspace instead of against this
      # module. A client provisions through a CLI there; the engine mounts a
      # version-matched one on PATH, which newer SDKs find by themselves, while
      # older ones only read _EXPERIMENTAL_DAGGER_CLI_BIN.
      .withEnvVariable("_EXPERIMENTAL_DAGGER_CLI_BIN", "/dev/.dagger/dagger")
  }

  # The test binaries of the module-relative package directories dirs that
  # have test files for the engine's platform, from one plan of them all, in
  # a directory relative to the module, each at <dir>/<name>.test as go test
  # -c names it. As go test, it builds with the containers' GOFLAGS and
  # without the build setting's flags, which are go build's.
  let testBinarySet(inputs: GoTestInputs!, dirs: [String!]!): Directory! {
    # Only what the binaries' build reads of the source (Gobuild.scope), so
    # an edit of any other file leaves the build cached.
    let read = builder.scope(
      base: testBuildBase(inputs),
      image: if (baseImage == null) { gomod.goImage(inputs.version) } else { "" },
      from: if (baseImage == null) { null } else { baseImage.withoutEntrypoint },
      source: inputs.source,
      headers: inputs.headers,
      mountPath: mountPath,
      workdir: path,
      packages: dirs.map { dir => packageArg(dir) },
      tests: true,
      downloads: tool.downloads,
    )
    builder.testBinaries(
      base: testBuildBase(inputs),
      image: if (baseImage == null) { gomod.goImage(inputs.version) } else { "" },
      from: if (baseImage == null) { null } else { baseImage.withoutEntrypoint },
      source: read.source,
      headers: read.headers,
      mountPath: mountPath,
      workdir: path,
      pkgs: dirs.map { dir => packageArg(dir) },
      downloads: tool.downloads,
    )
  }

  # One package's test binary, alone, in a directory as testBinarySet's: a
  # set of one, or for gccgo, which compiles differently from the gc
  # toolchain the per-package build replays, one go test -c without the Go
  # cache volumes, as a package's testBinary builds it. Either has no binary
  # when the package's test files are all for other platforms.
  let testBinaryOne(inputs: GoTestInputs!, dir: String!): Directory! {
    if (testGccgo(inputs)) {
      let name = testBinaryName(inputs.importPath, dir)
      let at = if (dir == ".") { name } else { dir + "/" + name }
      testBuildBase(inputs)
        .withoutMount("/go/pkg/mod")
        .withoutMount("/root/.cache/go-build")
        .withDirectory(".", inputs.source)
        .withWorkdir(path)
        # As the set does, a package whose files are all for other
        # platforms has no binary, rather than failing go test -c.
        .withExec([
          "sh", "-c",
          "mkdir -p /out && t=$(go list -e -f \"$3\" \"$2\") && if [ -n \"$t\" ]; then mkdir -p \"/out/$(dirname \"$1\")\" && go test -c -vet=off -o \"/out/$1\" \"$2\"; fi",
          "sh", at, packageArg(dir),
          "{{if or .TestGoFiles .XTestGoFiles (and .Error (or .InvalidGoFiles (not .IgnoredGoFiles)))}}x{{end}}",
        ])
        .directory("/out")
    } else {
      testBinarySet(inputs, [dir])
    }
  }

  # Whether the test containers' GOFLAGS pick the gccgo compiler.
  let testGccgo(inputs: GoTestInputs!): Boolean! {
    gccgo(goflagsFields(testBuildBase(inputs).envVariable("GOFLAGS") ?? ""))
  }

  # GOFLAGS' flags: go splits it at white space, and a flag in quotes is
  # that flag. A value with white space inside quotes is not split right.
  let goflagsFields(goflags: String!): [String!]! {
    goflags.replaceMatches(`\s+`, with: " ").split(" ").filter { f => f != "" }.map { f =>
      f.replaceMatches(`^'(.*)'$`, with: "$1").replaceMatches(`^"(.*)"$`, with: "$1")
    }
  }

  let testBuildBase(inputs: GoTestInputs!): Container! {
    let target = gomod.hostPlatform.split("/")
    baseFor(inputs.version)
      .withEnvVariable("GOOS", target.takeFirst(1).join(""))
      .withEnvVariable("GOARCH", target.takeLast(1).join(""))
  }

  # The test binaries of dirs, each as a package's build gives it. When the
  # set builds, every package of it has its binary, or none when its test
  # files are all for other platforms. When it fails, as go test still runs
  # the packages that build, each package is built alone, and the one that
  # fails has its error in place of a binary. A gccgo build has no set.
  # tools, which the tests will run with, build at the same time as the set,
  # rather than after it: they are a block, so that nothing builds them
  # before this, and the two are fields of one {{ }}, whose fields run at
  # once. A tool that fails to build fails the call.
  let testBinaries(inputs: GoTestInputs!, dirs: [String!]!, &tools: Directory!): [GoTestBinary!]! {
    let built = {{
      tools: tools.sync
      set: if (testGccgo(inputs)) { null } else {
        {
          testBinarySet(inputs, dirs).sync
        } rescue {
          err: Error => null
        }
      }
    }}
    let set = built.set
    dirs.map { dir =>
      let name = testBinaryName(inputs.importPath, dir)
      let at = if (dir == ".") { name } else { dir + "/" + name }
      if (set != null) {
        GoTestBinary(directory: dir, name: name, file: if (set!.exists(at)) { set!.file(at) } else { null })
      } else {
        {
          let one = testBinaryOne(inputs, dir).sync
          GoTestBinary(directory: dir, name: name, file: if (one.exists(at)) { one.file(at) } else { null })
        } rescue {
          err: Error => GoTestBinary(directory: dir, name: name, failure: err.message)
        }
      }
    }
  }

  # The name go test -c gives a package's test binary on the engine's
  # platform: its import path's last element, or the one before when that is
  # a major version such as "v2", then ".test".
  let testBinaryName(moduleImportPath: String!, dir: String!): String! {
    let full = if (dir == ".") { moduleImportPath } else { moduleImportPath + "/" + dir }
    let elements = full.split("/")
    let last = elements.takeLast(1).join("")
    let base = if (elements.length > 1 and last.replaceMatches(`^v([2-9]|[1-9][0-9]+)$`, with: "") == "") {
      elements.dropLast(1).takeLast(1).join("")
    } else {
      last
    }
    base + ".test"
  }

  # The test binary flags go test passes from GOFLAGS, as it passes them: the
  # testing package's flags it forwards (go test's passFlagToTest), each as
  # -test.<name>=<value>. With -json, go test drops -v, which its own
  # -test.v=test2json replaces. go test runs in the module's directory and
  # the binary in its package's, so -outputdir is made absolute there, and
  # set to it when a profile or -artifacts asks for one, as go test sets it.
  let goflagsTestFlags(goflags: String!, json: Boolean!): [String!]! {
    let forwarded = [
      "artifacts", "bench", "benchmem", "benchtime", "blockprofile", "blockprofilerate", "count",
      "coverprofile", "cpu", "cpuprofile", "failfast", "fullpath", "fuzz", "fuzzminimizetime",
      "fuzztime", "list", "memprofile", "memprofilerate", "mutexprofile", "mutexprofilefraction",
      "outputdir", "parallel", "run", "short", "shuffle", "skip", "timeout", "trace", "v",
    ]
    let moduleDir = mountPath.trimSuffix("/") + (if (path == ".") { "" } else { "/" + path })
    let flags = goflagsFields(goflags).filter { f => f.hasPrefix("-") }.map { f =>
      let parts = f.trimPrefix("-").trimPrefix("-").split("=")
      let name = parts[0]!.trimPrefix("test.")
      let given = if (parts.length > 1) { parts.dropFirst(1).join("=") } else { "true" }
      let value = if (name == "outputdir" and given.hasPrefix("/") == false) { moduleDir + "/" + given } else { given }
      if (forwarded.contains(name) and (json == false or name != "v")) { "-test." + name + "=" + value } else { "" }
    }.filter { f => f != "" }
    let output = ["blockprofile", "coverprofile", "cpuprofile", "memprofile", "mutexprofile", "trace", "artifacts"]
    let wantsDir = flags.any { f => output.any { name => f.hasPrefix("-test." + name + "=") } }
    if (wantsDir and flags.any { f => f.hasPrefix("-test.outputdir=") } == false) {
      flags + ["-test.outputdir=" + moduleDir]
    } else {
      flags
    }
  }

  # Where a package's test binary is mounted in its test container.
  let testBinaryPath(binary: GoTestBinary!): String! {
    "/dagger-go-test/" + binary.name
  }

  # A package's tests run from its test binary as go test runs it: from the
  # package's directory, with go test's test binary flags, under otelgotest,
  # which reports what go test -json would. args are the binary's own flags
  # after GOFLAGS'.
  let packageTestArgs(env: Container!, inputs: GoTestInputs!, binary: GoTestBinary!, json: Boolean!, args: [String!]!): [String!]! {
    let pkg = inputs.importPath + (if (binary.directory == ".") { "" } else { "/" + binary.directory })
    let jsonFlag = if (json) { ["-json"] } else { [] }
    ["otelgotest"] + jsonFlag + ["-p", pkg, testBinaryPath(binary)]
      + goflagsTestFlags(env.envVariable("GOFLAGS") ?? "", json) + args
  }

  let packageTestEnv(env: Container!, binary: GoTestBinary!): Container! {
    env
      .withMountedFile(testBinaryPath(binary), binary.file!)
      .withWorkdir(if (binary.directory == ".") { path } else { path + "/" + binary.directory })
  }

  """
  Container that has run every test of this module, a package at a time, as
  go test ./... runs them. It fails when a package with tests does not
  build, or when its tests fail; the packages that do build run whatever
  else fails.
  """
  let testExec(ws: Workspace!): Container! {
    let inputs = wsTestInputs(ws)
    let tested = lib.at(path).testDirectories(ws).map { p => relativeDir(p) }.filter { dir => matchesAll(dir) }
    let binaries = moduleTestBinaries(inputs, tested)
    # go test fails when ./... matches no package: here, when no package's
    # test files build for the platform and the module has no Go file that
    # isn't a test's. Files that build constraints leave out all count.
    if (tested.length > 0 and binaries.length == 0 and moduleGoFiles(inputs).length == 0) {
      raise "no packages to test"
    }
    let env = testEnvFrom(inputs)
    # Every package's exec runs at once, as go test runs packages in
    # parallel: one file from each, merged and synced.
    let ran = {
      binaries.filter { b => b.file != null }.reduce(directory) { out, binary =>
        let done = packageTestEnv(env, binary)
          .withExec(packageTestArgs(env, inputs, binary, false, []), daggerInDaggerNewSession: true)
          .withNewFile("/dagger-go-test/ran", "")
          .file("/dagger-go-test/ran")
        out.withFile(binary.directory + "/" + binary.name + ".ran", done)
      }.sync
      ""
    } rescue {
      err: Error => err.message
    }
    let failures = binaries.filter { b => b.failure != null }.map { b =>
      "Go tests in " + packagePath(b.directory) + ": " + b.failure!
    } + [ran].filter { f => f != "" }
    if (failures.length > 0) { raise failures.join("\n") }
    env
  }

  # The module's Go files that aren't tests', in directories ./... matches:
  # not in a nested module.
  let moduleGoFiles(inputs: GoTestInputs!): [String!]! {
    let prefix = if (path == ".") { "" } else { path + "/" }
    let nested = inputs.source.glob(prefix + "**/go.mod").map { f => f.trimPrefix(prefix).trimSuffix("go.mod") }
      .filter { root => root != "" }
    (inputs.source.glob(prefix + "*.go") + inputs.source.glob(prefix + "**/*.go")).uniq.filter { f =>
      let rel = f.trimPrefix(prefix)
      let dir = rel.split("/").dropLast(1).join("/")
      rel.hasSuffix("_test.go") == false
        and matchesAll(if (dir == "") { "." } else { dir })
        and nested.any { root => rel.hasPrefix(root) } == false
    }
  }

  # The test binaries of the directories with test files that ./... matches,
  # without the directories whose test files are all for other platforms,
  # which go test leaves out or reports as having none.
  let moduleTestBinaries(inputs: GoTestInputs!, dirs: [String!]!): [GoTestBinary!]! {
    let binaries = testBinaries(inputs, dirs) { directory.withFile("otelgotest", testRunner) }
    binaries.filter { b => b.file != null or b.failure != null }
  }

  # Whether the package pattern ./... matches a module-relative directory:
  # go leaves out vendor and testdata directories, and those whose name
  # starts with "." or "_".
  let matchesAll(dir: String!): Boolean! {
    dir == "." or dir.split("/").any { element =>
      element == "vendor" or element == "testdata" or element.hasPrefix(".") or element.hasPrefix("_")
    } == false
  }

  """
  Run the named tests in one package, or all of them when names is empty,
  naming the package when they fail.
  """
  let runPackageTests(ws: Workspace!, dir: String!, names: [String!]!): Void {
    let inputs = wsTestInputs(ws)
    let run = if (names.length == 0) { [] } else { ["-test.run=^(" + names.join("|") + ")$"] }
    let binaries = testBinaries(inputs, [dir]) { directory.withFile("otelgotest", testRunner) }
    let binary = binaries[0]!
    if (binary.failure != null) {
      raise "Go tests in " + packagePath(dir) + ": " + binary.failure!
    }
    # A package whose test files are all for other platforms has no test
    # binary, and go test reports it has none and passes it.
    if (binary.file != null) {
      let env = testEnvFrom(inputs)
      packageTestEnv(env, binary)
        .withExec(packageTestArgs(env, inputs, binary, false, run), daggerInDaggerNewSession: true)
        .sync rescue {
        err: Error => raise "Go tests in " + packagePath(dir) + ": " + err.message
      }
    }
    null
  }

  """
  One report per package for every selected test in this Go module, each
  from its package's test binary.
  """
  let runTests(inputs: GoTestInputs!, packages: GoPackages!): GoTestResults! {
    let moduleImportPath = inputs.importPath
    let discovered = packages
      .entries
      .filter { entry => packages.paths.contains(entry.directory) }
      .map { entry =>
        let dir = relativeDir(entry.directory)
        GoTestSelection(
          names: entry.tests.names,
          directory: dir,
          pkg: moduleImportPath + (if (dir == ".") { "" } else { "/" + dir }),
          narrowed: entry.tests.narrowed,
        )
      }
    let selected = discovered.filter { tests => tests.names.length > 0 }
    if (selected.length == 0) { raise "no tests selected in module " + path }
    let empty: [String!]! = []
    let narrowed = discovered.any { tests => tests.narrowed }
    # Only packages holding selected tests run: the module's other packages
    # failing would otherwise fail every check.
    let binaries = testBinaries(inputs, selected.map { tests => tests.directory }) {
      directory.withFile("otelgotest", testRunner).withFile("go-test-report", testReportIndexer)
    }
    let env = testEnvFrom(inputs)
    # Every check of the module evaluates this, so the names are only
    # gathered and sorted for the narrowed run that needs them. As go test
    # was given one pattern for every package, each package gets it.
    let run = if (narrowed) {
      let names = tool.sorted(selected.reduce(empty) { all, tests => all + tests.names }.uniq)
      ["-test.run=^(" + names.join("|") + ")$"]
    } else { empty }
    let results = selected.reduce(directory) { out, tests =>
      # Numeric ranks, as GoTestResults.assertPassed reads them.
      let index = selected.filter { other => other.pkg < tests.pkg }.length
      let binary = binaries.filter { b => b.directory == tests.directory }[0]!
      out.withDirectory(`${index}`, packageResults(env, inputs, binary, tests, run))
    }
    GoTestResults(results: results, selections: selected)
  }

  # One package's results for its selected tests, one file per test by its
  # rank among them, empty when it passed: what its test binary reported, or
  # its build failure.
  let packageResults(
    env: Container!,
    inputs: GoTestInputs!,
    binary: GoTestBinary!,
    tests: GoTestSelection!,
    run: [String!]!,
  ): Directory! {
    if (binary.failure != null) {
      let failure = "package failed to build\n" + binary.failure!
      tests.names.reduce(directory) { out, name =>
        out.withNewFile(`${tests.names.filter { other => other < name }.length}`, failure)
      }
    } else {
      let selection = JSON.encode([{{pkg: tests.pkg, names: tests.names}}])
      # A package whose test files are all for other platforms has no test
      # binary, and go test -json reports it as having no test files.
      let executed = if (binary.file == null) {
        env
          .withNewFile(
            "/go-test-report.json",
            JSON.encode({{Action: "start", Package: tests.pkg}}) + "\n"
              + JSON.encode({{Action: "output", Package: tests.pkg, Output: "?   \t" + tests.pkg + "\t[no test files]\n"}}) + "\n"
              + JSON.encode({{Action: "skip", Package: tests.pkg}}) + "\n",
          )
          .withNewFile("/go-test-stderr.log", "")
          .withNewFile("/go-test-exit-code", "0")
      } else {
        # The shell records the exit status for the report, so the exec is
        # the same whether the tests pass or fail.
        # The files are made first, writable by the test's user, who may not
        # be root and cannot create files under /.
        ["/go-test-report.json", "/go-test-stderr.log", "/go-test-exit-code"].reduce(packageTestEnv(env, binary)) { ctr, file =>
          ctr.withNewFile(file, "", permissions: 438)
        }.withExec(
          ["sh", "-c", "\"$@\" > /go-test-report.json 2> /go-test-stderr.log; echo $? > /go-test-exit-code", "sh"]
            + packageTestArgs(env, inputs, binary, true, run),
          daggerInDaggerNewSession: true,
        )
      }
      # Only post-processing needs to create files under /. The test command
      # above retains the custom base's configured user.
      executed
        .withUser("0:0")
        .withFile("/usr/local/bin/go-test-report", testReportIndexer)
        .withNewFile("/go-test-selection.json", selection)
        .withExec([
          "/usr/local/bin/go-test-report",
          "--report", "/go-test-report.json",
          "--stderr", "/go-test-stderr.log",
          "--selection", "/go-test-selection.json",
          "--exit-code-file", "/go-test-exit-code",
          "--output", "/go-test-results",
        ])
        .directory("/go-test-results/0")
    }
  }

  # Main packages are found by searching the source, like test names, so
  # listing them runs no container. A directory is one when one of its own
  # non-test files says "package main" without an ignore build tag, which is
  # how go:generate scripts are kept out of the build. Other build constraints
  # are not evaluated: the build reports what the search got wrong.
  let binaryPackages(ws: Workspace!): [String!]! {
    discoveryLines(ws)
      .filter { line =>
        line.hasPrefix("package\t" + path + "\t") and line.split("\t").takeLast(1).join("").split("").contains("m")
      }
      .map { line => line.split("\t").takeFirst(3).takeLast(1).join("") }
      .filter { pkg => buildSelected(pkg) }
  }

  # Whether the build setting selects a module-relative main package. A pattern
  # matches the package's directory within the module or its workspace path, so
  # "!vendor" leaves out every main package in modules under vendor.
  let buildSelected(pkg: String!): Boolean! {
    let paths = [pkg, packagePath(pkg)]
    let selecting = buildPatterns.filter { p => p.hasPrefix("!") == false }
    let excluding = buildPatterns.filter { p => p.hasPrefix("!") }
    (
      selecting.length == 0 or selecting.any { p =>
        paths.any { at =>
          rootSelected(
            normalized(at),
            [p],
          )
        }
      }
    )
      and excluding.any { p => paths.any { at => rootSelected(normalized(at), [p]) == false } } == false
  }

  # The module path go.mod declares, as the scan reports it. The root
  # package's binary is named from it.
  let importPath(ws: Workspace!): String! {
    moduleField(ws, 2)
  }

  let packageArg(pkg: String!): String! {
    if (pkg == ".") { "." } else { "./" + pkg }
  }

  # This module's Go container targeting a GOOS/GOARCH platform, before
  # source is added.
  let platformBase(ws: Workspace!, platform: String!): Container! {
    let target = platform.split("/")
    base(ws)
      .withEnvVariable("GOOS", target.takeFirst(1).join(""))
      .withEnvVariable("GOARCH", target.takeLast(1).join(""))
  }

  # What go build writes for one main package: the binary, named name as go
  # build names it, and for a c-archive or c-shared build the C header next to
  # it. A gc build runs one cached exec per package, so an edit rebuilds only
  # the packages it reaches.
  let buildOutputs(
    ws: Workspace!,
    platform: String!,
    pkg: String!,
    name: String!,
  ): Directory! {
    let ctr = platformBase(ws, platform)
    let flags = buildFlags + (ctr.envVariable("GOFLAGS") ?? "").split(" ").filter { f => f != "" }
    let out = if (gccgo(flags)) {
      wholeBuild(ws, ctr, pkg, name)
    } else {
      perPackageBuild(ws, ctr, pkg, name)
    }
    # The engine's own message is only the exit code: raise it under a name.
    out.sync rescue {
      err: Error => raise "Go binary " + packagePath(pkg) + " for " + platform + ": " + err.message
    }
    out
  }

  # One main package's binary, named name, built as buildOutputs builds it.
  # It is read from the directory before that is evaluated: read from an
  # evaluated directory, a file is keyed by its content, which costs a hash of
  # the whole binary.
  let buildFile(ws: Workspace!, platform: String!, pkg: String!, name: String!): File! {
    let ctr = platformBase(ws, platform)
    let flags = buildFlags + (ctr.envVariable("GOFLAGS") ?? "").split(" ").filter { f => f != "" }
    let out = if (gccgo(flags)) {
      wholeBuild(ws, ctr, pkg, name).file(name)
    } else {
      perPackageBuild(ws, ctr, pkg, name).file(name)
    }
    out.sync rescue {
      err: Error => raise "Go binary " + packagePath(pkg) + " for " + platform + ": " + err.message
    }
    out
  }

  # Whether go build flags, with GOFLAGS, pick the gccgo compiler.
  let gccgo(flags: [String!]!): Boolean! {
    flags.any { f => f == "-compiler=gccgo" or f == "--compiler=gccgo" }
      or (flags.any { f => f == "-compiler" or f == "--compiler" } and flags.contains("gccgo"))
  }

  # A gccgo build: gccgo compiles differently from the gc toolchain that the
  # per-package build replays, so it is one go build, as it always was, but
  # without the shared Go cache volumes, so its result is an ordinary one
  # another engine can pull from the remote cache.
  let wholeBuild(ws: Workspace!, ctr: Container!, pkg: String!, name: String!): Directory! {
    ctr
      .withoutMount("/go/pkg/mod")
      .withoutMount("/root/.cache/go-build")
      .withDirectory(".", source(ws))
      .withWorkdir(path)
      .withExec(["go", "build"] + buildFlags + ["-o", "/out/" + name, packageArg(pkg)])
      .directory("/out")
  }

  # What a per-package build of pkgs in ctr reads of the workspace's source
  # and header pack, with the packages' test files when test is set
  # (Gobuild.scope): given it, the build is cached across an edit of any
  # other file.
  let scoped(ws: Workspace!, ctr: Container!, pkgs: [String!]!, test: Boolean!, dependencies: Boolean! = false): GobuildScoped! {
    builder.scope(
      base: ctr,
      image: if (baseImage == null) { gomod.goImage(toolchainVersion(ws)) } else { "" },
      from: if (baseImage == null) { null } else { baseImage.withoutEntrypoint },
      source: source(ws, test: test),
      headers: lib.scan(ws).sync.file("_headers_.gohdr"),
      mountPath: mountPath,
      workdir: path,
      packages: pkgs,
      tests: test,
      dependencies: dependencies,
      flags: buildFlags,
      downloads: tool.downloads,
    )
  }

  # A gc build, one cached exec per package.
  let perPackageBuild(
    ws: Workspace!,
    ctr: Container!,
    pkg: String!,
    name: String!,
  ): Directory! {
    let read = scoped(ws, ctr, [packageArg(pkg)], false)
    builder.binary(
      base: ctr,
      # The toolchain image the base starts from, or the custom base it was
      # made from, so package execs can run in it without the base's
      # project-specific setup.
      image: if (baseImage == null) { gomod.goImage(toolchainVersion(ws)) } else { "" },
      from: if (baseImage == null) { null } else { baseImage.withoutEntrypoint },
      source: read.source,
      headers: read.headers,
      mountPath: mountPath,
      workdir: path,
      pkg: packageArg(pkg),
      output: name,
      downloads: tool.downloads,
      sharedImports: tool.sharedImports,
      flags: buildFlags,
    )
  }

  # The workspace package paths among pkgPaths that are main packages selected
  # by the build setting.
  let mainPackages(ws: Workspace!, pkgPaths: [String!]!): [String!]! {
    let mains = binaryPackages(ws)
    pkgPaths.filter { p => mains.contains(relativeDir(p)) }
  }

  # The name go build gives a package's binary: the last element of its import
  # path, or the one before when that is a major version such as "v2", with
  # ".exe" for Windows.
  let binaryFileName(ws: Workspace!, pkgPath: String!, platform: String!): String! {
    let rel = relativeDir(pkgPath)
    let modPath = importPath(ws)
    let full = if (rel == ".") { modPath } else { modPath + "/" + rel }
    let elements = full.split("/")
    let last = elements.takeLast(1).join("")
    let name = if (elements.length > 1 and last.replaceMatches(
      `^v([2-9]|[1-9][0-9]+)$`,
      with: "",
    ) == "") {
      elements.dropLast(1).takeLast(1).join("")
    } else {
      last
    }
    if (platform.hasPrefix("windows/")) { name + ".exe" } else { name }
  }

  # One package's binary for a platform. Only a main package selected by the
  # build setting has one.
  let binaryFile(ws: Workspace!, platform: String!, pkgPath: String!): File! {
    buildFile(ws, platform, selectedMain(ws, pkgPath), binaryFileName(
      ws,
      pkgPath,
      platform,
    ))
  }

  # One package's binary for a platform with what go build writes next to
  # it: the C header of a c-archive or c-shared build.
  let binaryOutputs(ws: Workspace!, platform: String!, pkgPath: String!): Directory! {
    buildOutputs(ws, platform, selectedMain(ws, pkgPath), binaryFileName(
      ws,
      pkgPath,
      platform,
    ))
  }

  # A package's directory relative to the module, which must be a main
  # package selected by the build setting.
  let selectedMain(ws: Workspace!, pkgPath: String!): String! {
    let rel = relativeDir(pkgPath)
    if (binaryPackages(ws).contains(rel) == false) {
      raise "Go package " + pkgPath + " is not a main package selected by build"
    }
    rel
  }

  # One package's test binary for a platform, named as go test -c names it.
  # A gc build runs one cached exec per package, as a binary's does. With
  # other packages in set, it is planned with theirs (GoPackage.testBinary).
  let testBinaryFile(ws: Workspace!, platform: String!, pkgPath: String!, set: [String!]!): File! {
    let rel = relativeDir(pkgPath)
    # go test -c's own rule: a package with test files has a test binary,
    # whatever they hold.
    let tested = lib.at(path).testDirectories(ws)
    if (tested.contains(pkgPath) == false) {
      raise "Go package " + pkgPath + " has no test files"
    }
    let planned = set.filter { p => tested.contains(p) }.map { p => packageArg(relativeDir(p)) }
    let name = if (platform.hasPrefix("windows/")) {
      binaryFileName(ws, pkgPath, platform).trimSuffix(".exe") + ".test.exe"
    } else {
      binaryFileName(ws, pkgPath, platform) + ".test"
    }
    let ctr = platformBase(ws, platform)
    let flags = buildFlags + (ctr.envVariable("GOFLAGS") ?? "").split(" ").filter { f => f != "" }
    let out = if (gccgo(flags)) {
      ctr
        .withoutMount("/go/pkg/mod")
        .withoutMount("/root/.cache/go-build")
        .withDirectory(".", source(ws, test: true))
        .withWorkdir(path)
        .withExec(["go", "test", "-c", "-vet=off"] + buildFlags + ["-o", "/out/" + name, packageArg(rel)])
        .file("/out/" + name)
    } else if (planned.length > 1) {
      # The set's plan saves each member its own, but only while every
      # member loads: one that can't, which go test -c of this package alone
      # never reads, fails it. This package is then planned alone, and an
      # error is its own.
      {
        planTestBinary(ws, ctr, rel, planned).sync
      } rescue {
        err: Error => planTestBinary(ws, ctr, rel, [])
      }
    } else {
      planTestBinary(ws, ctr, rel, [])
    }
    out.sync rescue {
      err: Error => raise "Go test binary " + packagePath(rel) + " for " + platform + ": " + err.message
    }
    out
  }

  # The test binary of the package at rel, from the plan of set's test
  # binaries with it, or with none, its own.
  let planTestBinary(ws: Workspace!, ctr: Container!, rel: String!, set: [String!]!): File! {
    let read = scoped(ws, ctr, if (set.length > 1) { set } else { [packageArg(rel)] }, true)
    builder.testBinary(
      base: ctr,
      image: if (baseImage == null) { gomod.goImage(toolchainVersion(ws)) } else { "" },
      from: if (baseImage == null) { null } else { baseImage.withoutEntrypoint },
      source: read.source,
      headers: read.headers,
      mountPath: mountPath,
      workdir: path,
      pkg: packageArg(rel),
      flags: buildFlags,
      downloads: tool.downloads,
      sharedImports: tool.sharedImports,
      set: if (set.length > 1) { set } else { null },
    )
  }

  # The test binaries of the packages among pkgPaths that have test files,
  # for a platform, from one plan of them all, each in its package's
  # directory relative to the workspace, named as go test -c names it.
  let testBinaryFiles(ws: Workspace!, platform: String!, pkgPaths: [String!]!): Directory! {
    let tested = lib.at(path).testDirectories(ws)
    let rels = pkgPaths.filter { p => tested.contains(p) }.map { p => relativeDir(p) }
    let ctr = platformBase(ws, platform)
    let flags = buildFlags + (ctr.envVariable("GOFLAGS") ?? "").split(" ").filter { f => f != "" }
    let built = if (rels.length == 0) {
      directory
    } else if (gccgo(flags)) {
      raise "Go module " + path + ": a gccgo build has no set of test binaries from one plan; build each package's testBinary"
    } else {
      let read = scoped(ws, ctr, rels.map { rel => packageArg(rel) }, true)
      builder.testBinaries(
        base: ctr,
        image: if (baseImage == null) { gomod.goImage(toolchainVersion(ws)) } else { "" },
        from: if (baseImage == null) { null } else { baseImage.withoutEntrypoint },
        source: read.source,
        headers: read.headers,
        mountPath: mountPath,
        workdir: path,
        pkgs: rels.map { rel => packageArg(rel) },
        flags: buildFlags,
        downloads: tool.downloads,
        sharedImports: tool.sharedImports,
      )
    }
    let out = if (path == ".") { built } else { directory.withDirectory(path, built) }
    out.sync rescue {
      err: Error => raise "Go test binaries of module " + path + " for " + platform + ": " + err.message
    }
    out
  }

  """
  The compiled packages a lint of this module reads, for golangci-lint's
  export driver: a directory of their export data, the archives go tool
  compile -pack -linkobj writes without the object code, under archives/,
  the Go files cgo wrote for each cgo
  package under cgo/, and manifest.json, which describes them: the Go
  version, target and build tags they were compiled for, and for each
  package, by its ID as go list -test names it, its archive, its cgo files
  and output, and a digest of the files it was compiled from.

  The packages are what go list -export -deps -test compiles for the
  module: its packages, main packages included, their test variants and
  external test packages, what is recompiled against those, and every
  package they import, for the engine's platform, with buildFlags. With them
  the driver compiles nothing and runs no cgo. Each compiles in a cached
  exec of its own, as a binary's packages do, so a package compiled the same
  way for a build or a test binary is shared.
  """
  archives(
    ws: Workspace!,
    """
    Only the packages from other modules and the standard library, keyed by
    their content alone: an edit of this module's own packages leaves them
    as they are.
    """
    dependencies: Boolean! = false,
    """
    The packages whose imports are archived, as go list patterns from the
    module's directory, e.g. ["."] for what its root package type-checks
    against.
    """
    packages: [String!]! = ["./..."],
    """
    Without the packages' test variants and external test packages, and
    what only they import, which a lint reads.
    """
    noTests: Boolean! = false,
    """
    The GOOS/GOARCH they're compiled for, e.g. "linux/arm64": the engine's
    platform when unset. The engine's own toolchain compiles them, so an
    engine of any platform makes them for any other.
    """
    platform: String,
  ): Directory! {
    let ctr = platformBase(ws, platform ?? gomod.hostPlatform)
    let flags = buildFlags + (ctr.envVariable("GOFLAGS") ?? "").split(" ").filter { f => f != "" }
    if (gccgo(flags)) {
      raise "Go module " + path + ": a gccgo build has no archives for the export driver, which reads gc's"
    }
    let read = scoped(ws, ctr, packages, noTests == false, dependencies: dependencies)
    let out = if (read.standIn) {
      # A stand-in for the module's own packages (Gobuild.scope) whose
      # build fails may fail where the module's own wouldn't, such as when
      # a dependency imports the module back: the module's own source
      # builds them then.
      {
        archivesOf(ws, ctr, read.source, read.headers, dependencies, packages, noTests).sync
      } rescue {
        err: Error => archivesOf(ws, ctr, source(ws, test: noTests == false), lib.scan(ws).sync.file("_headers_.gohdr"), dependencies, packages, noTests)
      }
    } else {
      archivesOf(ws, ctr, read.source, read.headers, dependencies, packages, noTests)
    }
    out.sync rescue {
      err: Error => raise "Go archives of module " + path + ": " + err.message
    }
    out
  }

  # The per-package build's archives of packages in ctr from source and its
  # header pack, as archives makes them.
  let archivesOf(ws: Workspace!, ctr: Container!, source: Directory!, headers: File!, dependencies: Boolean!, packages: [String!]!, noTests: Boolean!): Directory! {
    builder.archives(
      base: ctr,
      image: if (baseImage == null) { gomod.goImage(toolchainVersion(ws)) } else { "" },
      from: if (baseImage == null) { null } else { baseImage.withoutEntrypoint },
      source: source,
      headers: headers,
      mountPath: mountPath,
      workdir: path,
      flags: buildFlags,
      dependencies: dependencies,
      downloads: tool.downloads,
      sharedImports: tool.sharedImports,
      packages: packages,
      tests: noTests == false,
    )
  }

  """
  What archives reads from the cache that every build of the packages with
  the same toolchain, flags and go.sum shares (GoArchiveBuilds). A cache
  that is to have exactly these results, such as the cache an engine image
  pre-warms, is filled from them. The arguments are archives'.
  """
  archiveBuilds(
    ws: Workspace!,
    """
    Only the packages from other modules and the standard library.
    """
    dependencies: Boolean! = false,
    """
    The packages whose imports are compiled, as go list patterns from the
    module's directory.
    """
    packages: [String!]! = ["./..."],
    """
    Without the packages' test variants and external test packages, and
    what only they import.
    """
    noTests: Boolean! = false,
    """
    The GOOS/GOARCH they're compiled for, e.g. "linux/arm64": the engine's
    platform when unset.
    """
    platform: String,
  ): GoArchiveBuilds! {
    let ctr = platformBase(ws, platform ?? gomod.hostPlatform)
    let flags = buildFlags + (ctr.envVariable("GOFLAGS") ?? "").split(" ").filter { f => f != "" }
    if (gccgo(flags)) {
      raise "Go module " + path + ": a gccgo build has no archives"
    }
    {
      let cache = builder.archiveBuilds(
        base: ctr,
        image: if (baseImage == null) { gomod.goImage(toolchainVersion(ws)) } else { "" },
        from: if (baseImage == null) { null } else { baseImage.withoutEntrypoint },
        source: source(ws, test: noTests == false),
        headers: lib.scan(ws).sync.file("_headers_.gohdr"),
        mountPath: mountPath,
        workdir: path,
        flags: buildFlags,
        dependencies: dependencies,
        downloads: tool.downloads,
        sharedImports: tool.sharedImports,
        packages: packages,
        tests: noTests == false,
      )
      # A list of objects from a call becomes a list by a selection on
      # each: sync gives back the object it's selected on.
      GoArchiveBuilds(
        builds: cache.builds.{{sync}}.map { build => build.sync },
        downloads: cache.downloads.{{sync}}.map { download => download.sync },
        tool: cache.tool,
        manifestTool: cache.manifestTool,
        manifestSource: cache.manifestSource,
        tools: cache.tools,
        helper: gomod.includesHelper,
        helperBinary: gomod.includesHelperBinary(platform ?? gomod.hostPlatform),
        sharedDependencies: cache.sharedDependencies,
      )
    } rescue {
      err: Error => raise "Go archive builds of module " + path + ": " + err.message
    }
  }

  # The binaries of the main packages among pkgPaths, one build each: they
  # share the packages they have in common through the cache.
  let binaryFiles(ws: Workspace!, platform: String!, pkgPaths: [String!]!): Directory! {
    mainPackages(ws, pkgPaths).reduce(directory) { out, p =>
      out.withDirectory(".", binaryOutputs(ws, platform, p))
    }
  }
}

"""
Go tests in a package, keyed by name.
"""
type GoTests @collection {
  """
  Test, fuzz and example function names.
  """
  names: [String!]! @keys

  """
  Tests selected in or out since the collection was discovered.
  """
  delta: CollectionDelta @delta

  """
  Whether the active selection removed tests or packages from this collection.
  """
  narrowed: Boolean! { delta == null or delta!.removedKeys.length > 0 }

  let directory: String!

  let module: GoModule!
  let inputs: GoTestInputs

  """
  The test function with this name.
  """
  function(name: String!): GoTest! @get {
    GoTest(name: name, directory: directory, module: module, inputs: inputs!)
  }

  """
  Run the selected tests in this package.
  """
  test(ws: Workspace!): Void {
    # With nothing selected out, run the package as a whole rather than listing
    # every name in a -run pattern. Without a delta, the pattern is the safe
    # choice.
    let whole = if (delta == null) {
      false
    } else {
      delta.addedKeys.length == 0 and delta.removedKeys.length == 0
    }
    if (whole) {
      module.runPackageTests(ws, directory, [])
    } else if (names.length > 0) {
      module.runPackageTests(ws, directory, names)
    }
    null
  }
}

"""
A Go test function.
"""
type GoTest {
  """
  Test function name.
  """
  name: String!

  let directory: String!

  let module: GoModule!
  let inputs: GoTestInputs!

  """
  Run go tests
  """
  test(selection: GoPackages!): Void @check {
    module.runTests(inputs, selection).assertPassed(
      directory,
      module.packagePath(directory),
      name,
    )
  }
}

# Source inputs shared by the tests in one module. Tool setup stays in evaluation.
type GoTestInputs {
  let source: Directory!
  let testData: Directory!
  let configs: Directory!
  let version: String!
  let importPath: String!
  let headers: File!
}

# A package's test binary, as go test -c names it: the file, or none when its
# test files are all for other platforms, or the build's failure.
type GoTestBinary {
  let directory: String!
  let name: String!
  let file: File
  let failure: String
}

# Prepared source and container inputs. Commands stay in evaluation.
type GoGenerateInputs {
  let modulePath: String!
  let source: Directory
  let version: String!
  let failure: String
  let directories: [GoGenerateDirectory!]!
}

type GoGenerateDirectory {
  let path: String!
  let value: String!
  let container: Container
  let failure: String
}

# Carry workspace files across changes in the generation container.
type GoGeneration {
  let container: Container!
  let value: String!
}

# The shared indexer keeps each result small, regardless of total report size.
type GoTestResults {
  let results: Directory!
  let selections: [GoTestSelection!]!

  # directory is the package's module-relative directory, as the selections
  # hold it, and packagePath its workspace path, for messages. Matching on the
  # directory rather than the import path spares the check its own lookup of
  # the module's import path, which runTests has already made.
  let assertPassed(directory: String!, packagePath: String!, name: String!): Void {
    let selected = selections.filter { tests => tests.directory == directory }
    if (selected.length == 0) { raise "Go package is outside the test selection: " + packagePath }
    if (selected[0]!.names.contains(name) == false) { raise "Go test is outside the selection: " + name }
    let pkg = selected[0]!.pkg
    # Numeric ranks avoid filename limits and collisions for Go identifiers.
    let packageIndex = selections.filter { tests => tests.pkg < pkg }.length
    let testIndex = selected[0]!.names.filter { test => test < name }.length
    let failure = results.file(`${packageIndex}` + "/" + `${testIndex}`).contents
    if (failure != "") { raise "Go tests in " + packagePath + ": " + failure }
    null
  }
}

# The helper's immutable copy of the filtered collection keys.
type GoTestSelection {
  let names: [String!]!
  let directory: String!
  let pkg: String!
  let narrowed: Boolean!
}
