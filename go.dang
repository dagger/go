"""
A Dagger module for Go - a programming language for building simple, secure, scalable systems.

For Go lint checks, use github.com/dagger/golangci-lint.

https://dagger.io
https://golang.org
"""
type Go {
  """
  Go version used for the default Go base image. Null when a custom base is set.
  """
  version: String

  """
  Base image used for Go test, generate, and helper containers.
  """
  base: Container!

  new(
    """
    Go version used for the default Go base image.
    """
    version: String = null,
    """
    Base image used for Go test, generate, and helper containers.
    Mutually exclusive with version.
    """
    base: Container = null,
    """
    Extra workspace-root include patterns mounted for each module's Go commands.
    Use this for fixtures, generator inputs, or other files not covered by the
    built-in Go patterns.
    """
    includeExtraFiles: [String!]! = [],
    """
    Module roots to test. A bare pattern selects, a "!"-prefixed pattern
    excludes, and an exclude always wins (order does not matter). With no
    selecting pattern, every module is tested. Supported patterns: "**" or "*"
    (all modules), and "X" or "X/**" (module X and any module below it); other
    glob forms (mid-path "**", single-segment "*") are not interpreted.
    Examples: ["**", "!docs"] tests all but docs; ["e2e/**"] tests only e2e;
    ["!**"] tests nothing.
    """
    test: [String!]! = ["**"],
    """
    Directories to run go generate in. Paths are relative to the workspace root
    (the directory containing dagger.toml), independent of the invocation directory.

    A literal path selects only that directory, even if it is a Go module root.
    "." selects the workspace root only. Patterns use Dagger glob syntax:
    *, ?, and character classes match within a path segment; ** matches zero
    or more segments. "internal/**" includes internal itself and its descendants.
    A ! prefix excludes. Exclusions always win, regardless of pattern order.
    An empty list or a list containing only exclusions starts with all directories.
    The default ["**"] includes directories in nested Go modules.

    Example: ["sdk/go/engineconn", "internal/**", "!internal/fixtures/**"].
    This replaces module-level selection; literal paths no longer select children.
    See generateAll for execution behavior.
    """
    generate: [String!]! = ["**"],
    """
    Value of the GOFLAGS environment variable in every Go container, e.g.
    "-tags=extended,withdeploy". Flags that take a value must use the
    -flag=value form, as Go requires inside GOFLAGS.
    """
    goflags: String = null,
    """
    Absolute container path where the workspace is mounted for Go commands.
    Defaults to "/src/<workspace name>", where the name is the last segment of
    the workspace address (usually the repository name), so tests that expect
    the repository name in their working directory keep passing.
    """
    mountPath: String = null,
  ) {
    if (version != null and base != null) {
      raise "version and base are mutually exclusive"
    } else if ((mountPath ?? "/").hasPrefix("/") == false) {
      raise "mountPath must be an absolute container path: " + (mountPath ?? "")
    } else {
      self.version = if (base == null) { version ?? "1.26" } else { null }
      self.base = base ?? container.from("golang:" + (version ?? "1.26") + "-alpine")
      self.includeExtraFiles = includeExtraFiles
      self.test = test
      self.generate = generate
      self.goflags = goflags
      self.mountPath = mountPath
      self
    }
  }

  """
  Extra workspace-root include patterns mounted for each module's Go commands.
  Use this for fixtures, generator inputs, or other files not covered by the
  built-in Go patterns.
  """
  includeExtraFiles: [String!]! = []

  """
  Module roots to test ("!" excludes; see the `test` constructor argument).
  """
  test: [String!]! = ["**"]

  """
  Directories to run go generate in ("!" excludes; see the constructor).
  """
  generate: [String!]! = ["**"]

  """
  Value of the GOFLAGS environment variable in every Go container. Null leaves
  GOFLAGS unset.
  """
  goflags: String

  """
  Configured container mount path for the workspace. Null derives
  "/src/<workspace name>" from the workspace address.
  """
  mountPath: String

  """
  Container path where the workspace is mounted for Go commands: the
  configured mountPath, or "/src/<workspace name>".
  """
  let workspaceMountPath(ws: Workspace!): String! {
    mountPath ?? ("/src/" + workspaceName(ws))
  }

  """
  Last segment of the workspace root address, usually the repository name.
  """
  let workspaceName(ws: Workspace!): String! {
    # The canonical address spans the cwd and, for a git workspace, ends with
    # a version selector: "file:///home/me/hugo/docs" and
    # "github.com/org/hugo/docs@main" both have cwd "/docs". Drop the selector
    # first, then the cwd, then take what is left. The selector pattern stops
    # at "/" and ":" so an ssh user ("ssh://git@github.com/...") is untouched.
    let cwd = ws.cwd.trimSuffix("/")
    let location = ws.address.replaceMatches(`@[^/:@]*$`, with: "").trimSuffix("/")
    let root = if (cwd != "" and location.hasSuffix(cwd)) {
      location.trimSuffix(cwd)
    } else {
      location
    }
    root
      .split("/")
      .filter { segment => segment != "" }
      .takeLast(1)
      .join("")
      .trimSuffix(".git")
  }

  """
  Go modules discovered from go.mod files at or below the working directory,
  plus the enclosing module when the cwd is inside one. Optional include/exclude
  patterns filter the discovered module roots.
  """
  modules(
    ws: Workspace!,
    include: [String!]! = [],
    exclude: [String!]! = [],
    includeSkipTest: Boolean! = true,
    includeSkipGenerate: Boolean! = true,
  ): [GoModule!]! {
    ws
      .findRoots(markers: ["go.mod"])
      .map { root => workspaceRootPath(ws, root) }
      .filter { modPath =>
        modulePathIncluded(ws, modPath, include, exclude)
      }
      .map { modPath =>
        GoModule(
          path: modPath,
          version: version,
          baseImage: base,
          includeExtraFiles: includeExtraFiles,
          testPatterns: test,
          generatePatterns: generate,
          goflags: goflags,
          mountPath: workspaceMountPath(ws),
        )
      }
      .filter { mod =>
        (includeSkipTest or mod.skipTest == false)
          and (includeSkipGenerate or mod.skipGenerate(ws) == false)
      }
  }

  """
  Resolve a cwd-relative discovery result to a workspace-root-relative path.

  findRoots answers relative to the workspace cwd — "." for the cwd itself and
  ".." for an enclosing project — while every other path this module handles is
  workspace-root-relative.
  """
  let workspaceRootPath(ws: Workspace!, cwdPath: String!): String! {
    let segments = cwdPath.split("/").filter { segment => segment != "" and segment != "." }
    let up = segments.filter { segment => segment == ".." }.length
    let down = segments.filter { segment => segment != ".." }
    let resolved = ws.cwd.split("/").filter { segment => segment != "" }.dropLast(up) + down

    if (resolved.length == 0) { "." } else { resolved.join("/") }
  }

  let modulePathIncluded(
    ws: Workspace!,
    modPath: String!,
    include: [String!]!,
    exclude: [String!]!,
  ): Boolean! {
    if (include.length == 0 and exclude.length == 0) {
      true
    } else {
      let includePatterns = if (include.length == 0) { ["**"] } else { include }
      let glob = if (modPath == ".") { "**" } else { modPath.trimSuffix("/") + "/**" }
      ws
        .directory("/", include: includePatterns, exclude: exclude)
        .glob(glob)
        .length > 0
    }
  }

  """
  Return the Go module containing a workspace path.

  By default, path may be a module root or a directory inside a module. Set
  findUp to false when path is already a module root and no lookup is needed.
  """
  module(ws: Workspace!, path: String!, findUp: Boolean! = true): GoModule! {
    GoModule(
      path: if (findUp) {
        let foundGoModPath = ws.findUp("go.mod", path)
        if (foundGoModPath == null) {
          raise "no Go module found containing path: " + path
        } else {
          let goModPath = foundGoModPath.trimPrefix("/")
          if (goModPath == "go.mod") { "." } else {
            goModPath.trimSuffix("/go.mod")
          }
        }
      } else {
        path.trimPrefix("/")
      },
      version: version,
      baseImage: base,
      includeExtraFiles: includeExtraFiles,
      testPatterns: test,
      generatePatterns: generate,
      goflags: goflags,
      mountPath: workspaceMountPath(ws),
    )
  }

  """
  Run tests in every discovered Go module.
  Modules configured to skip tests are skipped.
  Every module runs even after one fails, and the failure lists each failing
  module by path.
  """
  testAll(ws: Workspace!): Void @check {
    # A selection over a list evaluates its elements concurrently, so all
    # module test commands run in parallel.
    let failures = modules(ws, includeSkipTest: false).{{path, failure: testFailure(ws)}}
      .filter { result => result.failure != null }
    if (failures.length > 0) {
      raise "Go module tests failed:\n" + failures.map { result =>
        "- " + result.path + ": " + (result.failure ?? "")
      }.join("\n")
    }
    null
  }

  """
  Run go generate . in selected directories across the workspace.
  Directories without generator commands are skipped; go:generate:include alone
  is not a command. Go controls build tags and file and command order in a package.

  Within each Go module, directories run in lexical path order.
  //go:generate:container selects a container for its directory, using the
  caller's Workspace.resolve. For example, //go:generate:container generate-env
  selects the workspace container named generate-env. External references such
  as docker.io/library/golang:1.26.1-alpine also work. Conflicting values in one directory
  are errors. Without the directive, the directory uses the configured base.
  Consecutive directories with the same value share a container. When the value
  changes, workspace files carry over, so later commands can use earlier output.
  Modules run independently; cross-module dependencies are not inferred.
  Use an explicit coordinating command when generators need a different order.
  """
  generateAll(ws: Workspace!): Changeset! @generate {
    let mods = modules(ws.withWorkdir(".")).filter { mod =>
      mod.skipGenerate(ws) == false
    }

    # Snapshot each selected module before generation, using the same source
    # boundary that its generate container will receive.
    let before = mods.reduce(directory) { before, mod =>
      before.withDirectory(mod.path, mod.source(ws, generate: true).directory(mod.path))
    }

    # Merge each generated module tree back into that snapshot, then diff once
    # so callers get one changeset for the whole workspace.
    let after = mods.reduce(before) { after, mod =>
      after.withDirectory(mod.path, mod.generateExec(ws).directory("."))
    }
    after.changes(before)
  }
}

# Keep all Dang types in one source file until Dagger v0.21.x can
# convert Workspace arguments for installed multi-file Dang toolchains.
# See dagger/dagger#13476.

"""
A Go module rooted at a workspace-relative path.
"""
type GoModule {
  """
  Workspace-relative path of this module root.
  """
  path: String!

  """
  Go version configured on the root Go module. Null when a custom base is set.
  """
  version: String

  """
  Base image used by this module's Go containers.
  """
  let baseImage: Container!

  """
  Extra workspace-root include patterns mounted for this module's Go commands.
  """
  includeExtraFiles: [String!]!

  """
  Gitignore-style globs selecting which module roots to test.
  """
  let testPatterns: [String!]!

  """
  Workspace-root-relative globs selecting directories to run go generate in.
  """
  let generatePatterns: [String!]!

  """
  Value of the GOFLAGS environment variable in this module's Go containers.
  """
  let goflags: String

  """
  Container path where the workspace is mounted for this module's Go commands.
  """
  mountPath: String!

  """
  Return a workspace-root path for a module-relative subpath.
  """
  let subpath(relativePath: String!): String! {
    if (path == ".") {
      relativePath
    } else {
      path.trimSuffix("/") + "/" + relativePath
    }
  }

  """
  Whether this module falls outside the configured test selection.
  """
  skipTest: Boolean! {
    outOfScope(testPatterns)
  }

  """
  Whether this module has no selected directories with go:generate commands.
  """
  skipGenerate(ws: Workspace!): Boolean! {
    generateDirectories(ws).length == 0
  }

  """
  Whether this module has go:generate commands, regardless of selection.
  """
  hasGenerateDirectives(ws: Workspace!): Boolean! {
    discoveredGenerateDirectories(ws).length > 0
  }

  """
  Selected generation directories in this module, in lexical order.
  Paths are workspace-root-relative. Nested modules have their own directory lists.
  """
  generateDirectories(ws: Workspace!): [String!]! {
    let included = generatePatterns.filter { p => p.hasPrefix("!") == false }
    let excluded = generatePatterns.filter { p => p.hasPrefix("!") }.map { p => p.trimPrefix("!") }
    let includeDirs = matchingGenerateDirectories(ws, included)
    let excludeDirs = matchingGenerateDirectories(ws, excluded)
    discoveredGenerateDirectories(ws).filter { dir =>
      (included.length == 0 or includeDirs.any { match => match == dir })
        and excludeDirs.any { match => match == dir } == false
    }
  }

  # Match direct Go files to include the workspace root and avoid treating a
  # literal directory as recursive. Glob syntax is entirely Dagger's.
  let matchingGenerateDirectories(ws: Workspace!, patterns: [String!]!): [String!]! {
    let empty: [String!]! = []
    patterns.reduce(empty) { dirs, pattern =>
      dirs + ws
        .glob(pattern.trimSuffix("/") + "/*.go")
        .filter { file => file.hasSuffix("/") == false }
        .map { file =>
          let dir = file.split("/").dropLast(1).join("/")
          if (dir == "") { "." } else { dir }
        }
    }
  }

  let discoveredGenerateDirectories(ws: Workspace!): [String!]! {
    let dirsFile = outputStem + ".generatedirs"
    allIncludesDir(ws, test: false, generate: true)
      .file(dirsFile)
      .contents
      .split("\n")
      .filter { dir => dir != "" }
  }

  """
  Whether this module root falls outside the selection `patterns`.

  Matching is on the module root path only — no workspace files are read. A
  bare pattern includes; a "!"-prefixed pattern excludes. With no include
  pattern, every module is included. A module is in scope when it matches an
  include and no exclude; an exclude always wins regardless of order.
  """
  let outOfScope(patterns: [String!]!): Boolean! {
    let included = patterns.filter { p => p.hasPrefix("!") == false }
    let excluded = patterns.filter { p => p.hasPrefix("!") }.map { p => p.trimPrefix("!") }
    let isIncluded = included.length == 0 or included.any { p => matchesModulePath(p) }
    let isExcluded = excluded.any { p => matchesModulePath(p) }
    isIncluded == false or isExcluded
  }

  """
  Whether this module root matches a single glob: "**"/"*" match everything,
  "X/**" or bare "X" match X and any module below it.
  """
  let matchesModulePath(pattern: String!): Boolean! {
    let p = pattern.trimPrefix("/").trimSuffix("/")
    if (p == "**" or p == "*") {
      true
    } else {
      let prefix = p.trimSuffix("/**")
      path == prefix or path.hasPrefix(prefix + "/")
    }
  }

  """
  Helper container that computes includes for every module in one local pass
  over a content-addressed Go-source snapshot of the workspace. It is identical
  across all modules, so the engine runs it once and reuses the result; the
  helper reads the snapshot from the local filesystem, so the exec caches on
  source content and makes no workspace gateway round-trips.
  """
  let allIncludesHelper(ws: Workspace!): Container! {
    baseImage
      .withoutEntrypoint
      .withWorkdir("/helpers/go-includes")
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withEnvVariable("GOMODCACHE", "/go/pkg/mod")
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withEnvVariable("GOCACHE", "/root/.cache/go-build")
      .withDirectory("/helpers/go-includes", currentModule.source.directory("helpers/go-includes"))
      .withExec(["go", "build", "-o", "/usr/local/bin/go-includes", "."])
      .withDirectory("/ws", ws.directory("/", include: ["**/*.go", "**/go.mod"]))
      .withWorkdir("/ws")
  }

  """
  Discovery output directory: include patterns and test directories for every
  module. For a given mode every module produces the same container and exec,
  so discovery runs once per workspace and each module reads only its own files.
  """
  let allIncludesDir(
    ws: Workspace!,
    test: Boolean!,
    generate: Boolean!,
  ): Directory! {
    let testFlags = if (test) { ["--test"] } else { [] }
    let generateFlags = if (generate) { ["--generate"] } else { [] }
    allIncludesHelper(ws)
      .withExec(["go-includes", "--all", "--output-dir", "/output"] + testFlags + generateFlags)
      .directory("/output")
  }

  """
  Additional workspace include patterns discovered by scanning Go directives
  and local go.mod replaces reachable from this module's include graph.
  With no include flags, defaults to test inputs.
  """
  includeDiscovered(
    ws: Workspace!,
    test: Boolean! = false,
    generate: Boolean! = false,
  ): [String!]! {
    allIncludesDir(ws, test: test, generate: generate)
      .file(outputStem + ".inc")
      .contents
      .split("\n")
      .filter { pattern => pattern != "" }
  }

  """
  File name stem of this module's entries in the discovery output directory.
  """
  let outputStem: String! {
    if (path == ".") { "_root_" } else { path }
  }

  """
  Directories in this module containing Go test files.
  """
  testDirectories(ws: Workspace!): [GoDirectory!]! {
    allIncludesDir(ws, test: true, generate: false)
      .file(outputStem + ".testdirs")
      .contents
      .split("\n")
      .filter { testPath => testPath != "" }
      .map { testPath => GoDirectory(path: testPath, ws: ws, module: self) }
  }

  """
  Built-in workspace include patterns for this module's own Go source files.
  """
  includeBase: [String!]! {
    [
      subpath("**/*.go"),
      subpath("**/*.c"),
      subpath("**/*.cc"),
      subpath("**/*.cpp"),
      subpath("**/*.cxx"),
      subpath("**/*.h"),
      subpath("**/*.hh"),
      subpath("**/*.hpp"),
      subpath("**/*.hxx"),
      subpath("**/*.s"),
      subpath("**/*.S"),
      subpath("**/*.syso"),
      subpath("go.mod"),
      subpath("go.sum"),
      subpath("go.work"),
      subpath("go.work.sum"),
    ]
  }

  """
  Final workspace include patterns used to build this module's source directory.
  With no include flags, defaults to test inputs.
  """
  include(
    ws: Workspace!,
    test: Boolean! = false,
    generate: Boolean! = false,
  ): [String!]! {
    includeExtraFiles + includeDiscovered(
      ws,
      test: test,
      generate: generate,
    )
  }

  """
  Workspace source mounted for this module's Go commands.
  With no include flags, defaults to test inputs.
  """
  source(
    ws: Workspace!,
    test: Boolean! = false,
    generate: Boolean! = false,
  ): Directory! {
    ws.directory(
      "/",
      include: include(ws, test: test, generate: generate),
    )
  }

  """
  Workspace testdata directories mounted while testing this module.
  """
  testData(ws: Workspace!): Directory! {
    ws.directory(
      "/",
      include: [
        subpath("testdata/**"),
        subpath("**/testdata/**"),
      ],
    )
  }

  """
  Base Go container before source files and commands are added.
  """
  base: Container! {
    prepareBase(baseImage)
  }

  let prepareBase(input: Container!): Container! {
    let ctr = input
      .withoutEntrypoint
      .withWorkdir(mountPath)
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withEnvVariable("GOMODCACHE", "/go/pkg/mod")
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withEnvVariable("GOCACHE", "/root/.cache/go-build")
    if (goflags == null) { ctr } else { ctr.withEnvVariable("GOFLAGS", goflags) }
  }

  """
  Run tests in this module.
  If this module is configured to skip tests, no tests are run.
  A failure names this module's path so it can be told apart from other
  modules tested in the same run.
  """
  test(ws: Workspace!): Void @check {
    let failure = testFailure(ws)
    if (failure != null) {
      raise "Go module " + path + ": " + failure
    }
    null
  }

  """
  Error message from running this module's tests, or null when they pass or
  this module is configured to skip tests.
  """
  let testFailure(ws: Workspace!): String {
    if (skipTest) {
      null
    } else {
      { testExec(ws).sync; null } rescue {
        err: Error => err.message
      }
    }
  }

  """
  Changes made by running go generate . in this module's selected directories.
  Returns an empty changeset if no directories are selected. Execution follows
  the ordering and container rules described by Go.generateAll.
  """
  generate(ws: Workspace!): Changeset! {
    if (skipGenerate(ws)) {
      directory.changes(directory)
    } else {
      let before = directory.withDirectory(
        path,
        source(ws, generate: true).directory(path),
      )
      let after = before.withDirectory(path, generateExec(ws).directory("."))
      after.changes(before)
    }
  }

  """
  Container state after running go generate in this module.
  """
  let generateExec(ws: Workspace!): Container! {
    let initial = base.withDirectory(".", source(ws, generate: true))
    let index = allIncludesDir(ws, test: false, generate: true)
    generateDirectories(ws).reduce(GoGeneration(container: initial, value: "")) { state, dir =>
      let value = index.file((if (dir == ".") { "_root_" } else { dir }) + ".generatecontainer").contents
      let ctr = if (value == state.value) {
        state.container
      } else {
        let selected = if (value == "") { base } else { prepareBase(ws.resolve(value).container) }
        selected.withDirectory(mountPath, state.container.directory(mountPath))
      }
      GoGeneration(
        value: value,
        container: ctr.withWorkdir(mountPath + "/" + dir)
          .withExec(["go", "generate", "."], experimentalPrivilegedNesting: true),
      )
    }.container.withWorkdir(mountPath + "/" + path)
  }

  """
  Test container with this module's sources, testdata, and otelgotest in
  place, before any test command runs.
  """
  let testEnv(ws: Workspace!): Container! {
    base
      .withExec(["go", "install", "github.com/dagger/otel-go/cmd/otelgotest@main"])
      .withDirectory(".", source(ws, test: true))
      .withDirectory(".", testData(ws))
      # Nested Dagger clients find the workspace boundary by walking up to .git.
      .withNewFile(".git/HEAD", "ref: refs/heads/main\n")
  }

  """
  Container that has run this module's tests.
  """
  let testExec(ws: Workspace!): Container! {
    testEnv(ws)
      .withWorkdir(path)
      .withExec(["otelgotest", "./..."], experimentalPrivilegedNesting: true)
  }
}

"""
A workspace directory containing Go test files.
"""
type GoDirectory {
  """
  Workspace-relative path of this directory.
  """
  path: String!

  """
  Workspace containing this directory.
  """
  let ws: Workspace!

  """
  Go module containing this directory.
  """
  module: GoModule!

  """
  Container that has run the Go tests in this directory.
  """
  let testExec: Container! {
    module
      .testEnv(ws)
      .withWorkdir(path)
      .withExec(["otelgotest"], experimentalPrivilegedNesting: true)
  }

  """
  Run Go tests in this directory.
  If the containing module is configured to skip tests, no tests are run.
  A failure names this directory's path.
  """
  execute: Void @check {
    if (module.skipTest == false) {
      testExec.sync rescue {
        err: Error => raise "Go tests in " + path + ": " + err.message
      }
    }
    null
  }
}

# Carry workspace files across changes in the generation container.
type GoGeneration {
  let container: Container!
  let value: String!
}
