"""
Test, build and run go generate on Go modules across a workspace.

For lint checks, use github.com/dagger/go/golangci-lint or
github.com/dagger/go/staticcheck.
"""
type Go {
  """
  Go version for every module. Null uses each module's go.mod.
  """
  version: String

  """
  Custom base image for Go containers, if set.
  """
  base: Container

  new(
    """
    Go version for every module, overriding go.mod. Ignored when base is set.
    """
    version: String = null,
    """
    Base image for Go containers. Must include a Go toolchain.
    """
    base: Container = null,
    """
    Extra workspace files to mount for Go commands, as include patterns.
    """
    includeExtraFiles: [String!]! = [],
    """
    Module roots to test, e.g. ["**", "!docs"]. "!" excludes.
    """
    test: [String!]! = ["**"],
    """
    Directories to run go generate in, as workspace-root globs. "!" excludes.
    """
    generate: [String!]! = ["**"],
    """
    Main packages to build, by module-relative or workspace path. "!" excludes.
    """
    build: [String!]! = ["**"],
    """
    Extra flags for go build only, e.g. ["-trimpath", "-ldflags=-s -w"].
    """
    buildFlags: [String!]! = [],
    """
    GOFLAGS for every Go container, e.g. "-tags=extended".
    """
    goflags: String = null,
    """
    Where to mount the workspace in Go containers. Defaults to "/src/<workspace name>".
    """
    mountPath: String = null,
  ) {
    if ((mountPath ?? "/").hasPrefix("/") == false) {
      raise "mountPath must be an absolute container path: " + (mountPath ?? "")
    } else {
      self.warnings = if (version != null and base != null) {
        [
          "version \"" + version
            + "\" is ignored because base was set: the base image supplies its own Go toolchain",
        ]
      } else {
        []
      }
      self.version = if (base == null) { version } else { null }
      self.base = base
      self.includeExtraFiles = includeExtraFiles
      self.test = test
      self.generate = generate
      self.build = build
      self.buildFlags = buildFlags
      self.goflags = goflags
      self.mountPath = mountPath
      self
    }
  }

  """
  Settings that were given but are ignored.
  """
  warnings: [String!]! = []

  """
  Extra workspace files mounted for Go commands, as include patterns.
  """
  includeExtraFiles: [String!]! = []

  """
  Module roots to test. "!" excludes.
  """
  test: [String!]! = ["**"]

  """
  Directories to run go generate in. "!" excludes.
  """
  generate: [String!]! = ["**"]

  """
  Main packages to build, by module-relative or workspace path. "!" excludes.
  """
  build: [String!]! = ["**"]

  """
  Extra flags for go build only.
  """
  buildFlags: [String!]! = []

  """
  GOFLAGS for every Go container.
  """
  goflags: String

  """
  Configured workspace mount path. Null uses "/src/<workspace name>", or
  "/src" for a workspace made from a directory or git ref.
  """
  mountPath: String

  """
  Container path where the workspace is mounted for Go commands: the
  configured mountPath, or "/src/<workspace name>".

  A workspace made with asWorkspace has no name: its address is its content
  digest or commit. Named after that, the mount path would change with every
  edit, and with it every package's compile, so it is "/src".
  """
  let workspaceMountPath(ws: Workspace!): String! {
    let synthetic = ws.address.hasPrefix("directory://") or ws.address.hasPrefix("git-ref://")
    let derived = if (synthetic) { "/src" } else { "/src/" + workspaceName(ws) }
    mountPath ?? derived
  }

  """
  Last segment of the workspace root address, usually the repository name.
  """
  let workspaceName(ws: Workspace!): String! {
    # The canonical address spans the cwd and, for a git workspace, ends with
    # a version selector: "file:///home/me/hugo/docs" and
    # "github.com/org/hugo/docs@main" both have cwd "/docs". Drop the selector
    # first, then the cwd, then take what is left. The selector pattern stops
    # at "/" and ":" so an ssh user ("ssh://git@github.com/...") is untouched.
    let cwd = ws.cwd.trimSuffix("/")
    let location = ws.address.replaceMatches(`@[^/:@]*$`, with: "").trimSuffix("/")
    let root = if (cwd != "" and location.hasSuffix(cwd)) {
      location.trimSuffix(cwd)
    } else {
      location
    }
    root
      .split("/")
      .filter { segment => segment != "" }
      .takeLast(1)
      .join("")
      .trimSuffix(".git")
  }

  """
  The shared library every Go tool in this repository discovers modules and
  mounts source through, so `go`, `golangci-lint` and `staticcheck` agree on
  what a module is and what one needs.
  """
  let lib: Gomod! { gomod(includeExtraFiles: includeExtraFiles) }

  # The scan's package discovery, which gomod's scanner writes in its one pass
  # over every Go file (go-includes, discovery.go): a "module" line per Go
  # module, then a "package" line per package directory with something to do.
  # Reading it replaces a search, glob or field read per result.
  let discoveryLines(ws: Workspace!): [String!]! {
    lib.scan(ws).file("_discovery_").contents.split("\n").filter { line => line != "" }
  }

  # Field n of a tab-separated discovery line; field 0 is its kind.
  let lineField(line: String!, n: Int!): String! {
    line.split("\t").takeFirst(n + 1).takeLast(1).join("")
  }

  # Whether a package line's kinds hold one kind: "t", "m" or "g".
  let hasKind(kinds: String!, kind: String!): Boolean! {
    kinds.split("").contains(kind)
  }

  # The workspace path of a module-relative directory.
  let pathIn(root: String!, dir: String!): String! {
    if (dir == ".") { root } else if (root == ".") { dir } else { root + "/" + dir }
  }

  # Workspace paths of the Go modules at or below the working directory, and of
  # the module the working directory is inside.
  let moduleRootsHere(ws: Workspace!): [String!]! {
    let cwd = ws.cwd.trimPrefix("/").trimSuffix("/")
    let roots = discoveryLines(ws).filter { line => line.hasPrefix("module\t") }.map { line => lineField(line, 1) }
    if (cwd == "" or cwd == ".") {
      roots
    } else {
      let below = roots.filter { root => root == cwd or root.hasPrefix(cwd + "/") }
      # The nearest module at or above the working directory, as findUp finds
      # its go.mod: the working directory's own when it is a module root.
      let enclosing = roots
        .filter { root => root == "." or root == cwd or cwd.hasPrefix(root + "/") }
        .reduce("") { inner, root =>
          if (inner == "" or rootDepth(root) > rootDepth(inner)) { root } else { inner }
        }
      if (enclosing == "") { below } else { ([enclosing] + below).uniq }
    }
  }

  # How deep a module root is below the workspace root: "." is 0.
  let rootDepth(root: String!): Int! {
    if (root == ".") { 0 } else { root.split("/").length }
  }

  # The root of the Go module holding a workspace path: the innermost one.
  let moduleRootOf(ws: Workspace!, pkgPath: String!): String! {
    let roots = discoveryLines(ws)
      .filter { line => line.hasPrefix("module\t") }
      .map { line => lineField(line, 1) }
      .filter { root => root == "." or pkgPath == root or pkgPath.hasPrefix(root + "/") }
    if (roots.length == 0) {
      raise "no Go module found containing path: " + pkgPath
    } else {
      roots.reduce(".") { inner, root =>
        if (root != "." and (inner == "." or root.split("/").length > inner.split("/").length)) { root } else { inner }
      }
    }
  }

  # Whether a workspace path is selected by patterns, as gomod's GoMod.selected
  # decides it: a pattern selects its path and everything under it, "**" and
  # "*" select everything, "!" excludes, and no selecting pattern selects all.
  let selectedBy(at: String!, patterns: [String!]!): Boolean! {
    let selecting = patterns.filter { p => p.hasPrefix("!") == false }
    let excluding = patterns.filter { p => p.hasPrefix("!") }.map { p => p.trimPrefix("!") }
    (selecting.length == 0 or selecting.any { p => pathMatches(at, p) })
      and excluding.any { p => pathMatches(at, p) } == false
  }

  let pathMatches(at: String!, pattern: String!): Boolean! {
    let trimmed = pattern.trimPrefix("/").trimSuffix("/")
    if (trimmed == "**" or trimmed == "*") {
      true
    } else {
      let prefix = trimmed.trimSuffix("/**")
      at == prefix or at.hasPrefix(prefix + "/")
    }
  }

  # Whether the build setting selects a main package, by its module-relative
  # directory or its workspace path, as GoModule.buildSelected decides it.
  let buildSelected(root: String!, dir: String!): Boolean! {
    let paths = [dir, pathIn(root, dir)]
    let selecting = build.filter { p => p.hasPrefix("!") == false }
    let excluding = build.filter { p => p.hasPrefix("!") }
    (selecting.length == 0 or selecting.any { p => paths.any { at => selectedBy(at, [p]) } })
      and excluding.any { p => paths.any { at => selectedBy(at, [p]) == false } } == false
  }

  # Workspace directories holding Go files that patterns match, in Dagger's own
  # glob syntax, as the generate setting is matched.
  let matchingDirectories(ws: Workspace!, patterns: [String!]!): [String!]! {
    let empty: [String!]! = []
    patterns.reduce(empty) { dirs, pattern =>
      dirs + ws
        .glob(pattern.trimSuffix("/") + "/*.go")
        .filter { file => file.hasSuffix("/") == false }
        .map { file =>
          let dir = file.split("/").dropLast(1).join("/")
          if (dir == "") { "." } else { dir }
        }
    }
  }

  # Workspace paths of the packages with something to do: tests to run in a
  # module the test setting selects, a main package the build setting selects,
  # or go:generate commands the generate setting selects.
  let packageKeys(ws: Workspace!): [String!]! {
    let empty: [String!]! = []
    let roots = moduleRootsHere(ws)
    let generateAll = generate.length == 1 and generate.contains("**")
    let included = generate.filter { p => p.hasPrefix("!") == false }
    let excluded = generate.filter { p => p.hasPrefix("!") }.map { p => p.trimPrefix("!") }
    let includeDirs = if (generateAll) { empty } else { matchingDirectories(ws, included) }
    let excludeDirs = if (generateAll) { empty } else { matchingDirectories(ws, excluded) }
    discoveryLines(ws)
      .filter { line => line.hasPrefix("package\t") and roots.contains(lineField(line, 1)) }
      .filter { line =>
        let root = lineField(line, 1)
        let dir = lineField(line, 2)
        let kinds = lineField(line, 3)
        let key = pathIn(root, dir)
        (hasKind(kinds, "t") and selectedBy(root, test))
          or (hasKind(kinds, "m") and buildSelected(root, dir))
          or (hasKind(kinds, "g") and (generateAll or ((included.length == 0 or includeDirs.contains(key)) and excludeDirs.contains(key) == false)))
      }
      .map { line => pathIn(lineField(line, 1), lineField(line, 2)) }
      .uniq
  }

  """
  Go modules at or below the working directory.
  """
  modules(
    ws: Workspace!,
    include: [String!]! = [],
    exclude: [String!]! = [],
    includeSkipTest: Boolean! = true,
    includeSkipGenerate: Boolean! = true,
  ): [GoModule!]! {
    # A list rather than a collection: modules decide how a package is mounted
    # and which toolchain it gets, but they are not something to select.
    let roots = if (include.length == 0 and exclude.length == 0) {
      moduleRootsHere(ws)
    } else {
      moduleRootsHere(ws).filter { root => lib.pathIncluded(ws, root, include, exclude) }
    }
    roots
      .map { root => goModule(ws, root) }
      .filter { mod =>
        (includeSkipTest or mod.skipTest == false)
          and (includeSkipGenerate or mod.skipGenerate(ws) == false)
      }
  }

  """
  Go packages at or below the working directory, keyed by directory.
  """
  packages(ws: Workspace!): GoPackages! {
    GoPackages(
      paths: sorted(packageKeys(ws)),
      mountPath: workspaceMountPath(ws),
      tool: self,
    )
  }

  # The module holding a package. A package holds no module of its own, so
  # that the collection needs no workspace.
  let packageModule(ws: Workspace!, pkgPath: String!, mount: String!): GoModule! {
    goModuleAt(moduleRootOf(ws, pkgPath), mount)
  }

  # Byte-order sort, as Go's sort.Strings: a merge sort, n log n comparisons.
  let sorted(items: [String!]!): [String!]! {
    if (items.length < 2) {
      items
    } else {
      let half = items.length / 2
      mergeSorted(sorted(items.takeFirst(half)), sorted(items.dropFirst(half)))
    }
  }

  # Merges two byte-ordered lists into one.
  let mergeSorted(a: [String!]!, b: [String!]!): [String!]! {
    let i = 0
    let j = 0
    (a + b).map { unused =>
      if (j == b.length or (i < a.length and a[i]! <= b[j]!)) {
        let item = a[i]!
        i += 1
        item
      } else {
        let item = b[j]!
        j += 1
        item
      }
    }
  }

  """
  The Go module containing a workspace path.
  """
  module(ws: Workspace!, path: String!, findUp: Boolean! = true): GoModule! {
    goModule(ws, lib.module(ws, path, findUp: findUp).path)
  }

  let goModule(ws: Workspace!, modPath: String!): GoModule! {
    goModuleAt(modPath, workspaceMountPath(ws))
  }

  # files is the module's Go files when the caller already has them, as
  # Gomod.modules returns them, and null otherwise.
  let goModuleAt(modPath: String!, mount: String!): GoModule! {
    GoModule(
      path: modPath,
      configuredVersion: version,
      warnings: warnings,
      baseImage: base,
      includeExtraFiles: includeExtraFiles,
      testPatterns: test,
      generatePatterns: generate,
      buildPatterns: build,
      buildFlags: buildFlags,
      goflags: goflags,
      mountPath: mount,
    )
  }
}

# Keep all Dang types in one source file until Dagger v0.21.x can
# convert Workspace arguments for installed multi-file Dang toolchains.
# See dagger/dagger#13476.

"""
Go packages in a workspace, keyed by directory.
"""
type GoPackages @collection {
  """
  Package directories, relative to the workspace.
  """
  paths: [String!]! @keys

  # Held instead of the workspace, which would stop the collection caching.
  let mountPath: String!

  let tool: Go!

  """
  The package in this directory.
  """
  package(path: String!): GoPackage! @get {
    GoPackage(path: path, mountPath: mountPath, tool: tool)
  }

  # The modules holding the selected packages, each once.
  let modules(ws: Workspace!): [GoModule!]! {
    paths
      .map { p => tool.moduleRootOf(ws, p) }
      .uniq
      .map { modPath => tool.goModuleAt(modPath, mountPath) }
  }

  # The selected packages in one module.
  let inModule(ws: Workspace!, mod: GoModule!): [String!]! {
    paths.filter { p => tool.moduleRootOf(ws, p) == mod.path }
  }

  """
  Binaries of the selected main packages for the engine's platform, one file
  each.
  """
  binary(ws: Workspace!): Directory! {
    let mods = modules(ws)
    let empty: [String!]! = []
    let mains = mods.reduce(empty) { all, mod =>
      all + mod.mainPackages(ws, inModule(
        ws,
        mod,
      ))
    }
    let names = mains.map { p => hostName(ws, p) }
    let clashes = mains.filter { p =>
      let name = hostName(ws, p)
      names.filter { other => other == name }.length > 1
    }
    if (clashes.length > 0) {
      raise "Go packages build binaries with the same name: " + clashes.map { p =>
        p + " builds " + hostName(ws, p)
      }.join(", ")
    }
    # One go build per module, merged into one directory.
    mods.reduce(directory) { out, mod =>
      out.withDirectory(
        ".",
        mod.binaryFiles(ws, gomod.hostPlatform, inModule(ws, mod)),
      )
    }
  }

  let hostName(ws: Workspace!, pkgPath: String!): String! {
    tool.packageModule(ws, pkgPath, mountPath).binaryFileName(ws, pkgPath, gomod.hostPlatform)
  }

  """
  Run go generate in the selected packages.
  """
  generate(ws: Workspace!): Changeset! @generate {
    # Packages run together per module, in lexical order, each seeing the
    # output of the ones before it: with every package selected, this is
    # go generate ./... for that module.
    let mods = modules(ws).filter { mod =>
      mod.skipGenerate(ws) == false and mod.generateDirsIn(ws, inModule(ws, mod)).length > 0
    }
    let before = mods.reduce(directory) { before, mod =>
      before.withDirectory(mod.path, mod.generateSource(ws))
    }
    let after = mods.reduce(before) { after, mod =>
      after.withDirectory(
        mod.path,
        mod.generatedTree(ws, mod.generateDirsIn(ws, inModule(ws, mod))),
      )
    }
    after.changes(before)
  }
}

"""
A Go package.
"""
type GoPackage {
  """
  Package directory, relative to the workspace.
  """
  path: String!

  let mountPath: String!

  let tool: Go!

  let module(ws: Workspace!): GoModule! {
    tool.packageModule(ws, path, mountPath)
  }

  """
  Tests in this package, keyed by name.
  """
  tests(ws: Workspace!): GoTests! {
    let mod = module(ws)
    let dir = mod.relativeDir(path)
    GoTests(names: mod.testNames(ws, dir), directory: dir, module: mod)
  }

  """
  This package's binary for the engine's platform. It must be a main package.
  """
  binary(ws: Workspace!): File! {
    module(ws).binaryFile(ws, gomod.hostPlatform, path)
  }

  """
  This package's test binary for the engine's platform, as go test -c builds
  it. The package must have test files.

  Unlike go test -c, it does not run go vet on the package: vet is left to
  the lint checks, such as golangci-lint's.
  """
  testBinary(ws: Workspace!): File! {
    module(ws).testBinaryFile(ws, gomod.hostPlatform, path)
  }

  """
  Platforms this package can be built for, keyed by GOOS/GOARCH.
  """
  platforms: GoPlatforms! {
    GoPlatforms(names: gomod.goPlatforms, path: path, mountPath: mountPath, tool: tool)
  }

  """
  Run go generate in this package.
  """
  generate(ws: Workspace!): Changeset! @generate {
    let mod = module(ws)
    let failure = mod.scanFailure(ws)
    if (failure != null) {
      raise failure
    }
    let dirs = mod.generateDirsIn(ws, [path])
    if (dirs.length == 0) {
      directory.changes(directory)
    } else {
      let before = directory.withDirectory(mod.path, mod.generateSource(ws))
      let after = before.withDirectory(mod.path, mod.generatedTree(ws, dirs))
      after.changes(before)
    }
  }
}

"""
Platforms a Go package can be built for, keyed by GOOS/GOARCH.
"""
type GoPlatforms @collection {
  """
  GOOS/GOARCH pairs, e.g. "linux/arm64".
  """
  names: [String!]! @keys

  """
  Platforms selected in or out since the collection was discovered.
  """
  delta: CollectionDelta

  let path: String!
  let mountPath: String!
  let tool: Go!

  """
  The platform with this GOOS/GOARCH.
  """
  platform(name: String!): GoPlatform! @get {
    GoPlatform(name: name, path: path, mountPath: mountPath, tool: tool)
  }

  # The platforms a batch builds for. Every platform Go supports is a key, and
  # naming none selects them all, so an unnarrowed collection means no
  # platform was asked for: the batch then builds for the engine's own.
  # Without a delta, the keys are taken as asked for.
  let targets: [String!]! {
    let whole = if (delta == null) {
      false
    } else {
      delta.addedKeys.length == 0 and delta.removedKeys.length == 0
    }
    if (whole) { names.filter { name => name == gomod.hostPlatform } } else { names }
  }

  """
  This package's binary for the selected platforms, or the engine's when none
  is, one directory per platform, e.g. "linux-arm64/".
  """
  binary(ws: Workspace!): Directory! {
    let mod = tool.packageModule(ws, path, mountPath)
    targets.reduce(directory) { out, target =>
      out.withFile(
        target.split("/").join("-") + "/" + mod.binaryFileName(ws, path, target),
        mod.binaryFile(ws, target, path),
      )
    }
  }
}

"""
A platform a Go package can be built for.
"""
type GoPlatform {
  """
  GOOS/GOARCH, e.g. "linux/arm64".
  """
  name: String!

  let path: String!
  let mountPath: String!
  let tool: Go!

  """
  This package's binary for this platform.
  """
  binary(ws: Workspace!): File! {
    tool.packageModule(ws, path, mountPath).binaryFile(ws, name, path)
  }

  """
  This package's test binary for this platform, as go test -c builds it,
  but without go vet, which is left to the lint checks.
  """
  testBinary(ws: Workspace!): File! {
    tool.packageModule(ws, path, mountPath).testBinaryFile(ws, name, path)
  }
}

"""
A Go module rooted at a workspace-relative path.
"""
type GoModule {
  """
  Module root, relative to the workspace.
  """
  path: String!

  let configuredVersion: String
  let warnings: [String!]!

  """
  Base image used by this module's Go containers, as supplied by the caller.
  """
  let baseImage: Container

  """
  Extra workspace files mounted for Go commands, as include patterns.
  """
  includeExtraFiles: [String!]!

  """
  Gitignore-style globs selecting which module roots to test.
  """
  let testPatterns: [String!]!

  """
  Workspace-root-relative globs selecting directories to run go generate in.
  """
  let generatePatterns: [String!]!

  """
  Globs selecting which main packages to build, by module-relative or
  workspace path.
  """
  let buildPatterns: [String!]!

  """
  Extra flags for go build, after the build subcommand and before the packages.
  """
  let buildFlags: [String!]!

  """
  Value of the GOFLAGS environment variable in this module's Go containers.
  """
  let goflags: String

  """
  Where the workspace is mounted in Go containers.
  """
  mountPath: String!

  """
  The shared library, which answers discovery, selection and source policy for
  this module, so `go` mounts what `golangci-lint` and `staticcheck` mount.

  Its module object is re-derived at each call site rather than held as a
  field: Dang cannot yet name a dependency's non-root type, which is also why
  the GoModule type here is this module's own rather than the library's.
  """
  let lib: Gomod! { gomod(includeExtraFiles: includeExtraFiles) }

  """
  Whether tests are skipped for this module.
  """
  skipTest: Boolean! {
    rootSelected(normalized(path), testPatterns) == false
  }

  """
  Why this module could not be scanned, or null.
  """
  scanFailure(ws: Workspace!): String {
    lib.at(path).scanError(ws, generate: true)
  }

  """
  Whether go generate has nothing to run in this module.
  """
  skipGenerate(ws: Workspace!): Boolean! {
    if (scanFailure(ws) != null) {
      true
    } else {
      generateDirectories(ws).length == 0
    }
  }

  """
  Whether this module has go:generate commands, regardless of selection.
  """
  hasGenerateDirectives(ws: Workspace!): Boolean! {
    if (scanFailure(ws) != null) {
      false
    } else {
      discoveredGenerateDirectories(ws).length > 0
    }
  }

  """
  Directories go generate runs in, in lexical order.
  """
  generateDirectories(ws: Workspace!): [String!]! {
    selectGenerate(ws, discoveredGenerateDirectories(ws))
  }

  # The workspace directories among dirs that the generate setting selects.
  let selectGenerate(ws: Workspace!, dirs: [String!]!): [String!]! {
    let included = generatePatterns.filter { p => p.hasPrefix("!") == false }
    let excluded = generatePatterns.filter { p => p.hasPrefix("!") }.map { p => p.trimPrefix("!") }
    let includeDirs = matchingGenerateDirectories(ws, included)
    let excludeDirs = matchingGenerateDirectories(ws, excluded)
    dirs.filter { dir =>
      (included.length == 0 or includeDirs.any { match => match == dir })
        and excludeDirs.any { match => match == dir } == false
    }
  }

  # Match direct Go files to include the workspace root and avoid treating a
  # literal directory as recursive. Glob syntax is entirely Dagger's.
  let matchingGenerateDirectories(ws: Workspace!, patterns: [String!]!): [String!]! {
    let empty: [String!]! = []
    patterns.reduce(empty) { dirs, pattern =>
      dirs + ws
        .glob(pattern.trimSuffix("/") + "/*.go")
        .filter { file => file.hasSuffix("/") == false }
        .map { file =>
          let dir = file.split("/").dropLast(1).join("/")
          if (dir == "") { "." } else { dir }
        }
    }
  }

  let discoveredGenerateDirectories(ws: Workspace!): [String!]! {
    lib.at(path).generateDirectories(ws)
  }

  """
  Include patterns found by scanning Go directives and local replaces.
  """
  includeDiscovered(
    ws: Workspace!,
    test: Boolean! = false,
    generate: Boolean! = false,
  ): [String!]! {
    lib.at(path).includeDiscovered(ws, test: test, generate: generate)
  }

  """
  Built-in include patterns for this module's Go files.
  """
  includeBase: [String!]! {
    lib.at(path).includeBase
  }

  """
  All include patterns for this module's source.
  """
  include(
    ws: Workspace!,
    test: Boolean! = false,
    generate: Boolean! = false,
  ): [String!]! {
    lib.at(path).include(ws, test: test, generate: generate)
  }

  """
  Source mounted for this module's Go commands.
  """
  source(
    ws: Workspace!,
    test: Boolean! = false,
    generate: Boolean! = false,
  ): Directory! {
    lib.at(path).source(ws, test: test, generate: generate)
  }

  """
  Testdata directories mounted for this module's tests.
  """
  testData(ws: Workspace!): Directory! {
    lib.at(path).testData(ws)
  }

  """
  Go version this module runs under. Null with a custom base.
  """
  version(ws: Workspace!): String {
    if (baseImage == null) { toolchainVersion(ws) } else { null }
  }

  let toolchainVersion(ws: Workspace!): String! {
    configuredVersion ?? discoveredVersion(ws) ?? gomod.defaultGoVersion
  }

  # The Go version this module's go.mod declares, as the scan reports it.
  let discoveredVersion(ws: Workspace!): String {
    let declared = moduleField(ws, 3)
    if (declared == "") { null } else { declared }
  }

  # The scan's package discovery: see Go.discoveryLines.
  let discoveryLines(ws: Workspace!): [String!]! {
    lib.scan(ws).file("_discovery_").contents.split("\n").filter { line => line != "" }
  }

  # Field n of this module's discovery line: 2 for its module path, 3 for its
  # Go version.
  let moduleField(ws: Workspace!, n: Int!): String! {
    discoveryLines(ws)
      .filter { line => line.hasPrefix("module\t" + path + "\t") }
      .map { line => line.split("\t").takeFirst(n + 1).takeLast(1).join("") }
      .takeFirst(1)
      .join("")
  }

  """
  Go container for this module, before source is added.
  """
  base(ws: Workspace!): Container! {
    prepareBase(
      if (baseImage == null) {
        gomod.goContainer(toolchainVersion(ws))
      } else {
        gomod.withGoCaches(baseImage.withoutEntrypoint)
      },
    )
  }

  """
  A cache-mounted Go container made ready for this module's commands: the
  workspace mount path as workdir, GOFLAGS when configured, and any ignored
  settings announced.

  Taken as an argument rather than built here, because a generate directory
  may name its own container and it has to be prepared the same way.
  """
  let prepareBase(cached: Container!): Container! {
    let ctr = gomod.withWarnings(cached, warnings).withWorkdir(mountPath)
    if (goflags == null) { ctr } else { ctr.withEnvVariable("GOFLAGS", goflags) }
  }

  # A workspace path inside this module, made module-relative.
  let relativeDir(pkgPath: String!): String! {
    if (pkgPath == path) {
      "."
    } else if (path == ".") {
      pkgPath
    } else {
      pkgPath.trimPrefix(path + "/")
    }
  }

  # Test, fuzz and example names in one package directory, found by searching
  # the source rather than asking go test, and without the scanner, so listing
  # them runs no container. Build constraints are not evaluated: a test
  # excluded by one is still listed, and selecting it runs nothing. Files are
  # taken in byte order, so the keys, and the -run pattern built from them, are
  # stable.
  let testNames(ws: Workspace!, dir: String!): [String!]! {
    let empty: [String!]! = []
    # Only the package's own directory is listed: a package is never a nested
    # module's root or under testdata, so its files are all this module's.
    let pkgPath = packagePath(dir)
    let files = if (skipTest) {
      empty
    } else {
      sorted(
        ws
          .glob(if (pkgPath == ".") { "*_test.go" } else { pkgPath + "/*_test.go" })
          .filter { file => file.hasSuffix("/") == false }
          .map { file => file.trimPrefix("/").trimPrefix("./") },
      )
    }
    if (files.length == 0) {
      empty
    } else {
      # One search over the module tree, matched back to the package's files
      # below. The search is the same for every package, so it runs once.
      # Searching a subdirectory or the files by name would be narrower, but
      # fails on a workspace built with withDirectory.
      let matches = testMatches(ws)
      files
        .reduce(empty) { names, file =>
          names + matches
            .filter { match => match.filePath.trimPrefix("/").trimPrefix("./") == file }
            .map { match =>
              match.matchedLines.trimPrefix("func ").split("(").takeFirst(1).join("")
            }
        }
        .uniq
    }
  }

  # Test, fuzz and example function lines in this module's tree.
  let testMatches(ws: Workspace!): [{{filePath: String!, matchedLines: String!}}!]! {
    ws.search(
      paths: [if (path == ".") { "/" } else { "/" + path }],
      globs: ["*_test.go"],
      pattern: testFunctionPattern,
    ).{{filePath, matchedLines}}
  }

  # A test, fuzz or example function declaration.
  let testFunctionPattern: String! {
    `^func (Test([^a-z(]\w*)?\(\s*\w+\s+\*testing\.T\s*\)|Fuzz([^a-z(]\w*)?\(\s*\w+\s+\*testing\.F\s*\)|Example([^a-z(]\w*)?\(\s*\))`
  }

  # Byte-order sort, as Go's sort.Strings: a merge sort, n log n comparisons.
  let sorted(items: [String!]!): [String!]! {
    if (items.length < 2) {
      items
    } else {
      let half = items.length / 2
      mergeSorted(sorted(items.takeFirst(half)), sorted(items.dropFirst(half)))
    }
  }

  # Merges two byte-ordered lists into one.
  let mergeSorted(a: [String!]!, b: [String!]!): [String!]! {
    let i = 0
    let j = 0
    (a + b).map { unused =>
      if (j == b.length or (i < a.length and a[i]! <= b[j]!)) {
        let item = a[i]!
        i += 1
        item
      } else {
        let item = b[j]!
        j += 1
        item
      }
    }
  }

  # The workspace path of a package directory in this module.
  let packagePath(dir: String!): String! {
    if (dir == ".") { path } else { subpathOf(normalized(path), dir) }
  }

  # GoMod.subpath, GoMod.selected and Gomod.normalize, in process. Through gomod
  # each is a module call, with the fixed per-call cost of one, for a few string
  # operations; discovery makes one for every package directory.
  let subpathOf(root: String!, relativePath: String!): String! {
    if (root == ".") { relativePath } else { root.trimSuffix("/") + "/" + relativePath }
  }

  let normalized(p: String!): String! {
    let segments = p.split("/").filter { segment => segment != "" and segment != "." }
    if (segments.length == 0) { "." } else { segments.join("/") }
  }

  let rootSelected(root: String!, patterns: [String!]!): Boolean! {
    let selecting = patterns.filter { pattern => pattern.hasPrefix("!") == false }
    let excluding = patterns
      .filter { pattern => pattern.hasPrefix("!") }
      .map { pattern => pattern.trimPrefix("!") }
    (selecting.length == 0 or selecting.any { pattern => rootMatches(root, pattern) })
      and excluding.any { pattern => rootMatches(root, pattern) } == false
  }

  let rootMatches(root: String!, pattern: String!): Boolean! {
    let trimmed = pattern.trimPrefix("/").trimSuffix("/")
    if (trimmed == "**" or trimmed == "*") {
      true
    } else {
      let prefix = trimmed.trimSuffix("/**")
      root == prefix or root.hasPrefix(prefix + "/")
    }
  }

  """
  Run tests in this module.
  """
  test(ws: Workspace!): Void {
    let failure = testFailure(ws)
    if (failure != null) {
      raise "Go module " + path + ": " + failure
    }
    null
  }

  """
  Error message from running this module's tests, or null when they pass or
  this module is configured to skip tests.
  """
  let testFailure(ws: Workspace!): String {
    if (skipTest) {
      null
    } else {
      { testExec(ws).sync; null } rescue {
        err: Error => err.message
      }
    }
  }

  """
  Run go generate in this module.
  """
  generate(ws: Workspace!): Changeset! {
    let failure = scanFailure(ws)
    if (failure != null) {
      raise failure
    } else if (skipGenerate(ws)) {
      directory.changes(directory)
    } else {
      let before = directory.withDirectory(path, generateSource(ws))
      let after = before.withDirectory(path, generatedTree(ws, generateDirectories(ws)))
      after.changes(before)
    }
  }

  # The generate directories among the given workspace package paths, in
  # lexical order.
  let generateDirsIn(ws: Workspace!, pkgPaths: [String!]!): [String!]! {
    generateDirectories(ws).filter { dir => pkgPaths.contains(dir) }
  }

  # This module's tree as its generate container receives it.
  let generateSource(ws: Workspace!): Directory! {
    source(ws, generate: true).directory(path)
  }

  # This module's tree after go generate has run in dirs, in order.
  let generatedTree(ws: Workspace!, dirs: [String!]!): Directory! {
    generateExec(ws, dirs).directory(".")
  }

  """
  Container state after running go generate in dirs, in order, each seeing the
  output of the ones before it.
  """
  let generateExec(ws: Workspace!, dirs: [String!]!): Container! {
    let initial = base(ws).withDirectory(".", source(ws, generate: true))
    dirs.reduce(GoGeneration(container: initial, value: "")) { state, dir =>
      let value = lib.at(path).generateContainer(ws, dir)
      let ctr = if (value == state.value) {
        state.container
      } else {
        let selected = if (value == "") {
          base(ws)
        } else {
          prepareBase(
            gomod.withGoCaches(ws.resolve(value).container.withoutEntrypoint),
          )
        }
        selected.withDirectory(mountPath, state.container.directory(mountPath))
      }
      GoGeneration(
        value: value,
        container: ctr
          .withWorkdir(mountPath + "/" + dir)
          .withExec(["go", "generate", "."], experimentalPrivilegedNesting: true),
      )
    }.container.withWorkdir(mountPath + "/" + path)
  }

  """
  The otelgotest binary the tests are run with, when the container does not
  already carry one.

  Built in a pinned Go container rather than in the module's own, so a module
  pinned to an older toolchain still gets it, and so the build happens once for
  the whole workspace instead of once per module.
  """
  let testRunner: File! {
    gomod
      .toolBuilder
      .withEnvVariable("GOBIN", "/usr/local/bin")
      .withExec(["go", "install", "github.com/dagger/otel-go/cmd/otelgotest@main"])
      .file("/usr/local/bin/otelgotest")
  }

  """
  Test container with this module's sources, testdata, and otelgotest in
  place, before any test command runs.
  """
  let testEnv(ws: Workspace!): Container! {
    gomod
      .withTool(base(ws), "otelgotest", testRunner)
      .withDirectory(".", source(ws, test: true))
      .withDirectory(".", testData(ws))
      # Nested Dagger clients find the workspace boundary by walking up to .git.
      .withNewFile(".git/HEAD", "ref: refs/heads/main\n")
  }

  """
  Container that has run this module's tests.
  """
  let testExec(ws: Workspace!): Container! {
    testEnv(ws)
      .withWorkdir(path)
      .withExec(["otelgotest", "./..."], experimentalPrivilegedNesting: true)
  }

  """
  Run the named tests in one package, or all of them when names is empty,
  naming the package when they fail.
  """
  let runTests(ws: Workspace!, dir: String!, names: [String!]!): Void {
    let run = if (names.length == 0) { [] } else { ["-run", "^(" + names.join("|") + ")$"] }
    testEnv(ws)
      .withWorkdir(path)
      .withExec(["otelgotest"] + run + [packageArg(dir)], experimentalPrivilegedNesting: true)
      .sync rescue {
      err: Error => raise "Go tests in " + packagePath(dir) + ": " + err.message
    }
    null
  }

  # Main packages are found by searching the source, like test names, so
  # listing them runs no container. A directory is one when one of its own
  # non-test files says "package main" without an ignore build tag, which is
  # how go:generate scripts are kept out of the build. Other build constraints
  # are not evaluated: the build reports what the search got wrong.
  let binaryPackages(ws: Workspace!): [String!]! {
    discoveryLines(ws)
      .filter { line =>
        line.hasPrefix("package\t" + path + "\t") and line.split("\t").takeLast(1).join("").split("").contains("m")
      }
      .map { line => line.split("\t").takeFirst(3).takeLast(1).join("") }
      .filter { pkg => buildSelected(pkg) }
  }

  # Whether the build setting selects a module-relative main package. A pattern
  # matches the package's directory within the module or its workspace path, so
  # "!vendor" leaves out every main package in modules under vendor.
  let buildSelected(pkg: String!): Boolean! {
    let paths = [pkg, packagePath(pkg)]
    let selecting = buildPatterns.filter { p => p.hasPrefix("!") == false }
    let excluding = buildPatterns.filter { p => p.hasPrefix("!") }
    (selecting.length == 0 or selecting.any { p => paths.any { at => rootSelected(normalized(at), [p]) } })
      and excluding.any { p => paths.any { at => rootSelected(normalized(at), [p]) == false } } == false
  }

  # The module path go.mod declares, as the scan reports it. The root
  # package's binary is named from it.
  let importPath(ws: Workspace!): String! {
    moduleField(ws, 2)
  }

  let packageArg(pkg: String!): String! {
    if (pkg == ".") { "." } else { "./" + pkg }
  }

  # This module's Go container targeting a GOOS/GOARCH platform, before
  # source is added.
  let platformBase(ws: Workspace!, platform: String!): Container! {
    let target = platform.split("/")
    base(ws)
      .withEnvVariable("GOOS", target.takeFirst(1).join(""))
      .withEnvVariable("GOARCH", target.takeLast(1).join(""))
  }

  # What go build writes for one main package: the binary, named name as go
  # build names it, and for a c-archive or c-shared build the C header next to
  # it. A gc build runs one cached exec per package, so an edit rebuilds only
  # the packages it reaches.
  let buildOutputs(ws: Workspace!, platform: String!, pkg: String!, name: String!): Directory! {
    let ctr = platformBase(ws, platform)
    let flags = buildFlags + (ctr.envVariable("GOFLAGS") ?? "").split(" ").filter { f => f != "" }
    let out = if (gccgo(flags)) {
      wholeBuild(ws, ctr, pkg, name)
    } else {
      perPackageBuild(ws, ctr, pkg, name)
    }
    # The engine's own message is only the exit code: raise it under a name.
    out.sync rescue {
      err: Error => raise "Go binary " + packagePath(pkg) + " for " + platform + ": " + err.message
    }
    out
  }

  # Whether go build flags, with GOFLAGS, pick the gccgo compiler.
  let gccgo(flags: [String!]!): Boolean! {
    flags.any { f => f == "-compiler=gccgo" or f == "--compiler=gccgo" }
      or (flags.any { f => f == "-compiler" or f == "--compiler" } and flags.contains("gccgo"))
  }

  # A gccgo build: gccgo compiles differently from the gc toolchain that the
  # per-package build replays, so it is one go build, as it always was, but
  # without the shared Go cache volumes, so its result is an ordinary one
  # another engine can pull from the remote cache.
  let wholeBuild(ws: Workspace!, ctr: Container!, pkg: String!, name: String!): Directory! {
    ctr
      .withoutMount("/go/pkg/mod")
      .withoutMount("/root/.cache/go-build")
      .withDirectory(".", source(ws))
      .withWorkdir(path)
      .withExec(["go", "build"] + buildFlags + ["-o", "/out/" + name, packageArg(pkg)])
      .directory("/out")
  }

  # A gc build, one cached exec per package.
  let perPackageBuild(ws: Workspace!, ctr: Container!, pkg: String!, name: String!): Directory! {
    gobuild.binary(
      base: ctr,
      # The toolchain image the base starts from, so package execs can run in
      # it without the base's project-specific setup; a custom base is used
      # as it is.
      image: if (baseImage == null) { gomod.goImage(toolchainVersion(ws)) } else { "" },
      source: source(ws),
      headers: lib.scan(ws).sync.file("_headers_.gohdr"),
      mountPath: mountPath,
      workdir: path,
      pkg: packageArg(pkg),
      output: name,
      flags: buildFlags,
    )
  }

  # The workspace package paths among pkgPaths that are main packages selected
  # by the build setting.
  let mainPackages(ws: Workspace!, pkgPaths: [String!]!): [String!]! {
    let mains = binaryPackages(ws)
    pkgPaths.filter { p => mains.contains(relativeDir(p)) }
  }

  # The name go build gives a package's binary: the last element of its import
  # path, or the one before when that is a major version such as "v2", with
  # ".exe" for Windows.
  let binaryFileName(ws: Workspace!, pkgPath: String!, platform: String!): String! {
    let rel = relativeDir(pkgPath)
    let modPath = importPath(ws)
    let full = if (rel == ".") { modPath } else { modPath + "/" + rel }
    let elements = full.split("/")
    let last = elements.takeLast(1).join("")
    let name = if (elements.length > 1 and last.replaceMatches(
      `^v([2-9]|[1-9][0-9]+)$`,
      with: "",
    ) == "") {
      elements.dropLast(1).takeLast(1).join("")
    } else {
      last
    }
    if (platform.hasPrefix("windows/")) { name + ".exe" } else { name }
  }

  # One package's binary for a platform. Only a main package selected by the
  # build setting has one.
  let binaryFile(ws: Workspace!, platform: String!, pkgPath: String!): File! {
    binaryOutputs(ws, platform, pkgPath).file(binaryFileName(ws, pkgPath, platform))
  }

  # One package's binary for a platform with what go build writes next to
  # it: the C header of a c-archive or c-shared build.
  let binaryOutputs(ws: Workspace!, platform: String!, pkgPath: String!): Directory! {
    let rel = relativeDir(pkgPath)
    if (binaryPackages(ws).contains(rel) == false) {
      raise "Go package " + pkgPath + " is not a main package selected by build"
    }
    buildOutputs(ws, platform, rel, binaryFileName(ws, pkgPath, platform))
  }

  # One package's test binary for a platform, named as go test -c names it.
  # A gc build runs one cached exec per package, as a binary's does.
  let testBinaryFile(ws: Workspace!, platform: String!, pkgPath: String!): File! {
    let rel = relativeDir(pkgPath)
    # go test -c's own rule: a package with test files has a test binary,
    # whatever they hold.
    if (lib.at(path).testDirectories(ws).contains(pkgPath) == false) {
      raise "Go package " + pkgPath + " has no test files"
    }
    let name = if (platform.hasPrefix("windows/")) {
      binaryFileName(ws, pkgPath, platform).trimSuffix(".exe") + ".test.exe"
    } else {
      binaryFileName(ws, pkgPath, platform) + ".test"
    }
    let ctr = platformBase(ws, platform)
    let flags = buildFlags + (ctr.envVariable("GOFLAGS") ?? "").split(" ").filter { f => f != "" }
    let out = if (gccgo(flags)) {
      ctr
        .withoutMount("/go/pkg/mod")
        .withoutMount("/root/.cache/go-build")
        .withDirectory(".", source(ws, test: true))
        .withWorkdir(path)
        .withExec(["go", "test", "-c", "-vet=off"] + buildFlags + ["-o", "/out/" + name, packageArg(rel)])
        .file("/out/" + name)
    } else {
      gobuild.testBinary(
        base: ctr,
        image: if (baseImage == null) { gomod.goImage(toolchainVersion(ws)) } else { "" },
        source: source(ws, test: true),
        headers: lib.scan(ws).sync.file("_headers_.gohdr"),
        mountPath: mountPath,
        workdir: path,
        pkg: packageArg(rel),
        flags: buildFlags,
      )
    }
    out.sync rescue {
      err: Error => raise "Go test binary " + packagePath(rel) + " for " + platform + ": " + err.message
    }
    out
  }

  # The binaries of the main packages among pkgPaths, one build each: they
  # share the packages they have in common through the cache.
  let binaryFiles(ws: Workspace!, platform: String!, pkgPaths: [String!]!): Directory! {
    mainPackages(ws, pkgPaths).reduce(directory) { out, p =>
      out.withDirectory(".", binaryOutputs(ws, platform, p))
    }
  }
}

"""
Go tests in a package, keyed by name.
"""
type GoTests @collection {
  """
  Test, fuzz and example function names.
  """
  names: [String!]! @keys

  """
  Tests selected in or out since the collection was discovered.
  """
  delta: CollectionDelta

  let directory: String!

  let module: GoModule!

  """
  The test function with this name.
  """
  function(name: String!): GoTest! @get {
    GoTest(name: name, directory: directory, module: module)
  }

  """
  Run the selected tests in this package.
  """
  test(ws: Workspace!): Void @check {
    # With nothing selected out, run the package as a whole rather than listing
    # every name in a -run pattern. Without a delta, the pattern is the safe
    # choice.
    let whole = if (delta == null) {
      false
    } else {
      delta.addedKeys.length == 0 and delta.removedKeys.length == 0
    }
    if (whole) {
      module.runTests(ws, directory, [])
    } else if (names.length > 0) {
      module.runTests(ws, directory, names)
    }
    null
  }
}

"""
A Go test function.
"""
type GoTest {
  """
  Test function name.
  """
  name: String!

  let directory: String!

  let module: GoModule!

  """
  Run this test.
  """
  test(ws: Workspace!): Void @check {
    module.runTests(ws, directory, [name])
  }
}

# Carry workspace files across changes in the generation container.
type GoGeneration {
  let container: Container!
  let value: String!
}
