"""
Run the module checks in a dev engine from dagger/dagger#14178.
"""
type EngineE2e {
  # Keep this commit equal to the engine-dev dependency in dagger-module.toml.
  let engineCommit: String! = "c624e1f8648e3f1c5940c01ca82a55c17d51908e"

  let engineSource: Workspace! {
    git("https://github.com/dagger/dagger").ref(engineCommit).asWorkspace
  }

  let client: Container! {
    engineDev(ws: engineSource)
      .installClient(container.from("alpine:3.23").withExec(["apk", "add", "--no-cache", "git"]))
  }

  """
  Open with `dagger shell playground`.
  Includes the dev engine, its CLI, and an example Git repository at /example.
  Run `dagger generate` there to try the container directive.
  """
  pub playground(ws: Workspace!): Container! {
    let source = ws.directory("/", exclude: [".git"])
    let fixture = source.directory("testdata/go-module-generate-dev-engine")
    let example = source.directory(".dagger/examples/generate-container")
      .withFile("generate.go", source.file(".dagger/examples/generate-container/generate.go.txt"))
      .withoutFile("generate.go.txt")
      .withFile("go.mod", fixture.file("go.mod"))
      .withDirectory("internal/generate", fixture.directory("internal/generate"))
      .withDirectory(".dagger/go", source)
      .withDirectory(".dagger/engine-e2e", source.directory(".dagger/modules/engine-e2e"))
    client
      .withExec(["apk", "add", "--no-cache", "nano"])
      .withDirectory("/example", example)
      .withWorkdir("/example")
      .withExec(["git", "init", "--quiet"])
      .withExec(["git", "add", "."])
      .withExec(["git", "-c", "user.name=Example", "-c", "user.email=example@example.com", "commit", "--quiet", "-m", "Initial example"])
      .withDefaultTerminalCmd(["sh", "-c", "cat README.md; exec sh"], experimentalPrivilegedNesting: false)
  }

  """
  Go container with the dev engine service and its CLI.
  """
  pub generateEnv: Container! {
    # The checks run in subnet 90. The generator's engine must use subnet 91.
    engineDev(ws: engineSource, subnetNumber: 90)
      .installClient(container.from("golang:1.26.1-alpine"))
  }

  """
  Build the pinned engine and CLI, then run all module checks.
  """
  pub devEngineCheck(ws: Workspace!): Void @check {
    let source = ws.directory("/", exclude: [".git"])
      .withFile("dagger.toml", ws.file("/.dagger/modules/engine-e2e/workspace.toml"))
    client
      .withMountedDirectory("/src", source)
      .withWorkdir("/src")
      .withExec(["git", "init", "--quiet"])
      .withExec(["dagger", "check"])
      .sync

    # TODO: uncomment when https://github.com/dagger/dagger/pull/14178 is merged
    # let example = playground(ws)
    #   .withExec(["dagger", "--auto-apply", "generate", "--require-load"])
    # assert("playground generator did not use the dev engine") {
    #   example.file("generated.txt").contents.contains("dev-engine-connected")
    # }
    null
  }
}
