"""
Development checks for dagger.io/go.
"""
type GoDev {
  let generatedFixturePath: String! = "testdata/go-module-generate"
  let generatedFilePath: String! = generatedFixturePath + "/generated.go"
  let baseFixturePath: String! = "testdata/go-module-custom-base"
  let baseGeneratedFilePath: String! = baseFixturePath + "/generated.go"
  let emptyFixturePath: String! = "testdata/go-module-empty"
  let regenerateFixturePath: String! = "testdata/go-module-regenerate"
  let cgoCxxFixturePath: String! = "testdata/go-module-cgo-cxx"
  let buildTagsFixturePath: String! = "testdata/go-module-build-tags"
  let mountPathFixturePath: String! = "testdata/go-module-mount-path"
  let noPackagesFixturePath: String! = "testdata/go-module-no-packages"
  let unreadableFixturePath: String! = "fixtures/go-module-unreadable"
  # The other modules in this repository keep their own fixtures, and several
  # of theirs fail on purpose: golangci-lint's does not even compile.
  let siblingFixtures: [String!]! = ["!golangci-lint", "!staticcheck"]
  # emptyFixturePath and unreadableFixturePath are deliberately absent: neither
  # directory is a Go module, so discovery never offers them and an exclusion
  # here would hide a regression in that filtering rather than prevent one.
  let test: [String!]! = [
    "**",
    "!" + baseFixturePath,
    "!" + cgoCxxFixturePath,
    "!" + buildTagsFixturePath,
    "!" + mountPathFixturePath,
    "!" + noPackagesFixturePath,
    "!testdata/go-module-excluded",
    "!testdata/go-module-skip-tree",
  ] + siblingFixtures
  let generate: [String!]! = [
    "**",
    "!gomod/helpers/go-includes/**",
    "!fixtures/go-module-generate-directories/**",
    "!testdata/go-module-generate-container/**",
    "!" + baseFixturePath,
    "!testdata/go-module-excluded",
    "!testdata/go-module-skip-tree/**",
    "!golangci-lint/**",
    "!staticcheck/**",
  ]

  let base: Container! {
    container
      .from("golang:1.26.1-alpine")
      .withEnvVariable("DAGGER_GO_CUSTOM_BASE", "yes")
      .withNewFile("/custom-go-base", "yes\n")
  }

  let cgoCxxBase: Container! {
    container
      .from("golang:1.26.1-alpine")
      .withExec(["apk", "add", "--no-cache", "build-base"])
  }

  let assert(condition: Boolean!, message: String!): Void {
    if (condition == false) {
      raise message
    }
    null
  }

  """
  Run a check, raising its failure. A check called through a dependency comes
  back as a Check that has not run.
  """
  let run(check: Check!): Void {
    # Check.error is not null for a passing check when read from Dang, so ask
    # pass first and read the message only on failure.
    if (check.pass == false) {
      raise check.error.message ?? "check failed"
    }
    null
  }

  # A main package that prints message.
  let goMain(message: String!): String! {
    "package main\n\nimport \"fmt\"\n\nfunc main() { fmt.Println(\"" + message + "\") }\n"
  }

  # Run each module's own tests. Objects from a dependency can't be mapped
  # over directly, so each module is looked up again by its path.
  let testEveryModule(tool: Go!, ws: Workspace!): Void {
    tool.modules(ws).{{path}}.map { mod => tool.module(ws, mod.path, findUp: false).test(ws) }
    null
  }

  let pathsOf(items: [{{path: String!}}!]!): [String!]! {
    items.map { item => item.path }
  }

  let containsPath(paths: [String!]!, want: String!): Boolean! {
    paths
      .filter { path => path == want }
      .length > 0
  }

  """
  Module discovery returns exactly the directories holding a go.mod that is a
  Go module a tool can work on, at any depth, and nothing else. The go.mod
  files that are not modules are skipsNonModulesCheck's business.
  """
  discoveryCheck(ws: Workspace!): Void @check {
    let paths = pathsOf(go(version: "1.26.1").modules(ws).{{path}})

    # A go.mod is discovered at any depth: top level, nested inside another
    # module, and several directories deep.
    let missing = [
      "fixtures/go-module-with-nested-module",
      "fixtures/go-module-with-nested-module/nested",
      "fixtures/go-module-with-included-gomod-replace/engine/distconsts",
    ].filter { p => containsPath(paths, p) == false }
    assert(missing.length == 0, "discovery missed modules: " + missing.join(", "))

    # Directories without a go.mod are never modules: the workspace root, an
    # intermediate parent, and a data-only subdirectory.
    let invented = [
      ".",
      "fixtures",
      "fixtures/go-module-cross-include-a/testdata",
    ].filter { p => containsPath(paths, p) }
    assert(invented.length == 0, "discovery invented modules: " + invented.join(", "))
    null
  }

  """
  Discovery is anchored at the workspace cwd, but the module roots it reports
  stay workspace-root-relative, so they remain usable with every other
  workspace API.
  """
  discoveryFromSubdirCheck(ws: Workspace!): Void @check {
    let tool = go(version: "1.26.1")

    let below = pathsOf(
      tool.modules(
        ws.withWorkdir("fixtures/go-module-with-nested-module"),
      ).{{path}},
    )
    assert(
      containsPath(below, "fixtures/go-module-with-nested-module"),
      "discovery from a module root missed that module",
    )
    assert(
      containsPath(below, "fixtures/go-module-with-nested-module/nested"),
      "discovery from a module root missed a module below it",
    )
    assert(
      containsPath(below, "fixtures/go-module-cross-include-a") == false,
      "discovery from a subdirectory reached a module outside it",
    )

    let inside = ws.withWorkdir("testdata/go-module-with-testdata/testdata")
    assert(
      containsPath(pathsOf(tool.modules(inside).{{path}}), "testdata/go-module-with-testdata"),
      "discovery inside a module missed the enclosing module",
    )

    # A root reported as ".." has to survive being mounted, not just be spelled
    # right: every source mount resolves it against the workspace root.
    testEveryModule(tool, inside)
    assert(
      containsPath(tool.packages(inside).keys, "testdata/go-module-with-testdata"),
      "packages from inside a module missed the enclosing module's",
    )
    null
  }

  """
  Packages form a collection keyed by workspace directory. get and list build
  the packages at those keys; subset keeps parent order, rejects unknown and
  duplicate keys, and narrows what get accepts; an empty subset is valid and
  its batches do nothing.
  """
  collectionCheck(ws: Workspace!): Void @check {
    let a = "fixtures/go-module-cross-include-a"
    let b = "fixtures/go-module-cross-include-b"
    let packages = go(version: "1.26.1").packages(ws)
    assert(packages.get(key: a).path == a, "get did not return the package at its key")
    assert(
      packages.list.{{path}}.map { pkg => pkg.path } == packages.keys,
      "list did not return one package per key, in key order",
    )

    let parentOrder = packages.keys.filter { p => p == a or p == b }
    let pair = packages.subset(keys: [b, a])
    assert(pair.keys == parentOrder, "subset did not keep parent order: " + pair.keys.join(", "))

    let outside = { pair.get(key: "testdata/go-module-with-testdata").path } rescue {
      err: Error => "rejected"
    }
    assert(outside == "rejected", "get accepted a key outside the subset")

    let unknown = { packages.subset(keys: ["no/such/package"]).keys.join(","); "accepted" } rescue {
      err: Error => "rejected"
    }
    assert(unknown == "rejected", "subset accepted an unknown key")

    let duplicate = { packages.subset(keys: [a, a]).keys.join(","); "accepted" } rescue {
      err: Error => "rejected"
    }
    assert(duplicate == "rejected", "subset accepted a duplicate key")

    let none = packages.subset(keys: [])
    assert(none.keys.length == 0, "empty subset kept keys: " + none.keys.join(", "))
    assert(none.batch.binary(ws).entries.length == 0, "empty subset built binaries")
    let noChanges = none.batch.generate(ws)
    assert(
      noChanges.addedPaths.length == 0
        and noChanges.modifiedPaths.length == 0
        and noChanges.removedPaths.length == 0,
      "empty subset generated changes",
    )
    null
  }

  """
  Each package's tests form a collection keyed by name: a subset runs only its
  own tests, in its own package, and a module whose tests are skipped offers
  no test packages.
  """
  testsCollectionCheck(ws: Workspace!): Void @check {
    let modPath = "testdata/go-module-with-testdata"
    let tool = go(version: "1.26.1")
    let packages = tool.packages(ws)
    assert(containsPath(packages.keys, modPath), "package discovery missed " + modPath)
    let tests = packages.get(key: modPath).tests(ws)
    let missing = [
      "TestFixtureFromTestdata",
      "TestGoTestIncludeAnnotation",
      "TestGoEmbedAssets",
    ].filter { name => tests.keys.contains(name) == false }
    assert(missing.length == 0, "test discovery missed: " + missing.join(", "))

    let one = "TestGoEmbedAssets"
    assert(tests.get(key: one).name == one, "get did not return the test at its key")
    run(tests.subset(keys: [one]).batch.test(ws))
    run(tests.get(key: one).test(ws))

    # A test file with no test in it makes no package, and a module outside
    # the test selection offers none either.
    assert(
      containsPath(packages.keys, noPackagesFixturePath) == false,
      "a directory with no tests became a package",
    )
    let skipped = go(version: "1.26.1", test: ["!" + modPath]).packages(ws).keys
    assert(containsPath(skipped, modPath) == false, "a skipped module offered its test package")

    # Names come from the source: tests, fuzz targets and examples count;
    # TestMain, a lowercase suffix and the wrong signature do not; testdata is
    # left out; a nested module's tests are its own package's; build
    # constraints are not evaluated; a name repeated in another package is
    # that package's own key; and the order is stable.
    let rooted = directory
      .withNewFile("go.mod", "module example.com/root\n\ngo 1.26.1\n")
      .withNewFile("a_test.go", ```go
        package root
        import "testing"
        func TestAlpha(t *testing.T) {}
        func TestMain(m *testing.M) {}
        func Testify(t *testing.T) {}
        func TestHelper(n int) {}
        func FuzzAlpha(f *testing.F) {}
        func ExampleAlpha() {}
        func Examplefoo() {}
      ``` + "\n")
      .withNewFile("constrained_test.go", "//go:build never\n\npackage root\nimport \"testing\"\nfunc TestConstrained(t *testing.T) {}\n")
      .withNewFile("sub/b_test.go", "package sub\nimport \"testing\"\nfunc TestBeta(t *testing.T) {}\nfunc TestAlpha(t *testing.T) {}\n")
      .withNewFile("examples/c_test.go", "package examples\nfunc Example() {}\n")
      .withNewFile("helpers/helpers_test.go", "package helpers\n")
      .withNewFile("testdata/c_test.go", "package c\nimport \"testing\"\nfunc TestIgnored(t *testing.T) {}\n")
      .withNewFile("nested/go.mod", "module example.com/nested\n\ngo 1.26.1\n")
      .withNewFile("nested/d_test.go", "package nested\nimport \"testing\"\nfunc TestNested(t *testing.T) {}\n")
      .asWorkspace
    let found = go(version: "1.26.1").packages(rooted)
    assert(
      found.keys == [".", "examples", "nested", "sub"],
      "static package discovery found: " + found.keys.join(", "),
    )
    let rootNames = found.get(key: ".").tests(rooted).keys
    assert(
      rootNames == ["TestAlpha", "FuzzAlpha", "ExampleAlpha", "TestConstrained"],
      "static test discovery found: " + rootNames.join(", "),
    )
    let subNames = found.get(key: "sub").tests(rooted).keys
    assert(subNames == ["TestBeta", "TestAlpha"], "static test discovery in sub found: " + subNames.join(", "))
    let exampleNames = found.get(key: "examples").tests(rooted).keys
    assert(exampleNames == ["Example"], "an examples-only package found: " + exampleNames.join(", "))
    let nestedNames = found.get(key: "nested").tests(rooted).keys
    assert(nestedNames == ["TestNested"], "the nested module's package found: " + nestedNames.join(", "))

    # The same name in two packages runs only where it was selected, and a
    # failure names the package.
    let shared = directory
      .withNewFile("go.mod", "module example.com/shared\n\ngo 1.26.1\n")
      .withNewFile("a_test.go", "package shared\nimport \"testing\"\nfunc TestShared(t *testing.T) {}\n")
      .withNewFile("sub/b_test.go", "package sub\nimport \"testing\"\nfunc TestShared(t *testing.T) { t.Fatal(\"ran in sub\") }\n")
      .asWorkspace
    let sharedPackages = go(version: "1.26.1").packages(shared)
    run(
      sharedPackages.get(key: ".").tests(shared).subset(keys: ["TestShared"]).batch.test(shared),
    )
    let failed = {
      run(
        sharedPackages.get(key: "sub").tests(shared).get(key: "TestShared").test(shared),
      )
      "no failure"
    } rescue {
      err: Error => err.message
    }
    assert(failed.contains("Go tests in sub:"), "a package failure did not name the package: " + failed)
    null
  }

  """
  A package has a binary when it is a main package selected by build. Main packages
  are found by searching the source; binaries are named as go build names
  them; a batch builds every selected package, across modules; build patterns
  narrow the keys; and platforms build for the engine's platform unless some
  are selected, and then for exactly those.
  """
  binaryCheck(ws: Workspace!): Void @check {
    let onDisk = go(version: "1.26.1").packages(ws).keys
    assert(
      containsPath(onDisk, generatedFixturePath + "/cmd/writegenerated"),
      "main package discovery on disk missed " + generatedFixturePath + "/cmd/writegenerated",
    )

    let caller = directory
      .withNewFile("go.mod", "module example.com/binaries\n\ngo 1.26.1\n")
      .withNewFile("main.go", goMain("root"))
      .withNewFile("cmd/hello/main.go", goMain("hello"))
      .withNewFile("cmd/hello/main_test.go", "package main\n")
      .withNewFile("cmd/stamp/main.go", "package main\n\nimport \"fmt\"\n\nvar message = \"unstamped\"\n\nfunc main() { fmt.Println(message) }\n")
      .withNewFile("cmd/tool/v2/main.go", goMain("tool"))
      .withNewFile("tools/hello/main.go", goMain("tools hello"))
      .withNewFile("broken/main.go", "package main\n\nfunc main() { undefined() }\n")
      .withNewFile("lib/lib.go", "package lib\n")
      .withNewFile("lib/lib_test.go", "package lib\nimport \"testing\"\nfunc TestLib(t *testing.T) {}\n")
      .withNewFile("plain/plain.go", "package plain\n")
      .withNewFile("gen/gen.go", "//go:build ignore\n\npackage main\n\nfunc main() {}\n")
      .withNewFile("testdata/fixture/main.go", "package main\n\nfunc main() {}\n")
      .withNewFile("_skip/main.go", "package main\n\nfunc main() {}\n")
      .withNewFile("nested/go.mod", "module example.com/nested\n\ngo 1.26.1\n")
      .withNewFile("nested/main.go", goMain("nested"))
      .asWorkspace
    let tool = go(version: "1.26.1")
    let mod = tool.module(caller, ".", findUp: false)
    let packages = tool.packages(caller)
    assert(
      packages.keys == [".", "broken", "cmd/hello", "cmd/stamp", "cmd/tool/v2", "lib", "nested", "tools/hello"],
      "package discovery found: " + packages.keys.join(", "),
    )

    let built = packages.subset(keys: ["cmd/hello", "cmd/tool/v2", ".", "nested"]).batch.binary(caller)
    assert(
      built.entries == ["binaries", "hello", "nested", "tool"],
      "the batch built: " + built.entries.join(", "),
    )
    let said = mod
      .base(caller)
      .withFile("/usr/local/bin/hello", packages.get(key: "cmd/hello").binary(caller))
      .withExec(["hello"])
      .stdout
    assert(said == "hello\n", "the built binary printed: " + said)

    let library = { packages.get(key: "lib").binary(caller).size; "no failure" } rescue {
      err: Error => err.message
    }
    assert(library.contains("not a main package"), "a library package built: " + library)
    assert(
      packages.subset(keys: ["lib", "cmd/hello"]).batch.binary(caller).entries == ["hello"],
      "the batch did not skip a library package",
    )

    let clash = {
      packages.subset(keys: ["cmd/hello", "tools/hello"]).batch.binary(caller).entries.join(",")
      "no failure"
    } rescue {
      err: Error => err.message
    }
    assert(
      clash.contains("cmd/hello") and clash.contains("tools/hello"),
      "a name clash did not name both packages: " + clash,
    )

    let host = `${defaultPlatform}`.split("/").takeFirst(2).join("/")
    let broken = { packages.get(key: "broken").binary(caller).size; "no failure" } rescue {
      err: Error => err.message
    }
    assert(
      broken.contains("Go binary broken for " + host + ":"),
      "a failed build did not name the package and platform: " + broken,
    )

    let selected = go(version: "1.26.1", build: ["cmd/**", "!cmd/tool"]).packages(caller).keys
    assert(selected == ["cmd/hello", "cmd/stamp", "lib"], "build patterns selected: " + selected.join(", "))
    let none = go(version: "1.26.1", build: ["!**"]).packages(caller).keys
    assert(none == ["lib"], "an empty build selection kept: " + none.join(", "))

    # buildFlags reach go build as separate arguments, so a value may hold
    # spaces, which GOFLAGS cannot carry.
    let stamped = go(version: "1.26.1", buildFlags: ["-trimpath", "-ldflags=-s -w -X main.message=stamped"])
      .packages(caller)
      .subset(keys: ["cmd/stamp"])
    let stampedSaid = mod
      .base(caller)
      .withFile("/usr/local/bin/stamp", stamped.get(key: "cmd/stamp").binary(caller))
      .withExec(["stamp"])
      .stdout
    assert(stampedSaid == "stamped\n", "buildFlags did not reach the package build: " + stampedSaid)
    let fromBatch = mod
      .base(caller)
      .withDirectory("/opt/bin", stamped.batch.binary(caller))
      .withExec(["/opt/bin/stamp"])
      .stdout
    assert(fromBatch == "stamped\n", "buildFlags did not reach the batch build: " + fromBatch)

    # Every platform Go supports is a key. Naming none builds for the engine's
    # platform alone; naming some builds exactly those, cross-compiled.
    let platforms = packages.get(key: "cmd/hello").platforms
    assert(
      platforms.keys.contains("windows/amd64") and platforms.keys.contains(host),
      "platform keys were not Go's platforms: " + platforms.keys.join(", "),
    )
    let hostOnly = platforms.batch.binary(caller).entries
    assert(
      hostOnly == [host.split("/").join("-") + "/"],
      "a run naming no platform built for: " + hostOnly.join(", "),
    )
    let cross = platforms.subset(keys: ["linux/amd64", "windows/amd64"])
    let crossBuilt = cross.batch.binary(caller)
    assert(
      crossBuilt.entries == ["linux-amd64/", "windows-amd64/"],
      "a platform selection built for: " + crossBuilt.entries.join(", "),
    )
    assert(
      crossBuilt.file("windows-amd64/hello.exe").size > 0,
      "the batch did not hold the Windows binary under its .exe name",
    )
    let buildInfo = mod
      .base(caller)
      .withFile("/tmp/hello.exe", cross.get(key: "windows/amd64").binary(caller))
      .withExec(["go", "version", "-m", "/tmp/hello.exe"])
      .stdout
    assert(
      buildInfo.contains("GOOS=windows") and buildInfo.contains("GOARCH=amd64"),
      "the Windows binary was not cross-compiled: " + buildInfo,
    )
    null
  }

  """
  Run every module's tests while respecting per-module skip configuration.
  """
  singleModuleCheck(ws: Workspace!): Void @check {
    let tool = go(version: "1.26.1", test: test, generate: generate)
    testEveryModule(tool, ws)
    tool.module(ws, "testdata/go-module-excluded").test(ws)
  }

  """
  A directive in one module must not affect another module's source mount.
  """
  perModuleDirectiveCheck(ws: Workspace!): Void @check {
    let tool = go(version: "1.26.1")
    tool.module(ws, "fixtures/go-module-cross-include-a").test(ws)
    tool.module(ws, "fixtures/go-module-cross-include-b").test(ws)
  }

  """
  A nested module's directives must not affect its parent module's source mount.
  """
  nestedModuleDirectiveCheck(ws: Workspace!): Void @check {
    go(version: "1.26.1").module(ws, "fixtures/go-module-with-nested-module").test(ws)
  }

  """
  A local replace target must be mounted with its non-Go assets.
  """
  goModReplaceCheck(ws: Workspace!): Void @check {
    go(version: "1.26.1").module(ws, "fixtures/go-module-with-replace").test(ws)
  }

  """
  Cgo C++ source is mounted and linked when running Go tests.
  """
  cgoCxxCheck(ws: Workspace!): Void @check {
    let mod = go(base: cgoCxxBase).module(ws, cgoCxxFixturePath)
    mod.test(ws)
  }

  """
  The goflags setting reaches Go commands as GOFLAGS, so build tags select
  source files without a custom base container.
  """
  goflagsCheck(ws: Workspace!): Void @check {
    let tool = go(version: "1.26.1", goflags: "-tags=extended")
    assert(
      tool.goflags == "-tags=extended",
      "constructor did not expose goflags: " + (tool.goflags ?? "<null>"),
    )
    let mod = tool.module(ws, buildTagsFixturePath)
    assert(
      mod.base(ws).envVariable("GOFLAGS") == "-tags=extended",
      "base container did not set GOFLAGS",
    )
    assert(
      go(version: "1.26.1").module(ws, buildTagsFixturePath).base(ws).envVariable("GOFLAGS") == null,
      "base container set GOFLAGS without a goflags setting",
    )
    # The fixture test fails unless the extended tag was applied at build time.
    mod.test(ws)
  }

  """
  The workspace mounts at a configurable path that defaults to
  "/src/<workspace name>".

  Only the local checkout is covered here: the cwd and git version selector
  handling in the name derivation needs a session started at a remote or
  subdirectory address, which a check cannot set up.
  """
  mountPathCheck(ws: Workspace!): Void @check {
    let mod = go(version: "1.26.1", mountPath: "/src/hugo").module(ws, mountPathFixturePath)
    assert(
      mod.mountPath == "/src/hugo",
      "module did not expose the configured mount path: " + mod.mountPath,
    )
    # The fixture test asserts its working directory and the .git marker
    # both live under /src/hugo.
    mod.test(ws)

    let derived = go(version: "1.26.1").module(ws, mountPathFixturePath).mountPath
    assert(
      derived.hasPrefix("/src/") and derived != "/src/",
      "default mount path did not derive a workspace name: " + derived,
    )
    assert(
      derived.contains("/fixtures") == false and derived.contains("/testdata") == false,
      "default mount path leaked a workspace path into the name: " + derived,
    )
    let relative = { go(version: "1.26.1", mountPath: "src/hugo").mountPath ?? "missing rejection" } rescue {
      err: Error => err.message
    }
    assert(
      relative.contains("absolute"),
      "constructor did not reject a relative mount path: " + relative,
    )
    null
  }

  """
  A module's failing tests name the Go module they came from, so a
  multi-module repository does not need a manual search. Package tests name
  their package; testsCollectionCheck covers those.
  """
  namedFailureCheck(ws: Workspace!): Void @check {
    # The fixture's test command exits non-zero without running a Go test, so
    # the check exercises failure naming without reporting a failed test.
    let failing = noPackagesFixturePath
    let passing = "testdata/go-module-with-testdata"
    let single = { go(version: "1.26.1").module(ws, failing).test(ws); "no failure" } rescue {
      err: Error => err.message
    }
    assert(
      single.contains("Go module " + failing + ":"),
      "single module failure did not name the module: " + single,
    )

    let passed = { go(version: "1.26.1").module(ws, passing).test(ws); "no failure" } rescue {
      err: Error => err.message
    }
    assert(passed == "no failure", "a passing module failed: " + passed)
    null
  }

  """
  A module with no version setting runs under the Go toolchain its own go.mod
  asks for, and the version setting still overrides it.
  """
  goVersionCheck(ws: Workspace!): Void @check {
    # The shared fixtures say "go 1.25"; the scanner's helper says "go 1.26.1".
    let older = go.module(ws, "fixtures/go-module-with-nested-module")
    let newer = go.module(ws, "gomod/helpers/go-includes")
    assert(older.version(ws) == "1.25", "go 1.25 was not taken from the module: " + (older.version(ws) ?? "<null>"))
    assert(newer.version(ws) == "1.26", "go 1.26.1 did not resolve to its minor series: " + (newer.version(ws) ?? "<null>"))
    assert(
      older.base(ws).withExec(["go", "version"]).stdout.contains("go1.25"),
      "the module's own toolchain did not reach its container",
    )
    assert(
      newer.base(ws).withExec(["go", "version"]).stdout.contains("go1.26"),
      "a second module did not get its own toolchain",
    )

    # An explicit version is used as written, so a patch release stays exact.
    let pinned = go(version: "1.26.1").module(ws, "fixtures/go-module-with-nested-module")
    assert(pinned.version(ws) == "1.26.1", "version did not override the module's own")
    assert(
      pinned.base(ws).withExec(["go", "version"]).stdout.contains("go1.26.1"),
      "an explicit version was not used as written",
    )

    # The tests run under the module's toolchain, and the runner is built
    # elsewhere, so an older module still gets it.
    older.test(ws)
    null
  }

  """
  A directory that is not a Go module never reaches a Go command.

  Testing every module and generating every package both run over the whole
  workspace, and the
  workspace holds one go.mod that will not parse and one module with no Go
  files. Neither is discovered, so neither is tested or generated in; naming
  one directly still says what is wrong with it.
  """
  skipsNonModulesCheck(ws: Workspace!): Void @check {
    let tool = go(version: "1.26.1", test: test, generate: generate)
    let mods = tool.modules(ws)
    let discovered = pathsOf(mods.{{path}})
    assert(
      containsPath(discovered, unreadableFixturePath) == false,
      "a go.mod that will not parse was offered as a module",
    )
    assert(
      containsPath(discovered, emptyFixturePath) == false,
      "a module with no Go files was offered as a module",
    )

    # Both are in the selection patterns by way of "**", so only the filtering
    # keeps them out of these two.
    testEveryModule(tool, ws)
    tool.packages(ws).batch.generate(ws).layer.sync

    let named = go(version: "1.26.1").module(ws, unreadableFixturePath)
    assert(
      (named.scanFailure(ws) ?? "").contains(unreadableFixturePath + "/go.mod"),
      "naming the directory did not say what was wrong with it",
    )
    assert(named.skipGenerate(ws), "an unreadable module was offered for generation")
    assert(named.hasGenerateDirectives(ws) == false, "an unreadable module claimed generate directives")
    null
  }

  """
  A custom base container must be used for this module's test and generate
  containers. The source scanner is not one of them: it runs in a pinned
  container of the library's own, by design.
  """
  baseCheck(ws: Workspace!): Void @check {
    let tool = go(
      base: base,
    )
    let mod = tool.module(ws, baseFixturePath)

    assert(
      tool.version == null,
      "base-only constructor exposed a Go version for a black-box base image",
    )

    # version is ignored rather than refused: the base already carries a
    # toolchain, and refusing the combination would only make the caller edit
    # settings to say what the base already says.
    let ignored = go(version: "1.26.1", base: base)
    assert(ignored.version == null, "version was not ignored alongside base")
    let said = ignored.warnings.join("; ")
    assert(said.contains("version"), "the warning did not name the dropped setting: " + said)
    assert(said.contains("base was set"), "the warning did not say why it was dropped: " + said)
    assert(go.warnings.length == 0, "a plain constructor warned about nothing")
    assert(
      ignored.module(ws, baseFixturePath).base(ws).file("/custom-go-base").contents.contains("yes"),
      "the base was discarded in favour of the ignored version",
    )

    assert(
      containsPath(tool.packages(ws).keys, baseFixturePath),
      "custom base package discovery did not include the module root",
    )

    mod.test(ws)

    let changes = mod.generate(ws)
    assert(
      containsPath(changes.addedPaths, baseGeneratedFilePath),
      "custom base generate did not add expected path: " + baseGeneratedFilePath,
    )
    assert(
      changes.layer.file(baseGeneratedFilePath).contents.contains("GeneratedFromBase"),
      "custom base generate did not produce expected contents",
    )

    null
  }

  """
  Per-module introspection fields must expose the source selection intermediates.
  """
  moduleIntrospectionCheck(ws: Workspace!): Void @check {
    let mod = go(version: "1.26.1").module(ws, "testdata/go-module-with-testdata/testdata")

    assert(
      go.version == null,
      "default constructor pinned a Go version that varies per module",
    )
    assert(
      mod.path == "testdata/go-module-with-testdata",
      "module lookup did not snap to containing module: " + mod.path,
    )
    assert(
      mod.version(ws) == "1.26.1",
      "module did not expose inherited Go version: " + (mod.version(ws) ?? "<null>"),
    )

    let direct = go(version: "1.26.1").module(
      ws,
      "testdata/go-module-with-testdata/testdata",
      findUp: false,
    )
    assert(
      direct.path == "testdata/go-module-with-testdata/testdata",
      "module lookup unexpectedly snapped with findUp false: " + direct.path,
    )

    let tool = go(version: "1.26.1", test: test, generate: generate)
    let allModulePaths = pathsOf(tool.modules(ws).{{path}})
    assert(
      containsPath(allModulePaths, "fixtures/go-module-cross-include-a"),
      "unfiltered modules did not include expected fixture module",
    )
    assert(
      containsPath(allModulePaths, "fixtures/go-module-cross-include-b"),
      "unfiltered modules did not include expected fixture module",
    )
    assert(
      containsPath(allModulePaths, "testdata/go-module-excluded"),
      "unfiltered modules did not include skipped fixture module by default",
    )

    let includedModulePaths = tool
      .modules(ws, include: ["fixtures/go-module-cross-include-a"]).{{path}}.map { mod => mod.path }
    assert(
      containsPath(includedModulePaths, "fixtures/go-module-cross-include-a"),
      "modules include filter did not include matching module root",
    )
    assert(
      containsPath(includedModulePaths, "fixtures/go-module-cross-include-b") == false,
      "modules include filter included non-matching module root",
    )

    let excludedModulePaths = tool
      .modules(ws, exclude: ["fixtures/go-module-cross-include-a"]).{{path}}.map { mod => mod.path }
    assert(
      containsPath(excludedModulePaths, "fixtures/go-module-cross-include-a") == false,
      "modules exclude filter included excluded module root",
    )

    let combinedModulePaths = tool
      .modules(
        ws,
        include: ["fixtures/go-module-cross-include-*"],
        exclude: ["fixtures/go-module-cross-include-b"],
      ).{{path}}.map { mod => mod.path }
    assert(
      containsPath(combinedModulePaths, "fixtures/go-module-cross-include-a"),
      "modules combined filters did not include matching module root",
    )
    assert(
      containsPath(combinedModulePaths, "fixtures/go-module-cross-include-b") == false,
      "modules combined filters included excluded module root",
    )

    let contentMatchedModulePaths = tool
      .modules(ws, include: ["**/module-a-only.data"]).{{path}}.map { mod => mod.path }
    assert(
      containsPath(contentMatchedModulePaths, "fixtures/go-module-cross-include-a"),
      "modules include filter did not match module directory contents",
    )
    assert(
      containsPath(contentMatchedModulePaths, "fixtures/go-module-cross-include-b") == false,
      "modules include filter matched content outside the module directory",
    )

    let testSkippedModulePaths = tool
      .modules(ws, includeSkipTest: false).{{path}}.map { mod => mod.path }
    assert(
      containsPath(testSkippedModulePaths, "testdata/go-module-excluded") == false,
      "modules includeSkipTest false included test-skipped module",
    )
    assert(
      containsPath(testSkippedModulePaths, "testdata/go-module-empty") == false,
      "modules includeSkipTest false included module with test skip config",
    )
    assert(
      containsPath(testSkippedModulePaths, "testdata/go-module-skip-tree/nested") == false,
      "modules includeSkipTest false included module with ancestor test skip config",
    )
    assert(
      containsPath(testSkippedModulePaths, "testdata/go-module-with-testdata"),
      "modules includeSkipTest false excluded non-test-skipped module",
    )

    let generateSkippedModulePaths = tool
      .modules(ws, includeSkipGenerate: false).{{path}}.map { mod => mod.path }
    assert(
      containsPath(generateSkippedModulePaths, "testdata/go-module-excluded") == false,
      "modules includeSkipGenerate false included generate-skipped module",
    )
    assert(
      containsPath(generateSkippedModulePaths, "testdata/go-module-skip-tree/nested") == false,
      "modules includeSkipGenerate false included module with ancestor generate skip config",
    )
    assert(
      containsPath(generateSkippedModulePaths, "testdata/go-module-generate"),
      "modules includeSkipGenerate false excluded non-generate-skipped module",
    )

    let withExtraFiles = go(
      version: "1.26.1",
      includeExtraFiles: ["LICENSE"],
    ).module(ws, "testdata/go-module-with-testdata")
    assert(
      containsPath(withExtraFiles.includeExtraFiles, "LICENSE"),
      "module did not expose inherited extra include files",
    )
    assert(
      containsPath(mod.includeBase, "testdata/go-module-with-testdata/**/*.go"),
      "module base includes did not include module-scoped Go pattern",
    )
    assert(
      containsPath(mod.includeBase, "**/*.go") == false,
      "module base includes exposed workspace-wide Go pattern",
    )

    let skipped = tool.module(ws, "testdata/go-module-excluded")
    assert(
      skipped.skipTest,
      "module did not detect test skip config",
    )
    assert(
      skipped.skipGenerate(ws),
      "module did not detect generate skip config",
    )

    let treeSkipped = tool.module(ws, "testdata/go-module-skip-tree/nested")
    assert(
      treeSkipped.skipTest,
      "nested module did not inherit test skip config from ancestor",
    )
    assert(
      treeSkipped.skipGenerate(ws),
      "nested module did not inherit generate skip config from ancestor",
    )

    assert(
      mod.skipTest == false,
      "module without skip config reported skipped tests",
    )
    assert(
      mod.skipGenerate(ws),
      "module without generator commands did not skip generation",
    )
    assert(
      mod.hasGenerateDirectives(ws) == false,
      "module without go:generate directive reported generate directives",
    )
    assert(
      go(version: "1.26.1")
        .module(ws, emptyFixturePath)
        .hasGenerateDirectives(ws) == false,
      "module without Go files reported generate directives",
    )
    assert(
      go(version: "1.26.1")
        .module(ws, generatedFixturePath)
        .hasGenerateDirectives(ws),
      "module with go:generate directive did not report generate directives",
    )

    let discovered = mod.includeDiscovered(ws, test: true)
    assert(
      containsPath(discovered, "LICENSE"),
      "test source includes did not include workspace-root directive include",
    )
    assert(
      containsPath(discovered, "testdata/go-module-with-testdata/embedded-assets/message.txt"),
      "test source includes did not include go:embed file",
    )
    assert(
      mod.source(ws, test: true).file("LICENSE").contents.contains("Apache License"),
      "test source directory did not include LICENSE",
    )
    let sourceGoFiles = mod.source(ws, test: true).glob("**/*.go")
    assert(
      containsPath(sourceGoFiles, "testdata/go-module-with-testdata/embed_test.go"),
      "source directory did not include module Go file",
    )
    assert(
      containsPath(sourceGoFiles, "fixtures/go-module-cross-include-b/isolation_test.go") == false,
      "source directory included Go file from another module",
    )
    assert(
      mod
        .testData(ws)
        .file("testdata/go-module-with-testdata/testdata/fixture.txt")
        .contents
        .contains("mounted from testdata"),
      "testData directory did not include module testdata fixture",
    )

    let replaced = go(version: "1.26.1").module(ws, "fixtures/go-module-with-replace")
    let replacedIncludes = replaced.includeDiscovered(ws, test: true)
    assert(
      containsPath(replacedIncludes, "fixtures/replaced-lib/**/*.go"),
      "go.mod replace includes did not include replaced lib Go files",
    )
    assert(
      containsPath(replacedIncludes, "fixtures/replaced-lib/asset.txt"),
      "go.mod replace includes did not include replaced lib go:embed file",
    )

    let includedGoMod = go(version: "1.26.1").module(ws, "fixtures/go-module-with-included-gomod-replace/sdk/go")
    let includedGoModIncludes = includedGoMod.includeDiscovered(ws, generate: true)
    assert(
      containsPath(
        includedGoModIncludes,
        "fixtures/go-module-with-included-gomod-replace/**/*.go",
      ),
      "go:generate -C did not include generator module Go files",
    )
    assert(
      containsPath(
        includedGoModIncludes,
        "fixtures/go-module-with-included-gomod-replace/engine/distconsts/**/*.go",
      ),
      "go.mod replace includes did not include replace target Go files from generator module",
    )
    assert(
      containsPath(
        includedGoModIncludes,
        "fixtures/go-module-with-included-gomod-replace/engine/leaf/**/*.go",
      ),
      "go.mod replace includes did not include recursively discovered replace target Go files",
    )
    assert(
      containsPath(
        includedGoModIncludes,
        "fixtures/go-module-with-included-gomod-replace/cmd/codegen/**",
      ),
      "go:generate scoped include did not include generator support files",
    )
    null
  }

  """
  Run go generate and verify its changeset.
  """
  generateCheck(ws: Workspace!): Void @check {
    go(version: "1.26.1")
      .module(ws, "fixtures/go-module-with-included-gomod-replace/sdk/go")
      .generate(ws)
      .layer
      .sync

    let changes = go(version: "1.26.1", generate: generate).packages(ws).batch.generate(ws)

    assert(
      changes.addedPaths.length == 1,
      "generate changeset included unexpected added paths",
    )
    assert(
      containsPath(changes.addedPaths, generatedFilePath),
      "generate changeset did not include added path: " + generatedFilePath,
    )
    assert(
      changes.modifiedPaths.length == 0,
      "generate changeset included unexpected modified paths",
    )
    assert(
      changes.removedPaths.length == 0,
      "generate changeset included unexpected removed paths",
    )

    let generatedContents = changes.layer.file(generatedFilePath).contents
    assert(
      generatedContents.contains("const GeneratedValue = \"generated by go generate\""),
      "generated file did not contain expected contents",
    )

    let emptyChanges = go(
      version: "1.26.1",
      generate: ["**", "!" + generatedFixturePath],
    ).module(ws, generatedFixturePath).generate(ws)
    assert(
      emptyChanges.addedPaths.length == 0,
      "skipped module generate produced added paths",
    )
    assert(
      emptyChanges.modifiedPaths.length == 0,
      "skipped module generate produced modified paths",
    )
    assert(
      emptyChanges.removedPaths.length == 0,
      "skipped module generate produced removed paths",
    )

    let noGoFileChanges = go(version: "1.26.1").module(ws, emptyFixturePath).generate(ws)
    assert(
      noGoFileChanges.addedPaths.length == 0,
      "module without Go files generate produced added paths",
    )
    assert(
      noGoFileChanges.modifiedPaths.length == 0,
      "module without Go files generate produced modified paths",
    )
    assert(
      noGoFileChanges.removedPaths.length == 0,
      "module without Go files generate produced removed paths",
    )

    null
  }

  """
  Regenerating a module whose generated output is already present and current
  reports no changes at all.

  The changeset baseline is the module's real source, so a second run has to
  see the files the first one produced; a baseline that read as empty would
  report every generated file as newly added.
  """
  regenerateCheck(ws: Workspace!): Void @check {
    let changes = go(version: "1.26.1").module(ws, regenerateFixturePath).generate(ws)

    assert(
      changes.addedPaths.length == 0,
      "regenerate re-added existing generated output: " + changes.addedPaths.join(", "),
    )
    assert(
      changes.modifiedPaths.length == 0,
      "regenerate rewrote up-to-date generated output: " + changes.modifiedPaths.join(", "),
    )
    assert(
      changes.removedPaths.length == 0,
      "regenerate removed existing files: " + changes.removedPaths.join(", "),
    )
    null
  }

  """
  Generation uses Dagger globs, including root paths and exclusions.
  """
  generationGlobsCheck(ws: Workspace!): Void @check {
    let root = "fixtures/go-module-generate-directories"
    let dirs = [root, root + "/later", root + "/version"]
    assert(go(generate: []).module(ws, root).generateDirectories(ws) == dirs, "empty selection did not include all directories")
    assert(
      go(generate: ["!" + root]).module(ws, root).generateDirectories(ws) == [root + "/later", root + "/version"],
      "literal exclusion recursed into children",
    )
    assert(
      go(generate: [root + "/**", "!" + root + "/**", root + "/version"]).module(
        ws,
        root,
      ).generateDirectories(ws).length == 0,
      "include overrode an exclusion",
    )
    assert(
      go(generate: [root + "/[lv]*"]).module(ws, root).generateDirectories(ws) == [root + "/later", root + "/version"],
      "character class glob did not match",
    )
    assert(
      go(generate: ["fixtures/**/version"]).module(ws, root).generateDirectories(ws) == [root + "/version"],
      "mid-path recursive glob did not match",
    )
    assert(
      go(generate: ["./" + root + "/"]).module(ws, root).generateDirectories(ws) == [root],
      "relative directory spelling did not match",
    )
    assert(go(generate: ["!**"]).module(ws, root).hasGenerateDirectives(ws), "selection hid existing directives")

    let rooted = ws.withDirectory(
      "/",
      directory
        .withNewFile("go.mod", "module example.com/root\n\ngo 1.26.1\n")
        .withNewFile("generate.go", "package root\n\n//go:generate go version\n"),
    )
    assert(
      go(generate: ["."]).module(rooted, ".", findUp: false).generateDirectories(rooted) == ["."],
      "literal root did not match",
    )
    assert(
      go(generate: ["**"]).module(rooted, ".", findUp: false).generateDirectories(rooted) == ["."],
      "recursive glob missed root",
    )
    assert(
      go(generate: ["*"]).module(rooted, ".", findUp: false).generateDirectories(rooted).length == 0,
      "single-segment glob included root",
    )
    assert(
      go(generate: ["!."]).module(rooted, ".", findUp: false).generateDirectories(rooted).length == 0,
      "root exclusion failed",
    )
    null
  }

  """
  Directory selection runs only the selected package, regardless of invocation
  cwd: generate patterns stay workspace-root-relative when discovery starts
  inside a module.
  """
  selectionCheck(ws: Workspace!): Void @check {
    let root = "fixtures/go-module-generate-directories"
    let child = root + "/version"
    let tool = go(version: "1.26.1", generate: [child])
    let mod = tool.module(ws, root)
    assert(mod.generateDirectories(ws) == [child], "exact directory selection included other packages")
    let changes = tool.packages(ws.withWorkdir(root)).batch.generate(
      ws.withWorkdir(root),
    )
    assert(changes.addedPaths == [child + "/generated.go"], "generation ran outside the selected directory")
    assert(changes.modifiedPaths.length == 0, "generation modified unrelated files")
    assert(changes.removedPaths.length == 0, "generation removed unrelated files")

    let rootOnly = go(version: "1.26.1", generate: [root]).packages(ws).batch.generate(ws)
    assert(rootOnly.addedPaths == [root + "/generated.go"], "literal module root recursed into child directories")

    let globbed = go(version: "1.26.1", generate: [root + "/**", "!" + root, "!" + root + "/nested/**"])
    assert(
      globbed.module(ws, root).generateDirectories(ws) == [root + "/later", child],
      "recursive glob or exclusion failed",
    )
    let ordered = globbed.packages(ws).batch.generate(ws)
    assert(
      ordered.layer.file(child + "/generated.go").contents.contains("Earlier"),
      "directories did not share generated output in lexical order",
    )

    # A package's own generate runs alone, so version does not see what later
    # generates; a batch of both runs them in order, as go generate does.
    let alone = globbed.packages(ws).get(key: child).generate(ws)
    assert(alone.addedPaths == [child + "/generated.go"], "a package's own generate ran elsewhere")
    assert(
      alone.layer.file(child + "/generated.go").contents.contains("Earlier") == false,
      "a package's own generate saw another package's output",
    )
    let pair = globbed.packages(ws).subset(keys: [child, root + "/later"]).batch.generate(ws)
    assert(
      pair.layer.file(child + "/generated.go").contents.contains("Earlier"),
      "a batch of two packages did not run them in order",
    )

    let nested = go(version: "1.26.1", generate: [root + "/nested"]).packages(ws).batch.generate(ws)
    assert(nested.addedPaths == [root + "/nested/generated.go"], "nested module generator was not isolated")
    null
  }

  """
  Workspace container with a mounted file and an HTTP service for generators.
  """
  generateEnv: Container! {
    let service = container
      .from("busybox:1.37.0")
      .withNewFile("/www/value", "service binding retained\n")
      .withExposedPort(8080)
      .asService(args: ["httpd", "-f", "-p", "8080", "-h", "/www"])
    container
      .from("golang:1.26.1-alpine")
      .withEnvVariable("GENERATOR_BASE", "workspace")
      .withMountedFile(
        "/generator-config",
        directory.withNewFile("config", "mounted\n").file("config"),
      )
      .withServiceBinding("generator-input", service)
  }

  """
  Test container with a mounted file and service for Go tests.
  """
  testEnv: Container! {
    let service = container
      .from("busybox:1.37.0")
      .withExposedPort(8080)
      .withNewFile("/www/value", "test service retained\n")
      .asService(args: ["httpd", "-f", "-p", "8080", "-h", "/www"])
    container
      .from("golang:1.26.1-alpine")
      .withEnvVariable("TESTER_BASE", "workspace")
      .withNewFile("/tester-config", "mounted\n")
      .withServiceBinding("tester-input", service)
  }

  """
  Test package containers resolve from the workspace and carry test inputs.
  Consecutive package directories share container state; container changes keep
  workspace files so later tests can read earlier output.
  """
  testContainerCheck(ws: Workspace!): Void @check {
    let root = "fixtures/test-containers"
    let fixture = directory
      .withNewFile("go.mod", "module example.com/test-containers\n\ngo 1.26.1\n")
      .withNewFile("input.txt", "included test input\n")
      .withNewFile("selected_test.go", ```go
        package fixture
        import (
          "io"
          "net/http"
          "os"
          "testing"
        )
        //go:test:container dag://go-dev/test-env
        //go:test:include input.txt
        func TestSelectedContainer(t *testing.T) {
          if os.Getenv("TESTER_BASE") != "workspace" || os.Getenv("GOFLAGS") != "-tags=testcontainer" { t.Fatal("selected container lost its environment") }
          if os.Getenv("GOCACHE") != "/root/.cache/go-build" || os.Getenv("GOMODCACHE") != "/go/pkg/mod" { t.Fatal("selected container lost Go caches") }
          config, err := os.ReadFile("/tester-config")
          if err != nil || string(config) != "mounted\n" { t.Fatalf("selected container lost mounted file: %q, %v", config, err) }
          input, err := os.ReadFile("input.txt")
          if err != nil || string(input) != "included test input\n" { t.Fatalf("test include was not mounted: %q, %v", input, err) }
          response, err := http.Get("http://tester-input:8080/value")
          if err != nil { t.Fatal(err) }
          defer response.Body.Close()
          body, err := io.ReadAll(response.Body)
          if err != nil || string(body) != "test service retained\n" { t.Fatalf("selected container lost service: %q, %v", body, err) }
          if err := os.WriteFile("root-output.txt", []byte("root output\n"), 0644); err != nil { t.Fatal(err) }
          if err := os.WriteFile("/container-test-state", []byte("shared\n"), 0644); err != nil { t.Fatal(err) }
        }
      ``` + "\n")
      .withNewFile("0-shared/shared_test.go", ```go
        package shared
        import (
          "os"
          "testing"
        )
        //go:test:container dag://go-dev/test-env
        func TestSharedContainer(t *testing.T) {
          state, err := os.ReadFile("/container-test-state")
          if err != nil || string(state) != "shared\n" { t.Fatalf("consecutive packages did not share state: %q, %v", state, err) }
          output, err := os.ReadFile("../root-output.txt")
          if err != nil || string(output) != "root output\n" { t.Fatalf("consecutive packages lost workspace output: %q, %v", output, err) }
        }
      ``` + "\n")
      .withNewFile("a-default/default_test.go", ```go
        package defaultbase
        import (
          "os"
          "testing"
        )
        func TestDefaultContainer(t *testing.T) {
          if os.Getenv("TESTER_BASE") != "default" || os.Getenv("GOFLAGS") != "-tags=testcontainer" { t.Fatal("package did not use configured base") }
          if _, err := os.Stat("/tester-config"); !os.IsNotExist(err) { t.Fatal("workspace test container leaked into default base") }
          output, err := os.ReadFile("../root-output.txt")
          if err != nil || string(output) != "root output\n" { t.Fatalf("container change lost workspace output: %q, %v", output, err) }
        }
      ``` + "\n")
      .withNewFile("b-image/image_test.go", ```go
        package image
        import (
          "os"
          "testing"
        )
        //go:test:container docker.io/library/golang:1.26.1-alpine
        func TestImageContainer(t *testing.T) {
          if os.Getenv("TESTER_BASE") != "" || os.Getenv("GOFLAGS") != "-tags=testcontainer" { t.Fatal("image did not use the selected container") }
          if _, err := os.Stat("/tester-config"); !os.IsNotExist(err) { t.Fatal("workspace test container leaked into image") }
          output, err := os.ReadFile("../root-output.txt")
          if err != nil || string(output) != "root output\n" { t.Fatalf("image change lost workspace output: %q, %v", output, err) }
        }
      ``` + "\n")
      .withNewFile("c-wired/wired_test.go", ```go
        package wired
        import (
          "io"
          "net/http"
          "os"
          "testing"
        )
        //go:test:container dag://go-dev/test-env
        func TestWiredContainer(t *testing.T) {
          if os.Getenv("TESTER_BASE") != "workspace" { t.Fatal("workspace test container did not resolve") }
          response, err := http.Get("http://tester-input:8080/value")
          if err != nil { t.Fatal(err) }
          defer response.Body.Close()
          body, err := io.ReadAll(response.Body)
          if err != nil || string(body) != "test service retained\n" { t.Fatalf("workspace service binding was lost: %q, %v", body, err) }
          output, err := os.ReadFile("../root-output.txt")
          if err != nil || string(output) != "root output\n" { t.Fatalf("container change lost workspace output: %q, %v", output, err) }
        }
      ``` + "\n")
    let caller = ws.withDirectory(root, fixture)
    let module = go(
      base: container.from("golang:1.26.1-alpine").withEnvVariable(
        "TESTER_BASE",
        "default",
      ),
      test: [root],
      goflags: "-tags=testcontainer",
    ).module(caller, root, findUp: false)
    let failure = {
      module.test(caller)
      ""
    } rescue {
      err: Error => err.message
    }
    assert(failure == "", "test container directive failed: " + failure)
    let selectedRoot = "testdata/go-module-test-container"
    run(
      go(version: "1.26.1", test: [selectedRoot])
        .packages(ws)
        .get(key: selectedRoot)
        .tests(ws)
        .get(key: "TestSelectedContainer")
        .test(ws),
    )
    null
  }

  """
  Missing artifacts, wrong artifact types and conflicting test container
  directives report their cause.
  """
  testContainerErrorsCheck(ws: Workspace!): Void @check {
    let root = "fixtures/test-container-errors"
    let fixture = directory
      .withNewFile("go.mod", "module example.com/test-container-errors\n\ngo 1.26.1\n")
      .withNewFile("main_test.go", "package fixture\nimport \"testing\"\n//go:test:container dag://go-dev/test-env\nfunc TestValue(t *testing.T) {}\n")
      .withNewFile("conflict_test.go", "package fixture\n//go:test:container docker.io/library/golang:1.26.1-alpine\n")
    let conflictModule = go(version: "1.26.1", test: [root]).module(
      ws.withDirectory(root, fixture),
      root,
      findUp: false,
    )
    let conflict = {
      conflictModule.test(ws.withDirectory(root, fixture))
      "unexpected success"
    } rescue {
      err: Error => err.message
    }
    assert(
      conflict.contains("conflicting //go:test:container values") and conflict.contains(root),
      "test container conflict was not named: " + conflict,
    )

    ["dag://missing-module/container", "dag://go-dev/container-directory"].map { value =>
      let caller = ws.withDirectory(
        root,
        fixture
          .withoutFile("conflict_test.go")
          .withNewFile("main_test.go", "package fixture\nimport \"testing\"\n//go:test:container " + value + "\nfunc TestValue(t *testing.T) {}\n"),
      )
      let module = go(version: "1.26.1", test: [root]).module(caller, root, findUp: false)
      let failure = {
        module.test(caller)
        "unexpected success"
      } rescue {
        err: Error => err.message
      }
      assert(failure != "unexpected success" and failure.contains(value), "test container resolution error was not reported: " + failure)
      if (value == "dag://go-dev/container-directory") {
        assert(failure.contains("artifact is a Directory, not a Container"), "wrong test artifact type was not reported: " + failure)
      } else {
        assert(failure.contains("no artifact matches"), "missing test artifact was not reported: " + failure)
      }
    }
    null
  }

  dependencyService: Service! {
    container
      .from("busybox:1.37.0")
      .withNewFile("/www/value", "dependency service\n")
      .withExposedPort(8080)
      .asService(args: ["httpd", "-f", "-p", "8080", "-h", "/www"])
  }

  otherDependencyService: Service! {
    container
      .from("busybox:1.37.0")
      .withNewFile("/www/value", "other service\n")
      .withExposedPort(8080)
      .asService(args: ["httpd", "-f", "-p", "8080", "-h", "/www"])
  }

  """
  Dependency directives bind services to default and selected containers.
  """
  serviceDependenciesCheck(ws: Workspace!): Void @check {
    let root = "fixtures/service-dependencies"
    let fixture = directory
      .withNewFile("go.mod", "module example.com/dependencies\n\ngo 1.26.1\n")
      .withNewFile("generate.go", ```go
        package fixture
        //go:generate:dependency db dag+service://go-dev/dependency-service
        //go:generate:dependency backend dag://go-dev/other-dependency-service
        //go:generate sh -ec "wget -qO db.txt http://db:8080/value; wget -qO backend.txt http://backend:8080/value; echo shared > /dependency-state"
      ``` + "\n")
      .withNewFile("main_test.go", ```go
        package fixture
        import ("io"; "net/http"; "os"; "testing")
        //go:test:dependency db dag://go-dev/dependency-service
        //go:test:dependency backend dag+service://go-dev/other-dependency-service
        func TestBindings(t *testing.T) {
          for host, want := range map[string]string{"db": "dependency service\n", "backend": "other service\n"} {
            r, err := http.Get("http://"+host+":8080/value"); if err != nil { t.Fatal(err) }
            body, err := io.ReadAll(r.Body); r.Body.Close()
            if err != nil || string(body) != want { t.Fatalf("%s: %q, %v", host, body, err) }
          }
          if err := os.WriteFile("test-output.txt", []byte("carried\n"), 0644); err != nil { t.Fatal(err) }
          if err := os.WriteFile("/dependency-state", []byte("shared\n"), 0644); err != nil { t.Fatal(err) }
        }
      ``` + "\n")
      .withNewFile("a-same/generate.go", ```go
        package same
        //go:generate:dependency backend dag://go-dev/other-dependency-service
        //go:generate:dependency db dag+service://go-dev/dependency-service
        //go:generate sh -ec "grep -qx shared /dependency-state; wget -qO same.txt http://db:8080/value"
      ``` + "\n")
      .withNewFile("a-same/main_test.go", ```go
        package same
        import ("os"; "testing")
        //go:test:dependency backend dag+service://go-dev/other-dependency-service
        //go:test:dependency db dag://go-dev/dependency-service
        func TestShared(t *testing.T) {
          b, err := os.ReadFile("/dependency-state")
          if err != nil || string(b) != "shared\n" { t.Fatalf("same bindings lost state: %q, %v", b, err) }
        }
      ``` + "\n")
      .withNewFile("b-custom/generate.go", ```go
        package custom
        //go:generate:container dag://go-dev/generate-env
        //go:generate:dependency db dag://go-dev/other-dependency-service
        //go:generate sh -ec "test ! -f /dependency-state; cat ../db.txt > carried.txt; wget -qO db.txt http://db:8080/value; wget -qO inherited.txt http://generator-input:8080/value; echo custom > /dependency-state"
      ``` + "\n")
      .withNewFile("b-custom/main_test.go", ```go
        package custom
        import ("io"; "net/http"; "os"; "testing")
        //go:test:container dag://go-dev/test-env
        //go:test:dependency db dag+service://go-dev/other-dependency-service
        func TestCustom(t *testing.T) {
          if _, err := os.Stat("/dependency-state"); !os.IsNotExist(err) { t.Fatal("different bindings retained container state") }
          for host, want := range map[string]string{"db": "other service\n", "tester-input": "test service retained\n"} {
            r, err := http.Get("http://"+host+":8080/value"); if err != nil { t.Fatal(err) }
            b, err := io.ReadAll(r.Body); r.Body.Close()
            if err != nil || string(b) != want { t.Fatalf("%s: %q, %v", host, b, err) }
          }
          b, err := os.ReadFile("../test-output.txt")
          if err != nil || string(b) != "carried\n" { t.Fatalf("workspace output lost: %q, %v", b, err) }
          if err := os.WriteFile("/dependency-state", []byte("custom\n"), 0644); err != nil { t.Fatal(err) }
        }
      ``` + "\n")
      .withNewFile("c-clean/generate.go", ```go
        package clean
        //go:generate:container dag://go-dev/generate-env
        //go:generate sh -ec "test ! -f /dependency-state; if wget -qO /dev/null http://db:8080/value; then exit 1; fi; echo clean > clean.txt"
      ``` + "\n")
      .withNewFile("c-clean/main_test.go", ```go
        package clean
        import ("net"; "os"; "testing")
        //go:test:container dag://go-dev/test-env
        func TestClean(t *testing.T) {
          if _, err := os.Stat("/dependency-state"); !os.IsNotExist(err) { t.Fatal("dependency change retained container state") }
          if _, err := net.LookupHost("db"); err == nil { t.Fatal("service binding leaked into another package") }
        }
      ``` + "\n")
    let caller = ws.withDirectory(root, fixture)
    let module = go(version: "1.26.1", test: [root], generate: [root + "/**"]).module(
      caller,
      root,
      findUp: false,
    )
    let changes = module.generate(caller)
    assert(
      changes.layer.file(root + "/db.txt").contents == "dependency service\n",
      "default generate service was not bound",
    )
    assert(
      changes.layer.file(root + "/backend.txt").contents == "other service\n",
      "second generate service was not bound",
    )
    assert(
      changes.layer.file(root + "/a-same/same.txt").contents == "dependency service\n",
      "same dependency configuration lost its service",
    )
    assert(
      changes.layer.file(root + "/b-custom/db.txt").contents == "other service\n",
      "custom generate service was not bound",
    )
    assert(
      changes.layer.file(root + "/b-custom/inherited.txt").contents == "service binding retained\n",
      "custom container lost its existing service",
    )
    assert(
      changes.layer.file(root + "/b-custom/carried.txt").contents == "dependency service\n",
      "dependency change lost workspace output",
    )
    assert(
      changes.layer.file(root + "/c-clean/clean.txt").contents == "clean\n",
      "dependency binding leaked",
    )
    module.test(caller)
    let defaultCaller = ws.withDirectory(
      root,
      fixture.withoutDirectory("b-custom").withoutDirectory("c-clean"),
    )
    go(version: "1.26.1", test: [root]).module(defaultCaller, root, findUp: false).test(defaultCaller)
    null
  }

  """
  Missing or non-service artifacts report dependency resolution errors.
  """
  serviceDependenciesErrorsCheck(ws: Workspace!): Void @check {
    let root = "fixtures/service-dependency-errors"
    ["dag://missing-module/service", "dag://go-dev/container-directory"].map { address =>
      let fixture = directory
        .withNewFile("go.mod", "module example.com/dependency-errors\n\ngo 1.26.1\n")
        .withNewFile("generate.go", "package fixture\n//go:generate:dependency db " + address + "\n//go:generate go version\n")
        .withNewFile("main_test.go", "package fixture\nimport \"testing\"\n//go:test:dependency db " + address + "\nfunc TestDependency(t *testing.T) {}\n")
      let caller = ws.withDirectory(root, fixture)
      let module = go(version: "1.26.1", test: [root], generate: [root + "/**"]).module(
        caller,
        root,
        findUp: false,
      )
      let generated = { module.generate(caller).addedPaths.join(","); "unexpected success" } rescue {
        err: Error => err.message
      }
      let tested = { module.test(caller); "unexpected success" } rescue {
        err: Error => err.message
      }
      [generated, tested].map { failure =>
        assert(failure != "unexpected success" and failure.contains(address), "dependency resolution error did not name the link: " + failure)
        if (address == "dag://go-dev/container-directory") {
          assert(failure.contains("artifact is a Directory, not a Service"), "wrong dependency artifact type was not reported: " + failure)
        }
      }
    }
    null
  }

  containerDirectory: Directory! { directory }

  """
  A Go generator retains the selected container's mounted file and service.
  """
  generationServiceCheck(ws: Workspace!): Void @check {
    let root = "testdata/go-module-generate-container"
    let changes = go.module(ws, root).generate(ws)
    assert(
      changes.layer.file(root + "/generated.txt").contents == "service binding retained\n",
      "generator lost the selected container's service",
    )
    assert(changes.addedPaths == [root + "/generated.txt"], "generator produced unexpected files")
    assert(
      changes.modifiedPaths.length == 0 and changes.removedPaths.length == 0,
      "generator changed existing files",
    )
    null
  }

  """
  Open an example Git repository at /example with `dagger shell playground`.
  Run `dagger generate` there to try the container directive on beta.15.
  """
  playground(ws: Workspace!): Container! {
    let source = ws.directory("/", exclude: [".git"])
    let fixture = source.directory("testdata/go-module-generate-container")
    let example = source
      .directory(".dagger/examples/generate-container")
      .withFile("dagger.lock", ws.file("/dagger.lock"))
      .withFile(
        "generate.go",
        source.file(".dagger/examples/generate-container/generate.go.txt"),
      )
      .withoutFile("generate.go.txt")
      .withFile("go.mod", fixture.file("go.mod"))
      .withDirectory("internal/generate", fixture.directory("internal/generate"))
      .withDirectory(".dagger/go", source)
    container
      .from("alpine:3.23")
      .withExec(["apk", "add", "--no-cache", "curl", "git", "nano"])
      .withFile("/tmp/install-dagger.sh", http("https://dl.dagger.io/dagger/install.sh"))
      .withEnvVariable("DAGGER_VERSION", "1.0.0-beta.15")
      .withEnvVariable("BIN_DIR", "/usr/local/bin")
      .withEnvVariable("CI", "true")
      .withExec(["sh", "/tmp/install-dagger.sh"])
      .withDirectory("/example", example)
      .withWorkdir("/example")
      .withExec(["git", "init", "--quiet"])
      .withExec(["git", "add", "."])
      .withExec(["git", "-c", "user.name=Example", "-c", "user.email=example@example.com", "commit", "--quiet", "-m", "Initial example"])
      .withDefaultTerminalCmd(["sh", "-c", "cat README.md; exec sh"], experimentalPrivilegedNesting: true)
  }

  """
  The example generator runs in its selected container and applies its output.
  """
  playgroundCheck(ws: Workspace!): Void @check {
    let example = playground(ws)
      .withExec(["dagger", "--auto-apply", "generate", "--require-load"], experimentalPrivilegedNesting: true)
    assert(
      example.file("generated.txt").contents == "service binding retained\n",
      "example generator lost the selected container's service",
    )
    null
  }

  """
  Container directives use workspace resolution and apply only to their directory.
  """
  generationContainerCheck(ws: Workspace!): Void @check {
    let root = "fixtures/generation-containers"
    let fixture = directory
      .withNewFile("go.mod", "module example.com/generation-containers\n\ngo 1.26.1\n")
      .withNewFile("generate.go", ```go
        package fixture
        //go:generate:container dag://generate-env
        //go:generate:include input.txt
        //go:generate sh -ec "test \"$GENERATOR_BASE\" = workspace; test \"$GOFLAGS\" = -tags=generatecontainer; test -f /generator-config; test \"$GOCACHE\" = /root/.cache/go-build; test \"$GOMODCACHE\" = /go/pkg/mod; echo shared > /container-state; pwd > workdir.txt; cat input.txt > generated.txt; wget -qO service.txt http://generator-input:8080/value"
      ``` + "\n")
      .withNewFile("same.go", "package fixture\n//go:generate:container dag://generate-env\n")
      .withNewFile("input.txt", "included input\n")
      .withNewFile("0-shared/generate.go", ```go
        package shared
        //go:generate:container dag://generate-env
        //go:generate sh -ec "grep -qx shared /container-state; cat ../generated.txt > shared.txt"
      ``` + "\n")
      .withNewFile("a-default/generate.go", ```go
        package child
        //go:generate sh -ec "test \"$GENERATOR_BASE\" = default; test \"$GOFLAGS\" = -tags=generatecontainer; test ! -f /generator-config; cat ../generated.txt > default.txt"
      ``` + "\n")
      .withNewFile("b-image/generate.go", ```go
        package image
        //go:generate:container docker.io/library/golang:1.26.1-alpine
        //go:generate sh -ec "test -z \"$GENERATOR_BASE\"; test \"$GOFLAGS\" = -tags=generatecontainer; test ! -f /generator-config; cat ../a-default/default.txt > image.txt"
      ``` + "\n")
      .withNewFile("c-wired/generate.go", ```go
        package wired
        //go:generate:container dag://go-dev/generate-env
        //go:generate sh -ec "test \"$GENERATOR_BASE\" = workspace; test \"$GOFLAGS\" = -tags=generatecontainer; test -f /generator-config; wget -qO wired.txt http://generator-input:8080/value; cat ../b-image/image.txt > earlier.txt"
      ``` + "\n")
    let caller = ws.withDirectory(root, fixture).withWorkdir(root)
    let changes = go(
      base: container.from("golang:1.26.1-alpine").withEnvVariable(
        "GENERATOR_BASE",
        "default",
      ),
      generate: [root + "/**"],
      goflags: "-tags=generatecontainer",
      mountPath: "/custom/workspace",
    ).module(caller, root, findUp: false).generate(caller)
    assert(
      changes.layer.file(root + "/workdir.txt").contents == "/custom/workspace/" + root + "\n",
      "selected container lost the configured mount path",
    )
    assert(
      changes.layer.file(root + "/generated.txt").contents == "included input\n",
      "selected container lost generation inputs",
    )
    assert(
      changes.layer.file(root + "/service.txt").contents == "service binding retained\n",
      "workspace container lost its service binding",
    )
    assert(
      changes.layer.file(root + "/0-shared/shared.txt").contents == "included input\n",
      "consecutive directories did not share their selected container",
    )
    assert(
      changes.layer.file(root + "/a-default/default.txt").contents == "included input\n",
      "child directory did not use the configured base",
    )
    assert(
      changes.layer.file(root + "/b-image/image.txt").contents == "included input\n",
      "external image did not retain earlier output",
    )
    assert(
      changes.layer.file(root + "/c-wired/wired.txt").contents == "service binding retained\n",
      "module container lost its service binding",
    )
    assert(
      changes.layer.file(root + "/c-wired/earlier.txt").contents == "included input\n",
      "container change lost earlier output",
    )
    assert(
      changes.modifiedPaths.length == 0 and changes.removedPaths.length == 0,
      "container selection changed existing files",
    )
    null
  }

  """
  Conflicts and workspace resolution errors must fail generation.
  """
  generationContainerErrorsCheck(ws: Workspace!): Void @check {
    let root = "fixtures/generation-container-errors"
    let fixture = directory
      .withNewFile("go.mod", "module example.com/generation-container-errors\n\ngo 1.26.1\n")
      .withNewFile("generate.go", "package fixture\n//go:generate:container dag://go-dev/generate-env\n//go:generate go version\n")
      .withNewFile("conflict.go", "package fixture\n//go:generate:container docker.io/library/golang:1.26.1-alpine\n")
    let caller = ws.withDirectory(root, fixture)
    let conflict = {
      go.module(caller, root, findUp: false).generate(caller).addedPaths.join(",")
      "unexpected success"
    } rescue {
      err: Error => err.message
    }
    assert(
      conflict.contains("conflicting //go:generate:container values") and conflict.contains(root),
      "container conflict did not name the directory and cause: " + conflict,
    )

    ["dag://missing-module/container", "dag://go-dev/missing-container", "dag://go-dev/container-directory"].map { value =>
      let caller = ws.withDirectory(
        root,
        fixture
          .withoutFile("conflict.go")
          .withNewFile("generate.go", "package fixture\n//go:generate:container " + value + "\n//go:generate go version\n"),
      )
      let result = {
        go.module(caller, root, findUp: false).generate(caller).addedPaths.join(",")
        "unexpected success"
      } rescue {
        err: Error => err.message
      }
      assert(result != "unexpected success" and result.contains(value), "container resolution error was not reported: " + result)
      if (value == "dag://go-dev/container-directory") {
        assert(result.contains("artifact is a Directory, not a Container"), "wrong artifact type was not reported: " + result)
      } else {
        assert(result.contains("no artifact matches"), "missing artifact was not reported: " + result)
      }
    }
    null
  }
}
