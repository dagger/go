  """
  Conflicts and workspace resolution errors must fail generation.
  """
  generationContainerErrorsCheck(ws: Workspace!): Void @check {
    let root = "fixtures/generation-container-errors"
    let fixture = directory
      .withNewFile("go.mod", "module example.com/generation-container-errors\n\ngo 1.26.1\n")
      .withNewFile("generate.go", "package fixture\n//go:generate:container generate-env\n//go:generate go version\n")
      .withNewFile("conflict.go", "package fixture\n//go:generate:container docker.io/library/golang:1.26.1-alpine\n")
    let caller = ws.withDirectory(root, fixture)
    let conflict = {
      go.module(caller, root, findUp: false).generate(caller).addedPaths.join(",")
      "unexpected success"
    } rescue {
      err: Error => err.message
    }
    assert(conflict != "unexpected success", "conflicting container directives did not fail")

    # TODO: uncomment when https://github.com/dagger/dagger/pull/14178 is merged
    # ["dag://go-dev/missing-container", "dag://go-dev/container-label"].map { value =>
    #   let caller = ws.withDirectory(
    #     root,
    #     fixture
    #       .withoutFile("conflict.go")
    #       .withNewFile("generate.go", "package fixture\n//go:generate:container " + value + "\n//go:generate go version\n"),
    #   )
