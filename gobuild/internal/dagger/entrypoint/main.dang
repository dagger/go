        .withField("Downloads", typeDef.withListOf(typeDef.withObject("Directory")), description: "Each module version the build downloaded (go mod download), with its\nplan pack and its zip, in the order of its module cache directory name.", sourceMap: sourceMap("main.go", 670, 2))
