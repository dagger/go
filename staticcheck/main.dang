"""
Lint Go modules in a workspace with Staticcheck.
"""
type Staticcheck {
  """
  Staticcheck release every module is linted with.
  """
  version: String!

  """
  Go version for every module. Null uses each module's go.mod.
  """
  goVersion: String

  """
  Custom base image for Go containers, if set.
  """
  base: Container

  """
  Settings that were given but are ignored.
  """
  warnings: [String!]! = []

  """
  Extra workspace files mounted for Go commands, as include patterns.
  """
  includeExtraFiles: [String!]! = []

  """
  Module roots to lint. "!" excludes.
  """
  lint: [String!]! = ["**"]

  new(
    """
    Staticcheck release, e.g. "v0.8.1".
    """
    version: String = null,
    """
    Go version for every module, overriding go.mod. Ignored when base is set.
    """
    goVersion: String = null,
    """
    Base image for Go containers. Must include a Go toolchain.
    """
    base: Container = null,
    """
    Extra workspace files to mount for Go commands, as include patterns.
    """
    includeExtraFiles: [String!]! = [],
    """
    Module roots to lint, e.g. ["**", "!docs"]. "!" excludes.
    """
    lint: [String!]! = ["**"],
  ) {
    self.warnings = if (goVersion != null and base != null) {
      [
        "goVersion \"" + goVersion
          + "\" is ignored because base was set: the base container supplies its own Go toolchain",
      ]
    } else {
      []
    }
    self.version = version ?? defaultVersion
    self.goVersion = if (base == null) { goVersion } else { null }
    self.base = base
    self.includeExtraFiles = includeExtraFiles
    self.lint = gomod.settingPatterns(lint)
    self
  }

  """
  Staticcheck release used when the caller names none.
  """
  let defaultVersion: String! = "v0.8.1"

  """
  The Staticcheck binary at the configured release.
  """
  binary: File! {
    gomod
      .toolBuilder
      .withEnvVariable("GOBIN", "/usr/local/bin")
      .withExec(["go", "install", "honnef.co/go/tools/cmd/staticcheck@" + (version ?? defaultVersion)])
      .file("/usr/local/bin/staticcheck")
  }

  let lib: Gomod! { gomod(includeExtraFiles: includeExtraFiles) }

  """
  Go modules at or below the working directory, keyed by module root.
  """
  modules(
    ws: Workspace!,
    include: [String!]! = [],
    exclude: [String!]! = [],
    includeSkipped: Boolean! = true,
  ): GoModules! {
    GoModules(
      paths: lib
        .modules(ws, include: include, exclude: exclude).{{path}}
        .map { found => goModule(found.path) }
        .filter { mod => includeSkipped or mod.skipLint == false }
        .map { mod => mod.path },
      tool: self,
    )
  }

  """
  The Go module containing a workspace path.
  """
  module(ws: Workspace!, path: String!, findUp: Boolean! = true): GoModule! {
    goModule(lib.module(ws, path, findUp: findUp).path)
  }

  let goModule(modPath: String!): GoModule! {
    GoModule(
      path: modPath,
      version: version,
      configuredGoVersion: goVersion,
      warnings: warnings,
      includeExtraFiles: includeExtraFiles,
      baseImage: base,
      lintPatterns: lint,
    )
  }
}

# Keep all Dang types in one source file until Dagger can convert Workspace
# arguments for installed multi-file Dang modules. See dagger/dagger#13476.

"""
Go modules in a workspace, keyed by module root.
"""
type GoModules @collection {
  """
  Module root paths.
  """
  paths: [String!]! @keys

  let tool: Staticcheck!

  """
  The Go module rooted at path.
  """
  module(path: String!): GoModule! @get {
    tool.goModule(path)
  }

  """
  Run Staticcheck in the selected Go modules.
  """
  lint(ws: Workspace!): Void @check {
    let mods = paths.map { p => module(p) }.filter { mod => mod.skipLint == false }
    let layers = mods.reduce(directory) { layers, mod =>
      layers.withDirectory(
        mod.path,
        directory.withFile("go.mod", mod.lintExec(ws).file("go.mod")),
      )
    }
    # Merging one output from each container forces all lint commands to run
    # in parallel until Dagger supports directly awaiting multiple containers.
    layers.sync
    null
  }
}

"""
A Go module rooted at a workspace-relative path.
"""
type GoModule {
  """
  Module root, relative to the workspace.
  """
  path: String!

  """
  Staticcheck release this module is linted with.
  """
  version: String!

  """
  Extra workspace files mounted for Go commands, as include patterns.
  """
  includeExtraFiles: [String!]!

  let configuredGoVersion: String
  let warnings: [String!]!
  let baseImage: Container
  let lintPatterns: [String!]!

  """
  The Staticcheck binary this module is checked with, built once at the pinned
  release in a pinned Go container rather than in this module's own, so a
  module on an older toolchain still gets it.
  """
  let staticcheckBinary: File! {
    gomod
      .toolBuilder
      .withEnvVariable("GOBIN", "/usr/local/bin")
      .withExec(["go", "install", "honnef.co/go/tools/cmd/staticcheck@" + version])
      .file("/usr/local/bin/staticcheck")
  }

  """
  The shared library, which answers discovery, selection and source policy for
  this module, so Staticcheck mounts what `go` and `golangci-lint` mount plus
  its own configuration.

  Its module object is re-derived at each call site rather than held as a
  field: Dang cannot yet name a dependency's non-root type, which is also why
  the GoModule type here is this module's own rather than the library's.
  """
  let lib: Gomod! { gomod(includeExtraFiles: includeExtraFiles) }

  """
  Whether linting is skipped for this module.
  """
  skipLint: Boolean! {
    lib.at(path).selected(lintPatterns) == false
  }

  """
  Go version this module is linted with. Null with a custom base.
  """
  goVersion(ws: Workspace!): String {
    if (baseImage == null) { toolchainVersion(ws) } else { null }
  }

  let toolchainVersion(ws: Workspace!): String! {
    configuredGoVersion ?? lib.at(path).goVersion(ws) ?? gomod.defaultGoVersion
  }

  """
  Go container for this module, with Staticcheck installed.
  """
  base(ws: Workspace!): Container! {
    let toolchain = if (baseImage == null) {
      gomod.goContainer(toolchainVersion(ws), cgo: true)
    } else {
      gomod.withGoCaches(baseImage.withoutEntrypoint)
    }
    gomod
      .withWarnings(
        gomod.withTool(toolchain, "staticcheck", staticcheckBinary),
        warnings,
      )
      .withWorkdir("/ws")
  }

  """
  Include patterns for Staticcheck configuration files.
  """
  includeConfig: [String!]! {
    ["**/staticcheck.conf"]
  }

  """
  Include patterns found by scanning Go directives and local replaces.
  """
  includeDiscovered(ws: Workspace!): [String!]! {
    lib.at(path).includeDiscovered(ws)
  }

  """
  All include patterns for this module's source.
  """
  include(ws: Workspace!): [String!]! {
    lib.at(path).include(ws, extra: includeConfig)
  }

  """
  Source mounted for this module's lint command.
  """
  source(ws: Workspace!): Directory! {
    lib.at(path).source(ws, extra: includeConfig)
  }

  """
  Run Staticcheck in this module.
  """
  lint(ws: Workspace!): Void @check {
    if (skipLint == false) {
      lintExec(ws).sync
    }
    null
  }

  let lintExec(ws: Workspace!): Container! {
    base(ws)
      .withMountedCache("/root/.cache/staticcheck", cacheVolume("staticcheck"))
      .withEnvVariable("STATICCHECK_CACHE", "/root/.cache/staticcheck")
      .withDirectory(".", source(ws))
      .withWorkdir(path)
      .withExec(["staticcheck", "./..."])
  }
}
