"""
End-to-end checks for the Staticcheck module.

Staticcheck's fixtures stay under `staticcheck/testdata/`: several of them fail
on purpose -- a lint diagnostic, a failing test -- and the repository's shared
fixture trees are the ones `go`'s batch test runs.
"""
type E2e {
  let testdataPath: String! = "staticcheck/testdata"
  let cleanPath: String! = "staticcheck/testdata/clean"
  let configuredPath: String! = "staticcheck/testdata/configured"
  let failPath: String! = "staticcheck/testdata/lint-fail"
  let testFailPath: String! = "staticcheck/testdata/test-fail"

  let assert(condition: Boolean!, message: String!): Void {
    if (condition == false) { raise message }
    null
  }

  """
  Run a check, raising its failure. A check called through a dependency comes
  back as a Check that has not run.
  """
  let run(check: Check!): Void {
    # Check.error is not null for a passing check when read from Dang, so ask
    # pass first and read the message only on failure.
    if (check.pass == false) {
      raise check.error.message ?? "check failed"
    }
    null
  }

  """
  Discovery roots a project at each staticcheck.conf that covers Go code,
  snaps a lookup to its enclosing project, and keeps its paths
  workspace-root-relative from any cwd.
  """
  discoveryCheck(ws: Workspace!): Void @check {
    let tool = staticcheck
    let paths = tool.projects(ws).keys
    assert(paths.contains(testdataPath), "missing the project above the clean modules")
    assert(paths.contains(configuredPath), "missing the project above its module")
    assert(paths.contains(failPath), "missing the failing project")
    assert(paths.contains(cleanPath) == false, "a module without configuration became a project")
    assert(paths.contains(".") == false, "invented a root project")

    let covered = tool.project(ws, testdataPath).modules(ws)
    assert(covered.contains(cleanPath), "missing clean module")
    assert(covered.contains(cleanPath + "/nested"), "missing nested module")
    assert(covered.contains(configuredPath + "/project") == false, "a module claimed by its own configuration was linted twice")
    assert(covered.contains(failPath) == false, "a failing project leaked into its parent")
    let configured = tool.project(ws, configuredPath).modules(ws)
    assert(
      configured.length == 1 and configured.contains(configuredPath + "/project"),
      "a configuration above its module did not cover it",
    )

    let below = tool.projects(ws.withWorkdir(cleanPath)).keys
    assert(below.length == 1 and below.contains(testdataPath), "discovery inside a project missed its enclosing root")
    let inside = ws.withWorkdir(cleanPath + "/assets")
    run(tool.projects(inside).batch.lint(inside))
    assert(
      tool.project(ws, cleanPath + "/assets").path == testdataPath,
      "lookup did not resolve the enclosing project",
    )
    assert(
      tool.module(ws, cleanPath + "/assets").path == cleanPath,
      "lookup did not resolve the enclosing module",
    )
    let missing = {
      tool.project(ws, ".").path
    } rescue {
      err: Error => err.message
    }
    assert(missing.contains("no project found"), "missing project did not fail clearly")
    null
  }

  """
  The batch check over the clean fixture projects passes, and a subset checks
  only its own keys.
  """
  batchCheck(ws: Workspace!): Void @check {
    run(
      staticcheck(lint: [testdataPath, "!" + failPath, "!" + testFailPath]).projects(ws).batch.lint(ws),
    )

    # The failing fixtures are in the collection but outside the subset.
    let projects = staticcheck.projects(ws)
    assert(projects.keys.contains(failPath), "failing fixture was not discovered")
    run(projects.subset(keys: [testdataPath, configuredPath]).batch.lint(ws))
    null
  }

  """
  A diagnostic fails the project's own check and the batch alike, including
  one found in a test file.
  """
  lintFailureCheck(ws: Workspace!): Void @check {
    let failure = {
      run(staticcheck.project(ws, failPath).lint(ws))
      "unexpected success"
    } rescue {
      err: Error => err.message
    }
    assert(failure.contains("exit code"), "Staticcheck did not reject the broken source: " + failure)
    let testFailure = {
      run(staticcheck.project(ws, testFailPath).lint(ws))
      "unexpected success"
    } rescue {
      err: Error => err.message
    }
    assert(testFailure.contains("exit code"), "Staticcheck did not analyze test files: " + testFailure)
    let batchFailure = {
      run(
        staticcheck.projects(ws).subset(keys: [configuredPath, failPath]).batch.lint(ws),
      )
      "unexpected success"
    } rescue {
      err: Error => err.message
    }
    assert(batchFailure.contains("exit code"), "batch lint did not propagate a project failure: " + batchFailure)
    null
  }

  """
  The lint setting reaches selection, including the JSON-fragment spelling
  older beta engines deliver, and an exclude always wins.
  """
  selectionCheck(ws: Workspace!): Void @check {
    let excluded = staticcheck(lint: ["!" + failPath, testdataPath + "/**"])
    assert(excluded.project(ws, failPath).skipLint, "exclusion did not win")
    assert(
      excluded.project(ws, configuredPath).skipLint == false,
      "subtree selector missed nested project",
    )
    let excludeOnly = staticcheck(lint: ["!" + failPath, "!" + testFailPath])
    assert(
      excludeOnly.project(ws, testdataPath).skipLint == false,
      "exclude-only selection excluded clean project",
    )
    assert(
      excludeOnly.projects(ws, includeSkipped: false).keys.contains(failPath) == false,
      "filtered discovery included excluded project",
    )
    run(excluded.project(ws, failPath).lint(ws))
    run(staticcheck(lint: ["!**"]).projects(ws).batch.lint(ws))
    run(
      staticcheck(lint: ["[\"!" + failPath + "\"", "\"!" + testFailPath + "\"]"])
        .project(ws, failPath)
        .lint(ws),
    )
    assert(
      staticcheck(lint: []).project(ws, testdataPath).skipLint == false,
      "empty selectors did not select all",
    )
    assert(
      staticcheck(lint: [configuredPath]).project(
        ws,
        configuredPath + "-other",
        findUp: false,
      ).skipLint,
      "path prefix crossed project boundary",
    )
    null
  }

  """
  The source mount carries replace targets, extra includes and inherited
  staticcheck.conf, and keeps a nested module's embeds out.
  """
  sourceCheck(ws: Workspace!): Void @check {
    let mod = staticcheck(includeExtraFiles: ["staticcheck/testdata/extra.txt"])
      .module(ws, "staticcheck/testdata/replaced")
    let src = mod.source(ws)
    assert(
      src.file("staticcheck/testdata/clean/assets/message.txt").contents.contains("Hello"),
      "replace target lost its embedded file",
    )
    assert(
      src.file("staticcheck/testdata/extra.txt").contents.contains("extra"),
      "extra include was not mounted",
    )
    assert(
      src.file("staticcheck/testdata/configured/staticcheck.conf").contents.contains("SA1000"),
      "inherited Staticcheck config was not mounted",
    )
    assert(
      src.glob("staticcheck/testdata/clean/nested/assets/**").length == 0,
      "nested module embed leaked into parent source",
    )
    run(
      staticcheck(includeExtraFiles: ["staticcheck/testdata/extra.txt"])
        .project(ws, "staticcheck/testdata/replaced")
        .lint(ws),
    )
    null
  }

  """
  Each module is checked with the Go toolchain its own go.mod asks for, unless
  goVersion overrides it.
  """
  goVersionCheck(ws: Workspace!): Void @check {
    # The staticcheck fixtures say "go 1.26.0"; the shared ones say "go 1.25".
    let own = staticcheck.module(ws, "staticcheck/testdata/clean")
    let older = staticcheck.module(ws, "fixtures/go-module-with-nested-module")
    assert(own.goVersion(ws) == "1.26", "go 1.26.0 did not resolve to its minor series: " + (own.goVersion(ws) ?? "<null>"))
    assert(older.goVersion(ws) == "1.25", "go 1.25 was not taken from the module: " + (older.goVersion(ws) ?? "<null>"))
    assert(staticcheck.goVersion == null, "the root claimed a version that varies per module")

    # The toolchain in the container is the one the module asked for, not the
    # one Staticcheck was built with.
    assert(
      older.base(ws).withExec(["go", "version"]).stdout.contains("go1.25"),
      "the module's container did not carry its own toolchain",
    )
    assert(
      own.base(ws).withExec(["staticcheck", "--version"]).stdout.contains("staticcheck"),
      "the pinned binary was not copied in",
    )

    let pinned = staticcheck(goVersion: "1.26").module(ws, "fixtures/go-module-with-nested-module")
    assert(pinned.goVersion(ws) == "1.26", "goVersion did not override the module's own")
    assert(
      pinned.base(ws).withExec(["go", "version"]).stdout.contains("go1.26"),
      "goVersion did not reach the container",
    )
    run(staticcheck(goVersion: "1.26").project(ws, configuredPath).lint(ws))
    null
  }

  """
  A custom base supplies the toolchain; Staticcheck is installed into it only
  when it does not already carry one.
  """
  customBaseCheck(ws: Workspace!): Void @check {
    let plain = container
      .from("golang:1.26-alpine")
      .withExec(["apk", "add", "--no-cache", "build-base"])
      .withNewFile("/custom-base", "custom base\n")
      .withEntrypoint(["false"])
    let tool = staticcheck(base: plain)
    assert(tool.goVersion == null, "custom base incorrectly exposed a Go version")
    assert(tool.version == "v0.8.1", "custom base hid the release it would install")

    let mod = tool.module(ws, "staticcheck/testdata/clean")
    assert(mod.goVersion(ws) == null, "custom base incorrectly resolved a Go version")
    assert(mod.base(ws).file("/custom-base").contents.contains("custom base"), "custom base was discarded")
    assert(
      mod.base(ws).withExec(["sh", "-c", "command -v staticcheck"]).stdout.contains("/usr/local/bin/staticcheck"),
      "a base without Staticcheck did not get the configured release",
    )
    run(tool.project(ws, configuredPath).lint(ws))

    # A base that brings its own build keeps it: a future instrumented build
    # is installed this way, and installing over it would throw it away.
    let own = plain.withNewFile(
      "/usr/local/bin/staticcheck",
      "#!/bin/sh\necho custom-staticcheck-used >&2\nexit 42\n",
      permissions: 493,
    )
    let failure = {
      run(
        staticcheck(base: own).project(ws, configuredPath).lint(ws),
      )
      "unexpected success"
    } rescue {
      err: Error => err.message
    }
    assert(failure.contains("exit code: 42"), "the base's own Staticcheck was overwritten: " + failure)

    # version says what to install, so it composes with base.
    run(
      staticcheck(version: "v0.8.1", base: plain).project(ws, configuredPath).lint(ws),
    )

    # goVersion is ignored rather than refused: the base already carries a
    # toolchain, and refusing the combination would only make the caller edit
    # settings to say what the base already says.
    let ignored = staticcheck(goVersion: "1.25", base: plain)
    assert(ignored.goVersion == null, "goVersion was not ignored alongside base")
    assert(ignored.warnings.length == 1, "ignoring goVersion went unannounced")
    let said = ignored.warnings.join("; ")
    assert(said.contains("goVersion"), "the warning did not name the dropped setting: " + said)
    assert(said.contains("base was set"), "the warning did not say why it was dropped: " + said)
    assert(staticcheck.warnings.length == 0, "a plain constructor warned about nothing")
    let ignoredMod = ignored.module(ws, "staticcheck/testdata/clean")
    assert(ignoredMod.goVersion(ws) == null, "a module resolved a goVersion the base overrides")
    assert(
      ignoredMod.base(ws).withExec(["go", "version"]).stdout.contains("go1.26"),
      "the ignored goVersion reached the container anyway",
    )
    run(ignored.project(ws, configuredPath).lint(ws))
    null
  }
}
